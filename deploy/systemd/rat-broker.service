[Unit]
Description=CTF-Rat privileged broker service
After=network-online.target

[Service]
Type=simple
User=ratbroker
Group=ratbroker
EnvironmentFile=/etc/ratbroker/environment
ExecStart=/opt/ctf-rat/bin/rat-brokerd --socket /run/ratbroker/broker.sock --socket-mode 0660 --allow-uid ${RAT_AGENT_UID} --ctf-home ${CTF_HOME}
Restart=on-failure
RestartSec=2
# Bubblewrap is installed setuid-root so the unprivileged broker can create
# its mount/user namespace. NoNewPrivileges would block that transition and
# cause the broker to fail closed before sandboxing.
PrivateTmp=true
ProtectHome=true
ProtectSystem=full
RuntimeDirectory=ratbroker
RuntimeDirectoryMode=0770
ReadWritePaths=/run/ratbroker /var/lib/ratbroker /opt/ctf-rat/solve

[Install]
WantedBy=multi-user.target
