# Install as /etc/ratbroker/environment (root:ratbroker, mode 0640).
CTF_HOME=/opt/ctf-rat
RAT_AGENT_UID=1000
RAT_BROKER_KEY_PATH=/var/lib/ratbroker/receipt.key
# Shared control-plane state: root:ratbroker, mode 2770. The agent and broker
# must both belong to the ratbroker group.
RAT_RUNTIME_DIR=/var/lib/ratbroker/runtime
RAT_SHARED_STORE=1
RAT_BROKER_REQUIRE_SOCKET=1
# Enable only after rat-netns-root and its sudoers rule are installed.
RAT_BROKER_NETWORK_RUNNER=/opt/ctf-rat/bin/rat-netns-runner
