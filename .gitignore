# 캐시·분석 산출물
__pycache__/
*.pyc
*.revq.json
*.decomp/
.rat/
**/.rat/
*.decomp.tmp/
# P0 runtime/state and ingest staging (local only)
/ACTIVE.json*
/.ctfpull-extract-*/
/downloads/
/solve_incoming/
core
core.*
# OMC 플러그인 로컬 상태
.omc/
/.tools/
/STATE.jsonl
/SHARE.md
# OMX 플러그인 로컬 상태
.omx/
# 로컬 incoming 작업물
/.incoming
/incoming
/artifacts
# 로컬 문제 풀이 작업물. 공용 템플릿만 main에서 추적한다.
/solve/*
!/solve/_template/
!/solve/_template/**
# template 재포함 규칙 뒤에도 생성 캐시는 계속 제외한다.
**/__pycache__/
**/*.pyc
# 로컬 시크릿 (CTFd 토큰 등)
.ctfd.env
*.env
# glibc 실 바이너리 — 축적 안 함 (glibc-fetch 로 로컬만)
reference/glibc/libs/
# kernel 런타임 산출물
kernel/dumps/
kernel/logs/
# Python venv
.venv/
venv/
