{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "rat.benchmark-result/v1",
  "type": "object",
  "required": ["schema", "benchmark_run_id", "ablation_id", "challenge_id", "attempt", "status", "eligible", "outcome", "started_at", "finished_at", "metrics", "oracle", "ground_truth"],
  "properties": {
    "schema": {"const": "rat.benchmark-result/v1"},
    "benchmark_run_id": {"type": "string", "minLength": 1},
    "ablation_id": {"enum": ["A0", "A1", "A2", "A3", "A4", "A5"]},
    "challenge_id": {"type": "string", "minLength": 1},
    "attempt": {"type": "integer", "minimum": 1},
    "status": {"enum": ["completed", "timeout", "partial", "infra-failure", "skipped"]},
    "eligible": {"type": "boolean"},
    "outcome": {"enum": ["verified", "solve-claimed", "failed", "censored", "unknown", "skipped"]},
    "started_at": {"type": "string", "format": "date-time"},
    "finished_at": {"type": "string", "format": "date-time"},
    "metrics": {
      "type": "object",
      "required": ["verified_solve", "flag_found", "time_to_flag_ms", "time_to_verified_ms", "wall_time_ms", "peak_context_tokens", "tokens", "tools", "cache", "model", "deep_escalations"],
      "properties": {
        "verified_solve": {"type": "boolean"},
        "flag_found": {"type": "boolean"},
        "time_to_flag_ms": {"type": ["integer", "null"], "minimum": 0},
        "time_to_verified_ms": {"type": ["integer", "null"], "minimum": 0},
        "wall_time_ms": {"type": "integer", "minimum": 0},
        "peak_context_tokens": {"type": ["integer", "null"], "minimum": 0},
        "tokens": {
          "type": "object",
          "required": ["input", "output", "cache_read", "cache_creation"],
          "properties": {
            "input": {"type": "integer", "minimum": 0},
            "output": {"type": "integer", "minimum": 0},
            "cache_read": {"type": "integer", "minimum": 0},
            "cache_creation": {"type": "integer", "minimum": 0}
          },
          "additionalProperties": false
        },
        "tools": {
          "type": "object",
          "required": ["calls", "duplicate_calls", "counts", "top_duplicates", "wall_ms"],
          "properties": {
            "calls": {"type": "integer", "minimum": 0},
            "duplicate_calls": {"type": "integer", "minimum": 0},
            "counts": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 0}},
            "top_duplicates": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["count", "tool", "argv"],
                "properties": {
                  "count": {"type": "integer", "minimum": 2},
                  "tool": {"type": ["string", "null"]},
                  "argv": {"type": ["array", "null"], "items": {"type": "string"}}
                },
                "additionalProperties": false
              }
            },
            "wall_ms": {"type": "integer", "minimum": 0}
          },
          "additionalProperties": false
        },
        "cache": {
          "type": "object",
          "required": ["reads", "hits", "misses", "writes", "hit_ratio"],
          "properties": {
            "reads": {"type": "integer", "minimum": 0},
            "hits": {"type": "integer", "minimum": 0},
            "misses": {"type": "integer", "minimum": 0},
            "writes": {"type": "integer", "minimum": 0},
            "hit_ratio": {"type": ["number", "null"], "minimum": 0, "maximum": 1}
          },
          "additionalProperties": false
        },
        "model": {
          "type": "object",
          "required": ["name", "events", "wall_ms"],
          "properties": {
            "name": {"type": ["string", "null"]},
            "events": {"type": "integer", "minimum": 0},
            "wall_ms": {"type": "integer", "minimum": 0}
          },
          "additionalProperties": false
        },
        "deep_escalations": {"type": "integer", "minimum": 0}
      },
      "additionalProperties": false
    },
    "oracle": {
      "type": "object",
      "required": ["verified", "flag_found"],
      "properties": {
        "verified": {"type": "boolean"},
        "flag_found": {"type": "boolean"}
      },
      "additionalProperties": false
    },
    "ground_truth": {"type": "object"}
  },
  "additionalProperties": false
}
