{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"rat.benchmark-result/v2","$comment":"Field-level contract mirrors ratlib/schema.py:benchmark_result_v2 (closed field set; metrics groups/fields are enforced there exactly).","type":"object","required":["schema","benchmark_run_id","ablation_id","challenge_id","attempt","status","eligible","outcome","started_at","finished_at","metrics","oracle","ground_truth"],"additionalProperties":false,"properties":{"schema":{"const":"rat.benchmark-result/v2"},"benchmark_run_id":{"type":"string"},"ablation_id":{"enum":["A0","A1","A2","A3","A4","A5"]},"challenge_id":{"type":"string"},"attempt":{"type":"integer","minimum":1},"status":{"enum":["completed","timeout","partial","infra-failure","skipped"]},"eligible":{"type":"boolean"},"outcome":{"enum":["verified","solve-claimed","failed","censored","unknown","skipped"]},"started_at":{"type":"string"},"finished_at":{"type":"string"},"metrics":{"type":"object","required":["correctness","latency","context","tools","cache","reasoning","artifacts"],"additionalProperties":false,"properties":{"correctness":{"type":"object","required":["verified_solve","false_solved","oracle_pass"]},"latency":{"type":"object","required":["time_to_first_query_ms","time_to_first_hypothesis_ms","time_to_first_valid_primitive_ms","time_to_verified_solve_ms"]},"context":{"type":"object","required":["input_tokens","output_tokens","peak_context_tokens","tool_output_bytes"]},"tools":{"type":"object","required":["tool_calls","duplicate_tool_calls","ghidra_runs","cfgfast_runs","symbolic_runs","subagent_count"]},"cache":{"type":"object","required":["cache_requests","cache_hits","cache_hit_ratio","bytes_reused","cold_warm"],"properties":{"cold_warm":{"enum":["cold","warm"]},"cache_hit_ratio":{"type":["number","null"],"minimum":0,"maximum":1}}},"reasoning":{"type":"object","required":["hypotheses_created","hypotheses_refuted","pivot_count","deep_escalations"]},"artifacts":{"type":"object","required":["function