{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "rat.function-card/v2",
  "type": "object",
  "required": ["schema", "binary", "revmap", "function", "role", "callers", "callees", "compare_calls", "input_calls", "strings", "oracle", "compare_sites", "branch_sites", "data_dependencies", "stack_dependencies", "coverage", "next"],
  "properties": {
    "schema": {"const": "rat.function-card/v2"},
    "binary": {"type": ["string", "null"]},
    "revmap": {"type": "object"},
    "function": {
      "type": "object",
      "required": ["name", "address", "size", "blocks", "instructions", "count_quality", "match"],
      "properties": {
        "name": {"type": "string"},
        "address": {"type": "integer", "minimum": 0},
        "size": {"type": "integer", "minimum": 0},
        "blocks": {"type": "integer", "minimum": 0},
        "instructions": {"type": "integer", "minimum": 0},
        "count_quality": {"type": "string"},
        "match": {"enum": ["exact", "partial-unique"]}
      },
      "additionalProperties": false
    },
    "role": {
      "type": "object",
      "required": ["label", "confidence", "reasons"],
      "properties": {
        "label": {"enum": ["checker", "input", "compare-helper", "decision/output", "unknown"]},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "reasons": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": false
    },
    "callers": {"type": "array", "items": {"type": "string"}, "maxItems": 24},
    "callees": {"type": "array", "items": {"type": "string"}, "maxItems": 24},
    "compare_calls": {"type": "array", "items": {"type": "string"}},
    "input_calls": {"type": "array", "items": {"type": "string"}},
    "strings": {"type": "array", "items": {"type": "string"}, "maxItems": 16},
    "oracle": {
      "type": "object",
      "required": ["signals", "distance_calls", "reachable_oracle"],
      "properties": {
        "signals": {
          "type": "array",
          "maxItems": 12,
          "items": {
            "type": "object",
            "required": ["kind", "text"],
            "properties": {
              "kind": {"enum": ["success", "failure"]},
              "text": {"type": "string"}
            },
            "additionalProperties": false
          }
        },
        "distance_calls": {"type": ["integer", "null"], "minimum": 0},
        "reachable_oracle": {"type": "boolean"}
      },
      "additionalProperties": false
    },
    "compare_sites": {"type": "array"},
    "branch_sites": {"type": "array"},
    "data_dependencies": {"type": "array"},
    "stack_dependencies": {"type": "array"},
    "coverage": {"type": "object"},
    "next": {"type": "array", "items": {"type": "string"}, "maxItems": 5}
  },
  "additionalProperties": false
}
