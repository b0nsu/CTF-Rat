{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"rat.bench-result/v1","$comment":"Field-level contract mirrors ratlib/schema.py:bench_result (single source of truth). Open field set: Mode A and Mode B rows share the required core and add per-mode fields. Coverage guard: tests.test_schema_docs.","type":"object","required":["schema","mode","run_id","id","track","outcome","wall_ms"],"properties":{"schema":{"const":"rat.bench-result/v1"},"mode":{"enum":["A","B"]},"run_id":{"type":"string"},"id":{"type":"string"},"track":{"type":"string"},"outcome":{"enum":["route-miss","solved","route-ok-verify-skipped","verify-fail","solve-claimed","fail"]},"wall_ms":{"type":"integer","minimum":0},"difficulty":{"type":["integer","string","null"]},"expected_route":{"type":"string","$comment":"Mode A only"},"got_route":{"type":"string","$comment":"Mode A only"},"got_track":{"type":["string","null"],"$comment":"Mode A only"},"route_ok":{"type":"boolean","$comment":"Mode A only"},"verify":{"type":"object","$comment":"Mode A only: {kind,status,detail}"},"agent":{"type":"string","$comment":"Mode B only"},"agent_rc":{"type":"integer","$comment":"Mode B only"},"flag_claimed":{"type":"boolean","$comment":"Mode B only: FLAG{...} printed (a claim, not proof)"},"typed_primitive_pass":{"type":"boolean","$comment":"Mode B only: authoritative honest-mode gate"}}}
