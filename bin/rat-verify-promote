#!/usr/bin/env python3
import argparse, json, os, sys
sys.path.insert(0,os.path.dirname(os.path.realpath(__file__)))
from ratlib.orchestration import GateError, record_verification_from_receipt

p=argparse.ArgumentParser(prog="rat-verify-promote")
p.add_argument("--root",default=os.getcwd()); p.add_argument("--receipt",required=True); p.add_argument("--evidence",action="append",required=True); p.add_argument("--socket")
a=p.parse_args()
try:
 if a.socket:
  from ratlib.broker_service import request
  result=request(a.socket,{"action":"verify-promote","root":a.root,"receipt_digest":a.receipt,"evidence_ids":a.evidence})
 elif os.environ.get("RAT_BROKER_REQUIRE_SOCKET")=="1": raise GateError("production verification promotion requires --socket")
 else: result=record_verification_from_receipt(a.root,a.receipt,a.evidence)
 print(json.dumps(result,sort_keys=True))
except (GateError,OSError,ValueError,json.JSONDecodeError) as exc: print("[rat-verify-promote:policy] %s" % exc,file=sys.stderr); raise SystemExit(5)
