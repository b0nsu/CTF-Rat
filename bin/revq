#!/usr/bin/env python3
# -*- coding: utf-8 -*-
"""
revq — rev 정적 배치 (rev 루프).

`recon`(pwn triage)·`decomp`(함수 덤프)의 **rev 대칭 보완**. 큰 정적 읽기
(함수 목록·문자열·xref·call graph)를 **컨텍스트 밖으로** 빼서 한 번 추출·캐시하고,
오케스트레이터/scout 는 슬라이스만 회수한다 (컨텍스트 위생).

킬러 기능: **string↔function xref + interesting-function 휴리스틱**
  → "Correct/flag/license" 문자열을 참조하고 strcmp/memcmp 를 부르는 함수를
     자동 지목 → `decomp <bin> <그 함수>` 로 바로 직행.

엔진 (같은 revmap 스키마 방출):
  - **angr** (기본, 정확) — CFGFast + xrefs. 순수 Python (angr 설치 venv 사용, SETUP.md 참고).
  - **binutils** (`--fast`) — readelf/nm/strings/objdump. xref 없음(빠른 훑기용).

angr 는 lazy-import. 기본 rev 분석은 `.venv-angr` 인터프리터를 자동 선택하고,
환경이 없으면 `revq selftest`(순수 로직)·`--fast`만 된다.

사용:
  revq <bin>                     # 요약 (triage 표 + interesting 지목)
  revq <bin> --funcs [-n N] [--sort size|xrefs|name]
  revq <bin> --strings [--grep RE]
  revq <bin> --imports
  revq <bin> --interesting       # check-루틴 후보만
  revq <bin> --func <name|addr>  # 한 함수의 이웃(calls/callers/strings) 컨텍스트 카드
  revq <bin> --xrefs <name|addr> # 이 심볼/주소를 참조/호출하는 곳
  revq <bin> --format json       # revmap JSON (--json 별칭)
  revq <bin> --funcs --format json  # 함수 뷰 JSON (--funcs가 뷰를 선택)
  revq <bin> --fast              # binutils 엔진 (xref 없음, 빠른 훑기용)
  revq <bin> --refresh           # 캐시 무시 재추출
  revq selftest                  # 네트워크·바이너리 무관 순수 로직 검증
"""
import argparse
import hashlib
import json
import logging
import math
import os
import re
import signal
import sys
import tempfile
import time
import uuid
from datetime import datetime, timezone
from ratlib.angr_runtime import reexec_for_angr

from ratlib.evasion import (
    SIGNAL_SCHEMA as EVASION_SIGNAL_SCHEMA,
    classify as classify_evasion_signals,
    entropy as _entropy,
    has_current_contract as _has_current_evasion_contract,
    render_legacy as _render_legacy_evasion,
)
from ratlib.runner import run, ResourceLimits
from ratlib.kernel_identity import inspect as inspect_kernel, SCHEMA as KERNEL_IDENTITY_SCHEMA
from ratlib.wasm import is_wasm, inspect as inspect_wasm

SCHEMA = 6
REVQ_POLICY = "sha256:" + hashlib.sha256(
    b"revq-local-static-analysis-v6-wasm-and-engine-diagnostics"
).hexdigest()

# ─────────────────────────── 휴리스틱 사전 ───────────────────────────
# check-루틴을 가리키는 신호. recon 의 SINK 사전과 목적이 다르다(rev = 판별 로직).
INTERESTING_STR = re.compile(
    r"correct|incorrect|wrong|valid|invalid|success|fail|denied|granted|"
    r"accept|reject|flag|license|licen[cs]e|serial|passwo?rd|passphrase|"
    r"congrat|nice|good\s*job|try\s*again|access|unlock|key|secret|token",
    re.I,
)
FLAG_STR = re.compile(r"flag|\bctf\b|\}$|\{.*\}", re.I)
# oracle success/failure classification — reuses the same extracted strings/xrefs.
ORACLE_SUCCESS_STR = re.compile(
    r"correct|success|granted|accept(?:ed)?|congrat|nice|good\s*job|unlock|welcome|\bvalid\b",
    re.I,
)
ORACLE_FAILURE_STR = re.compile(
    r"incorrect|wrong|denied|reject(?:ed)?|invalid|fail(?:ed|ure)?|try\s*again",
    re.I,
)
CMP_FUNCS = {
    "strcmp", "strncmp", "memcmp", "strcasecmp", "strncasecmp", "strstr",
    "strcoll", "bcmp", "wcscmp", "wcsncmp",
}
LENGTH_CMP_FUNCS = {"strncmp", "memcmp", "strncasecmp", "bcmp", "wcsncmp"}
INPUT_FUNCS = {
    "scanf", "__isoc99_scanf", "sscanf", "__isoc99_sscanf", "read", "fgets",
    "gets", "getline", "fread", "getchar", "fgetc", "recv", "getenv",
}
CRYPTO_HINTS = re.compile(r"aes|des|rc4|md5|sha[0-9]|base64|xor|rsa|hmac|crc", re.I)


def classify_evasion(imports, strings, entropy, sections):
    """Compatibility API returning the historical human-readable list.

    Semantic callers must consume `evasion_signals`; this rendering exists for
    CLI/backward compatibility only.
    """
    return _render_legacy_evasion(classify_evasion_signals(imports, strings, entropy, sections))


def _file_evasion_projection(binpath, imports, strings, sections):
    """Return typed evasion observations plus the one-way legacy rendering."""
    try:
        with open(binpath, "rb") as f:
            ent = _entropy(f.read())
    except Exception:
        ent = None
    signals = classify_evasion_signals(imports, [s["val"] for s in strings], ent, sections)
    return {
        "evasion_signal_schema": EVASION_SIGNAL_SCHEMA,
        "evasion_signals": signals,
        "evasion": _render_legacy_evasion(signals),
    }


def _file_evasion(binpath, imports, strings, sections):
    """Compatibility helper returning only the historical prose list."""
    return _file_evasion_projection(binpath, imports, strings, sections)["evasion"]


# ─────────────────────────── 유틸 ───────────────────────────
def die(msg, code=1):
    print("[revq:err] " + msg, file=sys.stderr)
    sys.exit(code)


class AngrAnalysisError(RuntimeError):
    """An actionable angr failure that in-process callers can preserve."""

    def __init__(self, message, kind="analysis_failed"):
        super().__init__(message)
        self.kind = kind


def info(msg):
    print("[revq] " + msg, file=sys.stderr)


def now_iso():
    return datetime.now(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")


def sh(cmd):
    """리스트 인자를 실행해 stdout을 반환하고, runner 예외에서만 빈 문자열을 반환한다."""
    try:
        result = run(cmd, timeout_seconds=30, tool_version="binutils")
        return result.stdout.preview.decode("utf-8", errors="replace")
    except Exception:
        return ""


def sha256(path):
    h = hashlib.sha256()
    with open(path, "rb") as f:
        for chunk in iter(lambda: f.read(65536), b""):
            h.update(chunk)
    return h.hexdigest()


def cache_path(binpath):
    return binpath + ".revq.json"


# angr CFGFast cost grows sharply with input size (measured on this host:
# 0.15MB ~1s/171MB RSS, 0.96MB ~85s/532MB, 3.9MB >10min/1.3GB). Refuse the
# full-program lift above the default cap instead of swapping/OOM-killing the
# caller; a cached revmap still short-circuits the guard.
DEFAULT_MAX_ANGR_INPUT_MB = 2


def _angr_size_guard(binpath, max_bytes, allow_large):
    """Fail closed on oversized angr inputs, with explicit escape hatches.

    The `rat` front door (route/brief/query func|graph) loads revq in-process
    and has no --allow-large/--max-input-mb flags of its own, so without an env
    hatch a >cap binary loses ALL rev analysis there with no reachable override.
    Honor RAT_ALLOW_LARGE here exactly as analysis.py:angr_size_refusal does for
    the slice path, so both angr entry points share one override contract.
    """
    if allow_large or os.environ.get("RAT_ALLOW_LARGE") in {"1", "true", "yes"}:
        return
    limit = DEFAULT_MAX_ANGR_INPUT_MB * 1024 * 1024 if max_bytes is None else int(max_bytes)
    if limit <= 0:
        return
    try:
        size = os.path.getsize(binpath)
    except OSError:
        return
    if size <= limit:
        return
    raise AngrAnalysisError(
        "입력이 angr 기본 상한을 넘음: %.1fMB > %.1fMB "
        "(CFGFast는 전체 프로그램을 IR로 올려 크기에 대해 급격히 느려짐; "
        "실측 0.96MB≈85초, 3.9MB>10분)\n"
        "  대안: (a) --fast  binutils 엔진(xref 없음; stripped면 함수 목록도 없음)\n"
        "        (b) --max-input-mb N  상한 상향 (revq CLI)\n"
        "        (c) --func <symbol>  심볼 범위만 분석; 주소는 --func-size BYTES 필요\n"
        "        (d) --allow-large  가드 해제(별도 300초/4GiB 예산; revq CLI)\n"
        "        (e) RAT_ALLOW_LARGE=1  env로 가드 해제 (rat route/brief/query)"
        % (size / 1024 / 1024, limit / 1024 / 1024),
        kind="size_limit",
    )


def annotate_counts(rev):
    """Expose exact/visible/truncated function counts without conflating aliases."""
    funcs = rev.get("functions", [])
    canonical, aliases = set(), {}
    for func in funcs:
        addr = func.get("addr")
        key = ("addr", int(addr)) if addr else ("name", func.get("name", "?"))
        canonical.add(key)
        aliases.setdefault("%s:%s" % key, []).append(func.get("name", "?"))
    exact = bool(rev.get("analysis_complete", rev.get("engine") == "angr"))
    rev["counts"] = {
        "functions_total": len(canonical),
        "functions_records": len(funcs),
        "functions_filtered": int(rev.get("functions_filtered", 0)),
        "functions_visible": len(canonical),
        "functions_truncated": 0,
        "functions_exact": exact,
        "function_candidates_total": len(rev.get("function_candidates", [])),
        "scope": ("bounded function region and discovered stubs" if rev.get("function_scope") else
                  "Wasm defined function bodies (no CFG)" if rev.get("engine") == "wasm-structure"
                  else "discovered non-PLT functions" if rev.get("engine") == "angr"
                  else "defined text symbols only"),
        "aliases": {key: names for key, names in aliases.items() if len(names) > 1},
    }
    return rev


def parse_int(s):
    """'0x1234' / '4660' / 심볼주소 문자열 → int|None."""
    if s is None:
        return None
    s = s.strip()
    try:
        return int(s, 16) if s.lower().startswith("0x") else int(s, 0)
    except (ValueError, TypeError):
        return None


# ─────────────────────────── 엔진 A: angr (정확) ───────────────────────────
def _engine_analysis_status(diagnostics):
    if any(item["severity"] in {"error", "critical"} for item in diagnostics):
        return "partial"
    return "complete-with-warnings" if diagnostics else "complete"


def _extract_angr_impl(binpath, diagnostics, load_spec=None, cfg_options=None,
                       string_ref_probe=False):
    """CFGFast + xrefs 로 revmap 추출. angr 는 여기서만 import (Mac selftest 격리)."""
    try:
        import angr  # noqa: F401
    except ImportError:
        die("angr 미설치 — SETUP.md 대로 venv 세팅 후 실행하거나 `--fast`(binutils) 사용.\n"
            "  예: python3 bin/revq %s" % binpath)

    import angr
    info("angr CFGFast 분석 중 (최초 1회, 크기에 따라 수초~수분)...")
    from ratlib.raw_loader import project as raw_project
    proj = raw_project(binpath, load_spec)
    obj = proj.loader.main_object
    options = {"cross_references": True, "data_references": True,
               "normalize": True, "show_progressbar": False}
    if cfg_options:
        options.update(cfg_options)
    cfg = proj.analyses.CFGFast(**options)
    funcs_mgr = cfg.kb.functions
    callgraph = getattr(cfg.kb, "callgraph", None)
    platform = _detect_platform(sh(["file", binpath]))

    strings = _extract_strings_from_loader(proj)
    str_by_addr = {s["addr"]: s for s in strings}
    xref_dst = _angr_xrefs_by_dst(proj)

    for s in strings:
        s["xrefs"] = []
    for saddr, srec in str_by_addr.items():
        for ins in xref_dst.get(saddr, ()):
            fn = _floor_func_name(funcs_mgr, ins)
            srec["xrefs"].append({"func": fn, "addr": ins})

    imports = sorted(set(obj.imports.keys())) if getattr(obj, "imports", None) else []
    if not imports and getattr(obj, "plt", None):
        imports = sorted(obj.plt.keys())

    functions = []
    method_string_refs = []
    all_functions = list(funcs_mgr.values())
    for f in all_functions:
        if f.is_simprocedure or f.is_plt:
            continue
        if string_ref_probe:
            try:
                method_string_refs.extend({"func": f.name, "addr": int(addr)}
                                          for addr, _content in f.string_references())
            except Exception:
                pass
        call_sites = _func_call_sites(proj, f, funcs_mgr, obj.arch.name, platform)
        calls = sorted({site["api"] for site in call_sites if site.get("api")})
        fstrs = sorted({srec["val"] for srec in strings
                        for xr in srec["xrefs"] if xr["func"] == f.name})
        ncallers = 0
        if callgraph is not None and f.addr in callgraph:
            try:
                ncallers = len(set(callgraph.predecessors(f.addr)))
            except Exception:
                ncallers = 0
        try:
            blocks = list(f.blocks)
        except Exception:
            blocks = []
        instruction_count = 0
        for block in blocks:
            count = getattr(block, "instructions", None)
            if isinstance(count, int):
                instruction_count += count
                continue
            try:
                instruction_count += len(block.capstone.insns)
            except Exception:
                pass
        functions.append({
            "name": f.name,
            "addr": f.addr,
            "size": int(f.size or 0),
            "nblocks": len(blocks),
            "ninstr": instruction_count,
            "count_quality": "cfg",
            "calls": calls,
            "call_sites": call_sites,
            "strings": fstrs,
            "ncallers": ncallers,
        })

    sec_names = [s.name for s in getattr(obj, "sections", []) if getattr(s, "name", None)]
    evasion = _file_evasion_projection(binpath, imports, strings, sec_names)
    result = {
        "schema": SCHEMA,
        "engine": "angr",
        "arch": obj.arch.name,
        "pie": bool(getattr(obj, "pic", False)),
        "stripped": _is_stripped(binpath),
        "functions": functions,
        "strings": strings,
        "imports": imports,
        "analysis_complete": _engine_analysis_status(diagnostics) == "complete",
        "analysis_status": _engine_analysis_status(diagnostics),
        "analysis_diagnostics": diagnostics,
        "functions_filtered": sum(1 for f in all_functions if f.is_simprocedure or f.is_plt),
        **evasion,
        "platform": platform,
    }
    if string_ref_probe:
        result["string_reference_probe"] = sorted(method_string_refs,
                                                  key=lambda item: (item["addr"], item["func"]))
    return result


def extract_angr(binpath, load_spec=None, cfg_options=None, string_ref_probe=False):
    """Capture bounded engine diagnostics across extraction and restore logging."""
    diagnostics = []
    class Capture(logging.Handler):
        def emit(self, record):
            item = {"severity": record.levelname.lower(),
                    "source": record.name, "message": record.getMessage()[:240]}
            if len(diagnostics) < 8:
                diagnostics.append(item)
            elif item["severity"] in {"error", "critical"} and not any(
                    previous["severity"] in {"error", "critical"} for previous in diagnostics):
                diagnostics[-1] = item
    handler = Capture(level=logging.WARNING)
    loggers = [logging.getLogger(name) for name in ("angr", "cle", "pyvex")]
    old = [(logger.level, logger.propagate) for logger in loggers]
    for logger in loggers:
        logger.setLevel(logging.WARNING)
        logger.propagate = False
        logger.addHandler(handler)
    try:
        if cfg_options is not None or string_ref_probe:
            return _extract_angr_impl(binpath, diagnostics, load_spec, cfg_options,
                                      string_ref_probe)
        return (_extract_angr_impl(binpath, diagnostics) if load_spec is None else
                _extract_angr_impl(binpath, diagnostics, load_spec))
    finally:
        for logger, (level, propagate) in zip(loggers, old):
            logger.removeHandler(handler)
            logger.setLevel(level)
            logger.propagate = propagate


def _extract_angr_bounded(binpath, load_spec, allow_large, scope=None):
    """Run full CFGFast outside the caller with time and address-space caps."""
    from ratlib.angr_runtime import configured_python
    python = configured_python() or sys.executable
    explicit = allow_large or os.environ.get("RAT_ALLOW_LARGE") in {"1", "true", "yes"}
    timeout = 300 if explicit else 120
    memory = (4 if explicit else 2) * 1024 * 1024 * 1024
    limits = ResourceLimits(cpu_seconds=timeout, address_space_bytes=memory,
                            file_size_bytes=128 * 1024 * 1024)
    worker = os.path.join(os.path.dirname(os.path.realpath(__file__)),
                          "ratlib", "angr_worker.py")
    with tempfile.TemporaryDirectory(prefix="rat-revq-angr-") as directory:
        output = os.path.join(directory, "revmap.json")
        result = run([python, worker, os.path.realpath(binpath), output,
                      json.dumps(load_spec, sort_keys=True),
                      json.dumps(scope, sort_keys=True)],
                     timeout_seconds=timeout, limits=limits, preview_bytes=16 * 1024,
                     max_output_bytes=64 * 1024,
                     env={"CTF_HOME": os.environ.get("CTF_HOME") or
                          os.path.dirname(os.path.dirname(os.path.realpath(__file__)))},
                     tool_version="revq-angr-worker-v1")
        stderr = result.stderr.preview.decode("utf-8", "replace")
        if result.timed_out or result.resource_limited:
            raise AngrAnalysisError("angr CFGFast timeout (%ds budget)" % timeout,
                                    kind="timeout")
        if result.exit_code != 0:
            # The worker runs under an explicit RLIMIT_AS.  Python allocations over
            # it raise MemoryError (the worker emits RAT_ANGR_WORKER_OOM); native
            # CFGFast allocations (pyvex/unicorn) over it instead get a NULL and
            # crash the worker with SIGSEGV, which is NOT a MemoryError/SIGKILL and
            # was being mislabelled analysis_failed -- hiding that raising the
            # budget (--allow-large / RAT_ALLOW_LARGE) is the actual remedy.  Treat
            # a worker SIGSEGV as the memory limit too; the message stays honest so
            # a genuine analysis crash that survives --allow-large is still visible.
            if ("RAT_ANGR_WORKER_OOM" in stderr or "MemoryError" in stderr
                    or result.signal in {signal.SIGKILL, signal.SIGXFSZ, signal.SIGSEGV}):
                detail = (" (worker crashed with SIGSEGV; if it persists under "
                          "--allow-large it is an analysis bug, not the cap)"
                          if result.signal == signal.SIGSEGV else "")
                raise AngrAnalysisError("angr CFGFast memory limit (%.0f GiB)%s" %
                                        (memory / 1024 ** 3, detail), kind="resource_limit")
            raise AngrAnalysisError("angr worker failed (exit %s): %s" %
                                    (result.exit_code, stderr[-600:]), kind="analysis_failed")
        try:
            with open(output, encoding="utf-8") as stream:
                return json.load(stream)
        except (OSError, ValueError) as exc:
            raise AngrAnalysisError("angr worker returned no valid revmap: %s" % exc) from exc


def _resolve_function_scope(binpath, target, size_override, load_spec):
    """Resolve one mapped function without running CFGFast in the caller."""
    from ratlib.raw_loader import project as raw_project
    try:
        import angr  # noqa: F401
    except ImportError as exc:
        raise AngrAnalysisError(
            "angr 미설치: 함수 범위 해석에 angr가 필요합니다 (SETUP.md의 .venv-angr) "
            "또는 --fast(binutils)/Ghidra 경로를 사용하세요",
            kind="dependency_missing") from exc
    proj = raw_project(binpath, load_spec)
    obj = proj.loader.main_object
    addr = parse_int(target)
    symbol = None
    if addr is None:
        symbol = obj.get_symbol(target) if hasattr(obj, "get_symbol") else None
        if symbol is None or not getattr(symbol, "is_function", False):
            raise AngrAnalysisError("함수 '%s' 심볼 없음; 시작 주소와 --func-size를 지정하세요" % target,
                                    kind="scope_required")
        addr = int(symbol.rebased_addr)
    if size_override is not None:
        size = size_override
        quality = "operator-range"
    elif symbol is not None and int(getattr(symbol, "size", 0)) > 0:
        size = int(symbol.size)
        quality = "elf-symbol-range"
    else:
        raise AngrAnalysisError("주소 함수는 --func-size BYTES가 필요합니다 (전체 범위 추측 금지)",
                                kind="scope_required")
    if size <= 0 or size > 65536:
        raise AngrAnalysisError("함수 범위는 1..65536 bytes여야 합니다", kind="scope_required")
    try:
        proj.loader.memory.load(addr, 1)
        proj.loader.memory.load(addr + size - 1, 1)
    except Exception as exc:
        raise AngrAnalysisError("함수 범위가 로드된 매핑 밖입니다", kind="scope_required") from exc
    return {"addr": addr, "end": addr + size, "size": size,
            "name": target if symbol is not None else None,
            "range_quality": quality, "coverage": "bounded-function-region",
            "whole_program_facts": False}


def _load_or_extract_local(binpath, target, size_override, refresh, load_spec, allow_large):
    try:
        import angr
    except ImportError as exc:
        raise AngrAnalysisError(
            "angr 미설치: 함수 단위 분석에 angr가 필요합니다 (SETUP.md의 .venv-angr) "
            "또는 --fast(binutils)/Ghidra 경로를 사용하세요",
            kind="dependency_missing") from exc
    scope = _resolve_function_scope(binpath, target, size_override, load_spec)
    digest = sha256(binpath)
    # load_spec changes how the raw bytes are decoded (arch/base/entry), but a raw
    # blob's addr/end come from the operator-supplied target+size, so they are
    # identical across arches.  Omitting load_spec here let a second query with a
    # different --arch hit the first arch's cached analysis.  Bind it into the key
    # and re-check it on every hit so i386 and amd64 never share a cache entry.
    key = hashlib.sha256(json.dumps({
        "input_sha256": digest, "scope": {"addr": scope["addr"], "end": scope["end"]},
        "engine": "angr", "angr_version": angr.__version__, "schema": SCHEMA,
        "load_spec": load_spec,
        "options": "cfgfast-local-region-v1-crossrefs-datarefs-normalized",
    }, sort_keys=True).encode()).hexdigest()[:24]
    cp = binpath + ".func-" + key + ".revq.json"
    if not refresh and os.path.isfile(cp):
        try:
            with open(cp, encoding="utf-8") as stream:
                rev = json.load(stream)
            if (rev.get("sha256") == digest and rev.get("function_scope") == scope
                    and rev.get("load_spec") == load_spec
                    and rev.get("schema") == SCHEMA and _has_current_evasion_contract(rev)):
                rev["cache_state"] = "hit"
                return annotate_counts(rev)
        except (OSError, ValueError):
            pass
    rev = _extract_angr_bounded(binpath, load_spec, allow_large, scope)
    if scope["name"]:
        for func in rev.get("functions", []):
            if func.get("addr") == scope["addr"]:
                previous = func.get("name")
                func["name"] = scope["name"]
                for string in rev.get("strings", []):
                    for xref in string.get("xrefs", []):
                        if xref.get("func") == previous:
                            xref["func"] = scope["name"]
    rev.update(bin=binpath, sha256=digest, generated_at=now_iso(), cache_state="miss",
               function_scope=scope, analysis_complete=False, analysis_status="partial")
    if load_spec:
        rev["load_spec"] = load_spec
    rev.setdefault("analysis_diagnostics", []).append({
        "severity": "warning", "source": "revq",
        "message": "single function region only; callers, outside calls and global xrefs are incomplete"})
    annotate_counts(rev)
    try:
        with open(cp, "w", encoding="utf-8") as stream:
            json.dump(rev, stream)
    except OSError:
        pass
    return rev


def extract_wasm(binpath):
    """Expose only structural facts; Wasm control/data flow needs another engine."""
    inventory = inspect_wasm(binpath)
    functions = [{"name": f["name"], "addr": 0, "size": f["size"],
                  "nblocks": 0, "ninstr": 0, "count_quality": "unavailable",
                  "calls": [], "strings": [], "ncallers": 0,
                  "wasm_index": f["index"], "body_sha256": f["body_sha256"]}
                 for f in inventory["functions"][:256]]
    return {"schema": SCHEMA, "engine": "wasm-structure", "platform": "wasm",
            "arch": "wasm32", "pie": False, "stripped": False,
            "functions": functions, "strings": [],
            "imports": [item["module"] + "." + item["name"] for item in inventory["imports"]],
            "analysis_complete": False, "analysis_status": "partial",
            "analysis_diagnostics": ["Wasm section inventory only; no CFG, xrefs or runtime verification"],
            "functions_filtered": max(0, len(inventory["functions"]) - 256),
            "wasm_inventory": {"schema": inventory["schema"], "format": inventory["format"],
                               "sha256": inventory["sha256"], "coverage": inventory["coverage"],
                               "sections": inventory["sections"],
                               "imports_total": len(inventory["imports"]),
                               "exports_total": len(inventory["exports"]),
                               "functions_total": len(inventory["functions"])},
            "evasion_signal_schema": EVASION_SIGNAL_SCHEMA,
            "evasion_signals": [], "evasion": []}


def _extract_strings_from_loader(proj):
    """loader 메모리의 .rodata/.data 계열에서 printable run(≥4) 추출 → vaddr 부여."""
    out = []
    obj = proj.loader.main_object
    want = (".rodata", ".data", ".data.rel.ro", ".rdata")
    for sec in getattr(obj, "sections", []):
        if sec.name not in want or not sec.memsize:
            continue
        try:
            blob = proj.loader.memory.load(sec.vaddr, sec.memsize)
        except Exception:
            continue
        for off, s in _iter_cstrings(blob, minlen=4):
            out.append({"addr": sec.vaddr + off, "val": s, "sec": sec.name, "xrefs": []})
    return out


def _iter_cstrings(blob, minlen=4):
    """bytes → (offset, str) 생성. NUL 로 끝나는 printable run."""
    cur = bytearray()
    start = 0
    for i, b in enumerate(blob):
        if 0x20 <= b < 0x7f or b in (9,):
            if not cur:
                start = i
            cur.append(b)
        else:
            if len(cur) >= minlen:
                yield start, cur.decode("latin-1")
            cur = bytearray()
    if len(cur) >= minlen:
        yield start, cur.decode("latin-1")


def _angr_xrefs_by_dst(proj):
    """kb.xrefs → {dst_addr: [ins_addr,...]}. 버전별 API 차이 방어."""
    out = {}
    xm = getattr(proj.kb, "xrefs", None)
    if xm is None:
        return out
    by_dst = getattr(xm, "xrefs_by_dst", None)
    if isinstance(by_dst, dict):
        for dst, refs in by_dst.items():
            for r in refs:
                ins = getattr(r, "ins_addr", None)
                if ins is not None:
                    out.setdefault(dst, []).append(ins)
        return out
    try:
        for r in xm.get_xrefs():  # type: ignore[attr-defined]
            dst = getattr(r, "dst", None)
            ins = getattr(r, "ins_addr", None)
            if dst is not None and ins is not None:
                out.setdefault(dst, []).append(ins)
    except Exception:
        pass
    return out


def _floor_func_name(funcs_mgr, addr):
    try:
        f = funcs_mgr.floor_func(addr)
        return f.name if f is not None else "?"
    except Exception:
        return "?"


def _func_call_targets(f, funcs_mgr):
    """Compatibility projection for consumers that only need distinct callees."""
    names = []
    try:
        for site in f.get_call_sites():
            tgt = f.get_call_target(site)
            if tgt is None:
                continue
            g = funcs_mgr.get(tgt) if hasattr(funcs_mgr, "get") else None
            names.append(g.name if g is not None else hex(tgt))
    except Exception:
        pass
    return sorted(set(names))


def _immediate(text):
    """Parse one assembler immediate without treating symbols/registers as constants."""
    value = text.strip().lower().lstrip("#")
    if value.startswith("$"):
        value = value[1:]
    if not re.fullmatch(r"(?:0x[0-9a-f]+|[0-9]+)", value):
        return None
    try:
        return int(value, 0)
    except ValueError:
        return None


def _capstone_detail(insn):
    """Return the underlying capstone instruction used by angr's wrapper."""
    return getattr(insn, "insn", insn)


def _register_writes(insn):
    """Return normalized register names written by an instruction, or None.

    ``regs_access`` includes both explicit and implicit effects (for example
    CQO/MUL/DIV writing RDX).  Failure is deliberately not replaced with an
    opcode-name guess: callers must treat unavailable semantics as unresolved.
    """
    detail = _capstone_detail(insn)
    try:
        _reads, writes = detail.regs_access()
        names = {str(detail.reg_name(reg)).lower() for reg in writes}
    except Exception:
        return None
    return names


def _is_immediate_call(insn):
    """Accept only a decoded x86 CALL whose sole operand is immediate."""
    detail = _capstone_detail(insn)
    if str(getattr(detail, "mnemonic", "")).lower() not in {"call", "callq"}:
        return False
    try:
        operands = list(detail.operands)
    except Exception:
        return False
    try:
        from capstone import CS_OP_IMM
    except ImportError:
        CS_OP_IMM = 2  # Capstone's stable public operand-type value.
    return len(operands) == 1 and operands[0].type == CS_OP_IMM


def _x86_64_length_argument(insns, api, supported_abi=True):
    """Conservatively recover a SysV x86-64 compare count from the call block.

    The last write to RDX/EDX before the call must itself establish a literal.
    This deliberately does not perform cross-block reaching-definition guesses.
    """
    if api not in LENGTH_CMP_FUNCS:
        return {"status": "not_applicable", "reason": "comparison API has no length argument"}
    if not supported_abi:
        return {"status": "unsupported_abi", "reason": "length recovery supports ELF AMD64 System V only"}
    for insn in reversed(list(insns)[:-1]):
        mnemonic = str(getattr(insn, "mnemonic", "")).lower()
        operands = [x.strip().lower() for x in str(getattr(insn, "op_str", "")).split(",")]
        writes = _register_writes(insn)
        if writes is None:
            return {"status": "value_unresolved",
                    "reason": "capstone register-write semantics are unavailable"}
        aliases = {"rdx", "edx", "dx", "dl", "dh"}
        if not writes.intersection(aliases):
            continue
        dst = operands[0] if operands and operands[0] else None
        evidence = {"instruction_address": int(insn.address), "register": dst,
                    "instruction": (mnemonic + " " + str(getattr(insn, "op_str", ""))).strip(),
                    "analysis_source": "capstone-register-effects"}
        if mnemonic == "mov" and dst in {"rdx", "edx"} and len(operands) == 2:
            value = _immediate(operands[1])
            if value is not None:
                return {"status": "constant", "value": value, "evidence": evidence}
        if mnemonic == "xor" and dst in {"rdx", "edx"} and len(operands) == 2 and operands[0] == operands[1]:
            return {"status": "constant", "value": 0, "evidence": evidence}
        return {"status": "value_unresolved", "reason": "last length-register definition is not a supported literal",
                "evidence": evidence}
    return {"status": "value_unresolved", "reason": "no same-block definition of the length register was found"}


def _func_call_sites(proj, f, funcs_mgr, arch=None, platform=None):
    """Preserve every angr call edge and distinguish block from instruction address."""
    records = []
    try:
        sites = sorted(f.get_call_sites())
    except Exception:
        return records
    for block_addr in sites:
        target = None
        try:
            target = f.get_call_target(block_addr)
        except Exception:
            pass
        callee = funcs_mgr.get(target) if target is not None and hasattr(funcs_mgr, "get") else None
        api = callee.name if callee is not None else (hex(target) if target is not None else None)
        insn_addr = None
        reason = None
        insns = []
        try:
            block = proj.factory.block(block_addr)
            insns = list(block.capstone.insns)
            if str(getattr(block.vex, "jumpkind", "")).startswith("Ijk_Call") and insns:
                insn_addr = int(insns[-1].address)
            else:
                reason = "CFG call block has no decodable terminal call instruction"
        except Exception:
            reason = "call instruction could not be decoded from CFG block"
        record = {
            "block_address": int(block_addr),
            "instruction_address": insn_addr,
            "target_address": int(target) if target is not None else None,
            "api": api,
            "target_kind": "resolved" if target is not None else "unresolved",
            "analysis_source": "angr.CFGFast",
            "address_space": "loader-virtual-address",
        }
        if api in CMP_FUNCS:
            supported_abi = arch == "AMD64" and platform == "elf"
            direct_call = bool(insns and _is_immediate_call(insns[-1]))
            record["length_argument"] = (_x86_64_length_argument(insns, api, supported_abi)
                                         if direct_call else
                                         {"status": "value_unresolved",
                                          "reason": "length recovery is limited to direct comparison calls"})
        if reason:
            record["unresolved_reason"] = reason
        records.append(record)
    return records


def _is_stripped(binpath):
    return "not stripped" not in sh(["file", binpath])


def _detect_platform(ftype):
    """`file` 출력 → 플랫폼. PE/DLL(Windows) vs ELF(Linux) 라우팅용."""
    if "PE32" in ftype or "MS Windows" in ftype or "for MS Windows" in ftype:
        return "pe"
    if "ELF" in ftype:
        return "elf"
    if "Mach-O" in ftype:
        return "macho"
    return "?"


# ─────────────────── stripped 함수-시작 자동 발견 (Nucleus 경량판) ───────────────────
# 결정론적 바이트 스윕: angr/Ghidra를 호출하지 않고 .text 바이트만 선형 스캔한다.
# 결과는 확정 함수가 아니라 후보이며(근거 source + confidence 태깅), CFG/xref/크기를
# 주장하지 않는다. stripped 대용량 바이너리에서 `revq --func <addr> --func-size`가 쓸
# 시작 주소 후보를 공급하는 것이 목적이다. 외부 프로세스·게이트 무관(순수 파이썬).
FUNC_CANDIDATE_CAP = 4096
_TEXT_SCAN_MAX_BYTES = 16 * 1024 * 1024  # .text가 이보다 크면 스윕을 건너뛴다(상한)

# 근거별 confidence (보수적): endbr64 > call-target > prologue > entry/plt.
_CANDIDATE_CONFIDENCE = {"endbr64": "high", "call-target": "medium",
                         "prologue": "low", "entry": "medium", "plt": "low"}
_CONFIDENCE_RANK = {"high": 3, "medium": 2, "low": 1}


def _readelf_sections(binpath):
    """[(name, vma, file_off, size, flags)] from `readelf -SW` (deterministic)."""
    out = []
    for line in sh(["readelf", "-SW", binpath]).splitlines():
        # "  [16] .text   PROGBITS  <vma> <off> <size> <es> <flg> ..."
        m = re.match(r"\s*\[\s*\d+\]\s+(\.\S+)\s+\S+\s+([0-9a-fA-F]+)\s+"
                     r"([0-9a-fA-F]+)\s+([0-9a-fA-F]+)\s+\S+\s+([A-Z]*)", line)
        if m:
            out.append((m.group(1), int(m.group(2), 16), int(m.group(3), 16),
                        int(m.group(4), 16), m.group(5)))
    return out


def _elf_entry(binpath):
    for line in sh(["readelf", "-hW", binpath]).splitlines():
        m = re.search(r"Entry point address:\s*0x([0-9a-fA-F]+)", line)
        if m:
            return int(m.group(1), 16)
    return None


def _discover_function_candidates(binpath, arch, pie=False):
    """Return function-start candidates for a (typically stripped) ELF.

    Collects, with a source tag per address: entry point, .plt/.plt.sec starts,
    x86 function prologues swept over .text, and near-call (E8 rel32) targets
    that land inside .text. Deterministic and bounded.

    Addresses are returned in the SAME loader-virtual-address space that
    ``revq --func <addr>`` consumes, so a candidate can be fed straight back in:
    angr rebases a PIE to 0x400000, so a PIE file VMA is shifted by that base;
    a non-PIE already carries loader VMAs in its headers.  ``address_space`` is
    recorded on each candidate to make this explicit.
    """
    if arch not in {"amd64", "i386"}:
        return []
    load_base = 0x400000 if pie else 0
    sections = _readelf_sections(binpath)
    text = next((s for s in sections if s[0] == ".text"), None)
    if text is None or text[3] <= 0 or text[3] > _TEXT_SCAN_MAX_BYTES:
        return []
    _name, text_vma, text_off, text_size, _flg = text
    try:
        with open(binpath, "rb") as stream:
            stream.seek(text_off)
            blob = stream.read(text_size)
    except OSError:
        return []
    if len(blob) < text_size:
        text_size = len(blob)
    text_end = text_vma + text_size

    # file-VMA -> strongest source seen; the stored key stays in file-VMA space
    # for the sweep, and load_base is applied once at emit time.
    found = {}

    def add(addr, source):
        if not text_vma <= addr < text_end:
            return
        prev = found.get(addr)
        if prev is None or _CONFIDENCE_RANK[_CANDIDATE_CONFIDENCE[source]] > \
                _CONFIDENCE_RANK[_CANDIDATE_CONFIDENCE[prev]]:
            found[addr] = source

    entry = _elf_entry(binpath)
    if entry is not None:
        add(entry, "entry")
    for name, vma, _o, size, _f in sections:
        if name in {".plt", ".plt.sec", ".plt.got"} and size > 0:
            add(vma, "plt")

    # endbr64 (F3 0F 1E FA) and push rbp; mov rbp,rsp prologues.  A function that
    # begins with endbr64 is commonly followed by the push rbp prologue; that
    # push is NOT a second function start, so record where an endbr64 lands and
    # suppress a prologue candidate in the few bytes right after it.
    endbr_at = set()
    i = 0
    n = len(blob)
    while i < n - 3:
        b = blob[i]
        if b == 0xF3 and blob[i + 1:i + 4] == b"\x0f\x1e\xfa":
            add(text_vma + i, "endbr64")
            endbr_at.add(i)
            i += 4
            continue
        if b == 0x55:  # push rbp
            is_prologue = ((arch == "amd64" and blob[i + 1:i + 4] == b"\x48\x89\xe5")
                           or (arch == "i386" and blob[i + 1:i + 3] == b"\x89\xe5"))
            # Suppress the prologue if an endbr64 sits in the preceding few bytes
            # (same function's body, not a new start).
            shadowed = any((i - k) in endbr_at for k in range(1, 8))
            if is_prologue and not shadowed:
                add(text_vma + i, "prologue")
        i += 1

    # near call E8 rel32 whose target lands in .text.
    j = 0
    while j < n - 4:
        if blob[j] == 0xE8:
            rel = int.from_bytes(blob[j + 1:j + 5], "little", signed=True)
            target = text_vma + j + 5 + rel
            add(target, "call-target")
            j += 5
            continue
        j += 1

    ordered = sorted(found.items())
    truncated = len(ordered) > FUNC_CANDIDATE_CAP
    ordered = ordered[:FUNC_CANDIDATE_CAP]
    candidates = [{"addr": addr + load_base, "source": source,
                   "confidence": _CANDIDATE_CONFIDENCE[source],
                   "address_space": "loader-virtual-address"}
                  for addr, source in ordered]
    if truncated and candidates:
        candidates[-1]["truncated"] = True
    return candidates


# ─────────────────────────── 엔진 B: binutils (빠름, xref 없음) ───────────────────────────
def extract_binutils(binpath):
    """readelf/nm/strings 로 빠른 map. stripped 면 함수 목록 빈약 + xref 없음."""
    ftype = sh(["file", binpath])
    if "ELF" not in ftype:
        if _detect_platform(ftype) == "pe":
            die("PE/Windows 바이너리 — `--fast`(binutils)는 ELF 전용. angr 엔진 사용: `revq %s`(--fast 빼기)" % binpath)
        die("ELF 아님(binutils 엔진은 ELF 전용): %s" % ftype.strip()[:80])
    arch = "amd64" if "x86-64" in ftype else ("i386" if "80386" in ftype else "?")
    pie = "pie executable" in ftype or "shared object" in ftype
    stripped = "not stripped" not in ftype

    functions = []
    nm = sh(["nm", "-C", "--defined-only", binpath])
    for line in nm.splitlines():
        parts = line.split(None, 2)
        if len(parts) == 3 and parts[1] in ("t", "T"):
            addr = parse_int("0x" + parts[0]) if re.fullmatch(r"[0-9a-fA-F]+", parts[0]) else None
            functions.append({"name": parts[2], "addr": addr or 0, "size": 0,
                              "nblocks": 0, "ninstr": 0, "count_quality": "unavailable",
                              "calls": [], "strings": [], "ncallers": 0})

    strings = []
    for line in sh(["strings", "-t", "d", "-n", "4", binpath]).splitlines():
        m = re.match(r"\s*(\d+)\s(.*)", line)
        if m:
            strings.append({"addr": int(m.group(1)), "val": m.group(2),
                            "sec": "?", "xrefs": []})

    imports = []
    for line in sh(["readelf", "-W", "--dyn-syms", binpath]).splitlines():
        if " UND " in line:
            tok = line.split()
            if tok and tok[-1] not in ("", "UND"):
                nm2 = tok[-1].split("@")[0]
                if nm2:
                    imports.append(nm2)
    imports = sorted(set(imports))

    sec_names = re.findall(r"\]\s+(\.\S+)", sh(["readelf", "-SW", binpath]))
    evasion = _file_evasion_projection(binpath, imports, strings, sec_names)
    # Symbols give the authoritative function list; when they are absent (stripped)
    # or sparse, a deterministic prologue/call-target sweep supplies START-ADDRESS
    # candidates so `revq --func <addr> --func-size` has something to aim at.  These
    # are candidates, not confirmed functions: no CFG/xref/size is claimed.
    candidates = []
    if len(functions) < 8:
        candidates = _discover_function_candidates(binpath, arch, pie=pie)
    result = {
        "schema": SCHEMA, "engine": "binutils", "arch": arch, "pie": pie,
        "stripped": stripped, "functions": functions, "strings": strings,
        "imports": imports,
        "function_candidates": candidates,
        "analysis_complete": False,
        "functions_filtered": 0,
        **evasion,
        "platform": _detect_platform(sh(["file", binpath])),
    }
    if candidates:
        result.setdefault("analysis_diagnostics", []).append({
            "severity": "info", "source": "revq",
            "message": ("symbols absent/sparse; %d function-start candidates from a "
                        "deterministic prologue/call sweep (not confirmed functions). "
                        "Analyze one with: revq %s --func <addr> --func-size <N>"
                        % (len(candidates), binpath))})
    return result


# ─────────────────────────── 분석: interesting-function ───────────────────────────
def compute_interesting(rev):
    """check-루틴 후보 스코어링. 엔진 무관(revmap 만 봄) → selftest 가능."""
    imports = set(rev.get("imports", []))
    has_cmp = CMP_FUNCS & imports
    out = []
    for f in rev.get("functions", []):
        score, why = 0, []
        istrs = [s for s in f.get("strings", []) if INTERESTING_STR.search(s)]
        if istrs:
            score += min(3 * len(istrs), 6)
            why.append("판별 문자열 참조: " + ", ".join(_q(s) for s in istrs[:3]))
        fstrs = [s for s in f.get("strings", []) if FLAG_STR.search(s)]
        if fstrs:
            score += 2
            why.append("flag류 문자열")
        calls = set(f.get("calls", []))
        cmp_called = calls & CMP_FUNCS
        if cmp_called:
            score += 2
            why.append("비교함수 호출: " + ", ".join(sorted(cmp_called)))
        in_called = calls & INPUT_FUNCS
        if in_called:
            score += 1
            why.append("입력함수 호출: " + ", ".join(sorted(in_called)))
        crypto = [c for c in calls if CRYPTO_HINTS.search(c)]
        if crypto:
            score += 1
            why.append("crypto 힌트: " + ", ".join(sorted(crypto)[:3]))
        if score > 0:
            out.append({"func": f["name"], "addr": f.get("addr", 0),
                        "size": f.get("size", 0), "score": score, "why": why})
    out.sort(key=lambda x: (-x["score"], -x["size"]))
    if not out and has_cmp:
        out.append({"func": "(미귀속)", "addr": 0, "size": 0, "score": 0,
                    "why": ["비교함수(%s) import 됨 — --xrefs 로 호출부 확인"
                            % ", ".join(sorted(has_cmp))]})
    return out


# ─────────────────────────── 분석: oracle→symsolve 자동연결 ───────────────────────────
def _oracle_candidates(rev, pattern, kind):
    out = []
    for s in rev.get("strings", []):
        if pattern.search(s.get("val", "")):
            out.append({"kind": kind, "string": s.get("val", ""), "string_addr": s.get("addr", 0),
                        "xrefs": list(s.get("xrefs", []))})
    return out


def compute_oracle(rev):
    """success/failure 문자열의 xref BB를 symsolve 좌표로 wiring."""
    success = _oracle_candidates(rev, ORACLE_SUCCESS_STR, "success")
    failure = _oracle_candidates(rev, ORACLE_FAILURE_STR, "failure")

    def resolve(cands):
        if len(cands) != 1:
            return None, ("ambiguous" if len(cands) > 1 else "none")
        xrefs = cands[0]["xrefs"]
        if len(xrefs) != 1:
            return None, ("ambiguous" if len(xrefs) > 1 else "none")
        return {"kind": cands[0]["kind"], "string": cands[0]["string"],
                "func": xrefs[0]["func"], "addr": xrefs[0]["addr"]}, "resolved"

    succ_hit, succ_reason = resolve(success)
    fail_hit, fail_reason = resolve(failure)
    ambiguous = "ambiguous" in (succ_reason, fail_reason)
    auto_connect = succ_hit is not None and fail_hit is not None and not ambiguous
    return {
        "success_candidates": success, "failure_candidates": failure,
        "resolved": {"success": succ_hit, "failure": fail_hit} if auto_connect else None,
        "ambiguous": ambiguous, "auto_connect": auto_connect,
    }


def _q(s):
    s = s if len(s) <= 40 else s[:37] + "..."
    return '"%s"' % s.replace("\n", "\\n")


# ─────────────────────────── 렌더러 ───────────────────────────
def render_summary(rev):
    L = []
    L.append("=" * 64)
    L.append("BIN   : %s" % rev.get("bin", "?"))
    counts = annotate_counts(rev).get("counts", {})
    L.append("PROF  : engine=%s arch=%s pie=%s stripped=%s | funcs=%d strings=%d imports=%d"
             % (rev["engine"], rev["arch"], rev["pie"], rev["stripped"],
                counts.get("functions_total", len(rev["functions"])), len(rev["strings"]), len(rev["imports"])))
    imp = set(rev["imports"])
    hot = sorted((imp & CMP_FUNCS) | (imp & INPUT_FUNCS)
                 | {i for i in imp if CRYPTO_HINTS.search(i)}
                 | (imp & {"system", "execve", "ptrace", "fork"}))
    L.append("IMPORT: " + (", ".join(hot) if hot else "(판별/입력/crypto 관련 없음)"))
    if rev["engine"] == "binutils":
        L.append("[!] binutils 엔진 — xref/interesting 부정확. 정밀분석은 angr(기본, --fast 빼기).")
    if rev.get("platform") == "wasm":
        L.append("PLATFORM: WebAssembly core v1 — 섹션/함수 목록만 확인; CFG·xref·성공 검증 아님")
        L.append("  구조 조회: rat-wasm inspect <bin> [--func INDEX] | 독립 실행: rat-wasm verify <bin> --stdin-file INPUT --expect-stdout LITERAL")
        L.append("  runtime 없으면: .venv-angr/bin/python -m pip install wasmtime")
    if rev.get("analysis_diagnostics"):
        L.extend("[!] 분석 상태 %s: %s" %
                 (rev.get("analysis_status", "partial"), item.get("message", "") if isinstance(item, dict) else item)
                 for item in rev["analysis_diagnostics"][:4])
    if rev.get("platform") == "pe":
        L.append("PLATFORM: PE/Windows — 정적=decomp(Ghidra)+revq(angr) | 동적=Qiling/Frida(Wine 불필요)")
        L.append("  ※ recon(pwn/ELF triage) 대상 아님 · .NET/Unity=ilspycmd/il2cppdumper")
        L.append("  라우팅: knowledge/GROUNDING_INDEX.md(PE/.NET 행) · 동적 스캐폴드 solve/_template/rev/qiling_trace.py")

    ev = rev.get("evasion", [])
    if ev:
        L.append("EVASION: " + "; ".join(ev))
        L.append("  ⚠️ 정적 신뢰 하향 — 동적 교차검증(ltrace/strace/gdb, symsolve --verify) 권장")

    inter = compute_interesting(rev)
    L.append("-" * 64)
    L.append("INTERESTING (check-루틴 후보, 점수 내림차순):")
    if inter:
        for it in inter[:8]:
            head = "  [%d] %s" % (it["score"], it["func"])
            if it["addr"]:
                head += " @%#x" % it["addr"]
            if it["size"]:
                head += " (size %d)" % it["size"]
            L.append(head)
            for w in it["why"]:
                L.append("        - " + w)
    else:
        L.append("  (신호 없음 — --strings/--funcs 수동 탐색 or VM 가능성)")

    isr = [s for s in rev["strings"] if INTERESTING_STR.search(s["val"])]
    if isr:
        L.append("-" * 64)
        L.append("판별 문자열 (%d):" % len(isr))
        for s in isr[:12]:
            xf = ",".join(sorted({x["func"] for x in s.get("xrefs", [])})) or "-"
            L.append("  %-42s  ← %s" % (_q(s["val"]), xf))

    oracle = compute_oracle(rev)
    L.append("-" * 64)
    if oracle["auto_connect"]:
        succ, fail = oracle["resolved"]["success"], oracle["resolved"]["failure"]
        L.append("ORACLE  success@%#x (%s: %s)  ·  fail@%#x (%s: %s)"
                  % (succ["addr"], succ["func"], _q(succ["string"]), fail["addr"], fail["func"], _q(fail["string"])))
        L.append("SUGGEST symsolve.py %s --find %#x --avoid %#x --stdin <n> --printable"
                  % (rev.get("bin", "?"), succ["addr"], fail["addr"]))
    elif oracle["ambiguous"]:
        L.append("ORACLE  ambiguous — success 후보 %d개, failure 후보 %d개 (자동연결 안 함, 수동 --xrefs 확인)"
                  % (len(oracle["success_candidates"]), len(oracle["failure_candidates"])))
    else:
        L.append("ORACLE  (success/failure 문자열 신호 없음 — VM/커스텀 인코딩 가능성)")

    L.append("-" * 64)
    top = _sorted_funcs(rev["functions"], "size")[:1]
    tf = (" 최대함수 %s(size %d)" % (top[0]["name"], top[0]["size"])) if top else ""
    if rev.get("platform") == "wasm":
        L.append("다음: rat-wasm inspect %s --func <index>  |  rat-wasm verify %s --stdin-file <input> --expect-stdout <literal>"
                 % (rev.get("bin", "?"), rev.get("bin", "?")))
    else:
        L.append("다음: revq %s --func <후보>  |  decomp %s <후보>%s"
                 % (rev.get("bin", "?"), rev.get("bin", "?"), tf))
    L.append("=" * 64)
    return "\n".join(L)


def _sorted_funcs(funcs, key):
    if key == "name":
        return sorted(funcs, key=lambda f: f["name"])
    if key == "xrefs":
        return sorted(funcs, key=lambda f: -f.get("ncallers", 0))
    return sorted(funcs, key=lambda f: -f.get("size", 0))


def render_funcs(rev, sort="size", limit=40):
    counts = annotate_counts(rev).get("counts", {})
    rows = _sorted_funcs(rev["functions"], sort)
    visible = min(len(rows), limit)
    counts["functions_visible"] = visible
    counts["functions_truncated"] = max(len(rows) - visible, 0)
    L = ["# 함수 total=%d visible=%d filtered=%d truncated=%d exact=%s (sort=%s)  개별: revq <bin> --func <name>"
         % (counts.get("functions_total", len(rows)), visible, counts.get("functions_filtered", 0),
            counts["functions_truncated"], str(counts.get("functions_exact", False)).lower(), sort)]
    L.append("%-24s %-12s %6s %5s %5s %5s %4s  %s" %
             ("NAME", "ADDR", "SIZE", "block", "instr", "xref", "call", "STR"))
    for f in rows[:limit]:
        addr = ("%#x" % f["addr"]) if f.get("addr") else "-"
        s = ",".join(_q(x) for x in f.get("strings", [])[:2])
        L.append("%-24s %-12s %6d %5d %5d %5d %4d  %s"
                 % (f["name"][:24], addr, f.get("size", 0), f.get("nblocks", 0),
                    f.get("ninstr", 0), f.get("ncallers", 0), len(f.get("calls", [])), s[:40]))
    return "\n".join(L)


def funcs_json(rev, sort="size", limit=40):
    """Return the same bounded function view as render_funcs(), as JSON."""
    counts = dict(annotate_counts(rev).get("counts", {}))
    rows = _sorted_funcs(rev.get("functions", []), sort)
    visible = min(len(rows), limit)
    counts["functions_visible"] = visible
    counts["functions_truncated"] = max(len(rows) - visible, 0)
    return {
        "schema": "rat.revq-functions/v1",
        "binary": rev.get("bin"),
        "binary_sha256": rev.get("sha256"),
        "engine": rev.get("engine"),
        "counts": counts,
        "functions": rows[:limit],
    }


def render_strings(rev, grep=None, limit=200):
    rx = re.compile(grep, re.I) if grep else None
    rows = [s for s in rev["strings"] if (rx.search(s["val"]) if rx else True)]
    L = ["# 문자열 %d개%s (xref = 참조 함수)" % (len(rows), " grep=%s" % grep if grep else "")]
    for s in rows[:limit]:
        xf = ",".join(sorted({x["func"] for x in s.get("xrefs", [])})) or "-"
        L.append("%#010x  %-6s  %-44s  ← %s" % (s.get("addr", 0), s.get("sec", "?"),
                                                _q(s["val"]), xf))
    if len(rows) > limit:
        L.append("... (+%d, --grep 로 좁히기)" % (len(rows) - limit))
    return "\n".join(L)


def render_imports(rev):
    imp = sorted(rev["imports"])
    L = ["# imports %d개" % len(imp)]
    buckets = [("판별/비교", CMP_FUNCS), ("입력", INPUT_FUNCS)]
    seen = set()
    for label, group in buckets:
        hit = sorted(set(imp) & group)
        if hit:
            L.append("  [%s] %s" % (label, ", ".join(hit)))
            seen |= set(hit)
    crypto = sorted(i for i in imp if CRYPTO_HINTS.search(i))
    if crypto:
        L.append("  [crypto?] %s" % ", ".join(crypto)); seen |= set(crypto)
    rest = [i for i in imp if i not in seen]
    if rest:
        L.append("  [기타] " + ", ".join(rest))
    return "\n".join(L)


def render_func(rev, target):
    f = _find_func(rev, target)
    if not f:
        return "[!] 함수 '%s' 없음. 목록: revq <bin> --funcs" % target
    L = ["== FUNC %s @%#x (size %d, %d blocks, %d instr; %s) ==" %
         (f["name"], f.get("addr", 0), f.get("size", 0), f.get("nblocks", 0),
          f.get("ninstr", 0), f.get("count_quality", "unknown"))]
    L.append("callers: %d" % f.get("ncallers", 0))
    L.append("calls  : " + (", ".join(f.get("calls", [])) or "-"))
    L.append("strings: " + ("; ".join(_q(s) for s in f.get("strings", [])) or "-"))
    L.append("→ 본문: decomp %s %#x" % (rev.get("bin", "<bin>"), f.get("addr", 0)))
    return "\n".join(L)


# ─────────────────────────── Function Card v4 (rat.function-card/v4) ───────────────────────────
FUNCTION_CARD_SCHEMA = "rat.function-card/v4"
INTERESTING_DETECTOR_VERSION = "interesting-score/v1"
_CAP = 30


def _capped(items):
    items = list(items)
    return items[:_CAP], len(items) > _CAP


def compute_function_card(rev, target):
    """--func/--interesting/--xrefs 를 한 함수 스코프로 합친 stable JSON."""
    f = _find_func(rev, target)
    if not f:
        return None
    name = f["name"]
    callers, callers_truncated = _capped(sorted({c["name"] for c in rev.get("functions", []) if name in c.get("calls", [])}))
    callees, callees_truncated = _capped(f.get("calls", []))
    strings, strings_truncated = _capped(f.get("strings", []))
    input_apis = sorted(set(f.get("calls", [])) & INPUT_FUNCS)
    call_sites = list(f.get("call_sites", []))
    compare_sites = []
    for site in call_sites:
        if site.get("api") not in CMP_FUNCS:
            continue
        length = site.get("length_argument") or {
            "status": "value_unresolved", "reason": "revmap lacks call-time length evidence; regenerate the revq cache"
        }
        compare_sites.append({
            "address": site.get("instruction_address"), "block_address": site.get("block_address"),
            "api": site.get("api"), "length": length.get("value") if length.get("status") == "constant" else None,
            "length_status": length.get("status"), "length_evidence": length.get("evidence"),
            "length_unresolved_reason": length.get("reason"),
            "address_space": site.get("address_space"), "analysis_source": site.get("analysis_source"),
        })
    func_strings = set(f.get("strings", []))
    oracle = compute_oracle(rev)
    oracle_candidates = []
    for kind, cands in (("success", oracle["success_candidates"]), ("failure", oracle["failure_candidates"])):
        for c in cands:
            if c["string"] not in func_strings:
                continue
            for xr in c["xrefs"]:
                if xr["func"] == name:
                    oracle_candidates.append({"kind": kind, "xref": xr["addr"], "string": c["string"]})
    interesting_hit = next((it for it in compute_interesting(rev) if it["func"] == name), None)
    unresolved = []
    missing_addresses = sum(1 for site in call_sites if site.get("instruction_address") is None)
    unresolved_targets = sum(1 for site in call_sites if site.get("target_kind") == "unresolved")
    if missing_addresses:
        unresolved.append({"kind": "call_instruction_address", "detail": "%d recovered call blocks lack a decoded call instruction address" % missing_addresses})
    if unresolved_targets:
        unresolved.append({"kind": "call_target", "detail": "%d call targets remain unresolved" % unresolved_targets})
    unresolved_lengths = [site for site in compare_sites
                          if site["length_status"] in {"value_unresolved", "unsupported_abi"}]
    if unresolved_lengths:
        unresolved.append({"kind": "compare_length", "detail": "%d comparison lengths remain unresolved" % len(unresolved_lengths)})
    if rev.get("engine") != "angr":
        unresolved.append({"kind": "engine_limited", "detail": "binutils engine: calls/xrefs may be incomplete"})
    if rev.get("function_scope"):
        unresolved.append({"kind": "function_scope", "detail":
                           "single function region only; callers, outside calls and global xrefs are incomplete"})
    if rev.get("load_spec"):
        unresolved.append({"kind": "operator_blob_map", "detail": "raw-code mapping is operator-supplied; runtime stage and load address are unverified"})
    if callers_truncated or callees_truncated or strings_truncated:
        unresolved.append({"kind": "truncated", "detail": "callers/callees/strings capped at %d" % _CAP})
    return {
        "schema": FUNCTION_CARD_SCHEMA,
        "function": {"name": name, "addr": f.get("addr", 0), "size": f.get("size", 0),
                     "nblocks": f.get("nblocks", 0), "ninstr": f.get("ninstr", 0)},
        "facts": {
            "callers": callers, "callees": callees, "strings": strings,
            "input_apis": input_apis, "call_sites": call_sites, "compare_sites": compare_sites,
            "oracle_candidates": oracle_candidates,
        },
        "heuristics": {
            "check_routine_score": interesting_hit["score"] if interesting_hit else 0,
            "reasons": interesting_hit["why"] if interesting_hit else [],
            "detector_version": INTERESTING_DETECTOR_VERSION,
        },
        "unresolved": unresolved,
        "next": ([] if rev.get("load_spec") else [{
            "query": "decomp", "target": "%s %#x" % (rev.get("bin", "?"), f.get("addr", 0))
        }]),
        "provenance": {"binary_sha256": rev.get("sha256"), "revmap_schema": rev.get("schema"),
                       "engine": rev.get("engine"), "scope": rev.get("function_scope")},
    }


def _find_func(rev, target):
    ti = parse_int(target)
    for f in rev["functions"]:
        if f["name"] == target or (ti is not None and f.get("addr") == ti):
            return f
    for f in rev["functions"]:
        if target.lower() in f["name"].lower():
            return f
    return None


def render_xrefs(rev, target):
    """target(함수명/주소/문자열)을 참조·호출하는 곳."""
    L = ["== XREFS → %s ==" % target]
    callers = [f["name"] for f in rev["functions"] if target in f.get("calls", [])]
    if callers:
        L.append("호출자(callers): " + ", ".join(sorted(set(callers))))
    for s in rev["strings"]:
        if target.lower() in s["val"].lower():
            xf = sorted({x["func"] for x in s.get("xrefs", [])})
            L.append("문자열 %s ← %s" % (_q(s["val"]), ", ".join(xf) or "-"))
    if len(L) == 1:
        L.append("(참조처 없음 — angr 엔진인지/이름 정확한지 확인)")
    return "\n".join(L)


# ─────────────────────────── 오케스트레이션 ───────────────────────────
def _canonical_index(binpath, want_engine, cur_sha, index_root=None, load_spec=None):
    """Best-effort registration in the canonical cache index."""
    try:
        from ratlib.cache import Cache, canonical_key, resolve_index_root
        idx_root = resolve_index_root(binpath, override=index_root)
        ck = canonical_key(
            binary_sha256="sha256:" + cur_sha,
            tool_name="revq",
            tool_version=str(SCHEMA),
            params={"engine": want_engine, "evasion_signal_schema": EVASION_SIGNAL_SCHEMA,
                    **({"load_spec": load_spec} if load_spec else {})},
            dep_versions={},
        )
        return Cache(idx_root), ck
    except Exception:
        return None, None


def _index_for_load(binpath, engine, digest, index_root, load_spec):
    """Preserve the existing four-argument canonical index contract."""
    if load_spec is None:
        return _canonical_index(binpath, engine, digest, index_root)
    return _canonical_index(binpath, engine, digest, index_root, load_spec=load_spec)


def _persist_invocation(binpath, cur_sha, want_engine, refresh, rev, cache_key,
                        index_root, started_at, t0, parameters):
    """Persist one successful revq invocation without changing sidecar/cache semantics."""
    try:
        from ratlib.artifact import put_bytes
        from ratlib.cache import resolve_index_root
        from ratlib.schema import validate

        finished_at = datetime.now(timezone.utc).isoformat()
        invocation_id = "invoke_" + uuid.uuid4().hex
        effective_engine = rev.get("engine") or want_engine
        counts = annotate_counts(rev).get("counts", {})
        doc = {
            "schema": "rat.tool-result/v1",
            "tool": {
                "name": "revq",
                "version": str(SCHEMA),
                "build_digest": "sha256:" + sha256(os.path.realpath(__file__)),
            },
            "run_id": invocation_id,
            "invocation_id": invocation_id,
            "status": ("partial" if rev.get("engine") == "angr" and rev.get("analysis_status") == "partial"
                       else "ok"),
            "started_at": started_at,
            "finished_at": finished_at,
            "duration_ms": max(0, int((time.monotonic() - t0) * 1000)),
            "inputs": [{"role": "binary", "digest": "sha256:" + cur_sha}],
            "parameters": parameters,
            "summary": {
                "engine": effective_engine,
                "functions_total": counts.get("functions_total", 0),
                "strings_total": len(rev.get("strings", [])),
                "imports_total": len(rev.get("imports", [])),
                "analysis_complete": bool(rev.get("analysis_complete", False)),
                "analysis_status": rev.get("analysis_status", "partial"),
            },
            "artifacts": [],
            "findings": [],
            "diagnostics": rev.get("analysis_diagnostics", []),
            "exit": {"code": 0, "signal": None, "timed_out": False, "cancelled": False},
            "provenance": {
                "platform": sys.platform,
                "dependency_versions": {"engine": str(effective_engine)},
                "policy_digest": REVQ_POLICY,
                "cache": {"state": rev.get("cache_state"), "key": cache_key},
            },
            "cache_state": rev.get("cache_state"),
            "extensions": {"subject_binding": {
                "role": "binary", "digest": "sha256:" + cur_sha,
            }},
        }
        validate(doc, "rat.tool-result/v1")
        root = resolve_index_root(binpath, override=index_root)
        put_bytes(
            json.dumps(doc, sort_keys=True, separators=(",", ":"), ensure_ascii=False).encode("utf-8"),
            kind="tool-result", media_type="application/json",
            logical_name="revq-%s.json" % invocation_id, root=root,
            provenance={"producer": "revq", "invocation_id": invocation_id},
        )
    except Exception:
        pass


def load_or_extract(binpath, want_engine, refresh, index_root=None, load_spec=None,
                    max_angr_bytes=None, allow_large=False, func_target=None,
                    func_size=None):
    wasm = is_wasm(binpath)
    if wasm:
        if load_spec:
            raise ValueError("explicit blob mapping cannot override a recognized Wasm module")
        want_engine = "wasm-structure"
    identity = inspect_kernel(binpath, include_symbols=True)
    kernel = identity["kind"] == "vmlinux"
    if load_spec and (kernel or identity["kind"] in {"bzimage", "linux-boot-image"}):
        raise ValueError("explicit blob mapping cannot override a recognized Linux kernel")
    if load_spec and want_engine == "binutils":
        raise ValueError("raw blob mapping requires the angr engine (do not use --fast)")
    if identity["kind"] in {"bzimage", "linux-boot-image"}:
        die("Linux 부트 이미지: scripts/extract-vmlinux로 ELF vmlinux를 먼저 추출하세요")
    # Kernel symbol recovery is metadata-only. Do not silently start CFGFast
    # over the whole kernel even when angr happens to be provisioned.
    if kernel:
        want_engine = "binutils"
    cp = cache_path(binpath)
    if load_spec:
        cp += ".blob-" + hashlib.sha256(json.dumps(load_spec, sort_keys=True).encode()).hexdigest()[:16]
    cur_sha = sha256(binpath)
    if not refresh and os.path.isfile(cp):
        try:
            with open(cp) as f:
                rev = json.load(f)
            if (rev.get("sha256") == cur_sha and rev.get("load_spec") == load_spec
                    and rev.get("schema") == SCHEMA
                    and _has_current_evasion_contract(rev)
                    and (not kernel or ((rev.get("artifact_identity") or {}).get("kind") == "vmlinux"
                                        and (rev.get("artifact_identity") or {}).get("schema") == KERNEL_IDENTITY_SCHEMA))
                    and (rev.get("engine") == want_engine or rev.get("engine") == "angr")):
                idx, ck = _index_for_load(binpath, rev.get("engine") or want_engine, cur_sha, index_root, load_spec)
                info("캐시 사용: %s (engine=%s)" % (cp, rev["engine"]))
                rev["cache_state"] = "hit"
                if idx and ck:
                    try:
                        existing = idx.get_entry(ck)
                        if not (existing and existing.get("path") == cp and existing.get("envelope_digest")):
                            idx.put_entry(ck, backend="revq_json", path=cp, envelope_digest="sha256:" + sha256(cp))
                    except Exception:
                        pass
                return annotate_counts(rev)
        except Exception:
            pass

    if kernel:
        functions = identity.pop("functions", [])
        for f in functions:
            f.update(nblocks=0,ninstr=0,count_quality="unavailable",calls=[],strings=[],ncallers=0)
        rev = {"schema": SCHEMA, "engine": "binutils", "platform": "elf",
               "arch": {62:"amd64",3:"i386",183:"aarch64"}.get(identity.get("machine"),"?"),
               "pie": False, "stripped": not bool(functions), "functions": functions,
               "strings": [], "imports": [], "analysis_complete": False,
               "functions_filtered": 0, "artifact_identity": identity,
               "evasion_signal_schema": EVASION_SIGNAL_SCHEMA,
               "evasion_signals": [], "evasion": []}
    else:
        if wasm:
            rev = extract_wasm(binpath)
        elif want_engine == "binutils":
            rev = extract_binutils(binpath)
        else:
            limit = (DEFAULT_MAX_ANGR_INPUT_MB * 1024 * 1024 if max_angr_bytes is None
                     else max_angr_bytes)
            explicit_large = allow_large or os.environ.get("RAT_ALLOW_LARGE") in {"1", "true", "yes"}
            if (func_target and not explicit_large and limit > 0
                    and os.path.getsize(binpath) > limit):
                return _load_or_extract_local(binpath, func_target, func_size,
                                              refresh, load_spec, allow_large)
            _angr_size_guard(binpath, max_angr_bytes, allow_large)
            try:
                enlarged_budget = (allow_large or max_angr_bytes == 0 or
                                   (max_angr_bytes is not None and
                                    max_angr_bytes > DEFAULT_MAX_ANGR_INPUT_MB * 1024 * 1024))
                rev = _extract_angr_bounded(binpath, load_spec, enlarged_budget)
            except AngrAnalysisError:
                raise
            except SystemExit:
                raise
            except Exception as exc:
                # e.g. angr's simprocedure prototype assertion on some libcs:
                # surface a typed failure instead of a raw traceback.
                detail = str(exc).strip() or "(메시지 없음)"
                raise AngrAnalysisError(
                    "angr 분석 실패(%s): %s — --fast(binutils) 또는 Ghidra로 우회하세요"
                    % (type(exc).__name__, detail)) from exc
    if load_spec:
        rev["load_spec"] = load_spec
    rev["bin"] = binpath
    rev["sha256"] = cur_sha
    rev["generated_at"] = now_iso()
    rev["cache_state"] = "miss"
    idx, ck = _index_for_load(binpath, rev.get("engine") or want_engine, cur_sha, index_root, load_spec)
    annotate_counts(rev)
    try:
        with open(cp, "w") as f:
            json.dump(rev, f)
        info("캐시 기록: %s" % cp)
    except Exception as e:
        info("캐시 기록 실패(무시): %s" % e)
    if idx and ck:
        try:
            idx.put_entry(ck, backend="revq_json", path=cp, envelope_digest="sha256:" + sha256(cp))
        except Exception:
            pass
    return rev


def _nonnegative_megabytes(value):
    try:
        megabytes = float(value)
    except ValueError as exc:
        raise argparse.ArgumentTypeError("상한은 0 이상의 유한한 MB 값이어야 합니다") from exc
    if not math.isfinite(megabytes) or megabytes < 0 or not math.isfinite(megabytes * 1024 * 1024):
        raise argparse.ArgumentTypeError("상한은 0 이상의 유한한 MB 값이어야 합니다")
    return megabytes


def _bounded_function_size(value):
    try:
        size = int(value, 0)
    except ValueError as exc:
        raise argparse.ArgumentTypeError("함수 범위는 1..65536 bytes여야 합니다") from exc
    if not 1 <= size <= 65536:
        raise argparse.ArgumentTypeError("함수 범위는 1..65536 bytes여야 합니다")
    return size


def build_parser():
    p = argparse.ArgumentParser(prog="revq", add_help=True,
                                description="rev 정적 배치 (함수/문자열/xref/interesting)")
    p.add_argument("binary", nargs="?", help="분석할 ELF (또는 'selftest')")
    p.add_argument("--fast", action="store_true", help="binutils 엔진(빠름, xref 없음)")
    p.add_argument("--refresh", action="store_true", help="캐시 무시 재추출")
    p.add_argument("--max-input-mb", type=_nonnegative_megabytes, default=None,
                   metavar="MB", help="angr 엔진 입력 크기 상한(기본 %dMB, 0=무제한)" % DEFAULT_MAX_ANGR_INPUT_MB)
    p.add_argument("--allow-large", action="store_true",
                   help="angr 입력 크기 가드 해제(별도 300초/4GiB 예산)")
    p.add_argument("--func-size", type=_bounded_function_size, metavar="BYTES",
                   help="주소 기반 --func의 명시적 분석 범위(최대 65536 bytes)")
    p.add_argument("--arch", help="explicit raw blob architecture: i386/amd64/arm/aarch64")
    p.add_argument("--base", help="explicit raw blob load base, e.g. 0x10000")
    p.add_argument("--entry", help="explicit raw blob entry, e.g. 0x10000")
    g = p.add_mutually_exclusive_group()
    g.add_argument("--funcs", action="store_true", help="함수 목록")
    g.add_argument("--strings", action="store_true", help="문자열 + 참조함수")
    g.add_argument("--imports", action="store_true", help="import 분류")
    g.add_argument("--interesting", action="store_true", help="check-루틴 후보만")
    g.add_argument("--oracle", action="store_true", help="success/failure 문자열→symsolve 좌표 자동연결(JSON)")
    g.add_argument("--func", metavar="NAME", help="한 함수 컨텍스트 카드")
    g.add_argument("--xrefs", metavar="TARGET", help="심볼/문자열 참조처")
    p.add_argument("--format", choices=("text", "json"), default="text",
                   help="출력 형식 (기본 text; --funcs와 함께면 함수 뷰를 직렬화)")
    p.add_argument("--json", dest="format", action="store_const", const="json",
                   help="deprecated alias for --format json")
    p.add_argument("-n", "--limit", type=int, default=40, help="목록 상한(기본 40)")
    p.add_argument("--sort", choices=["size", "xrefs", "name"], default="size")
    p.add_argument("--grep", metavar="RE", help="--strings 필터 정규식")
    p.add_argument("--selftest", action="store_true", help=argparse.SUPPRESS)
    return p


def main(argv):
    if argv and argv[0] == "selftest":
        return selftest()
    args = build_parser().parse_args(argv)
    if args.selftest:
        return selftest()
    if not args.binary:
        build_parser().print_help()
        return 2
    if not os.path.isfile(args.binary):
        die("파일 없음: %s" % args.binary)

    started_at = datetime.now(timezone.utc).isoformat()
    t0 = time.monotonic()
    from ratlib.raw_loader import load_spec as normalize_blob
    try:
        blob_spec = normalize_blob(args.binary, arch=args.arch, base=args.base, entry=args.entry)
    except ValueError as exc:
        build_parser().error(str(exc))
    if blob_spec and args.fast:
        build_parser().error("--fast cannot analyze an explicit raw blob mapping")
    if args.func_size is not None and not args.func:
        build_parser().error("--func-size requires --func")
    requested_engine = "binutils" if args.fast else "angr"
    max_angr_bytes = None
    if args.max_input_mb is not None:
        max_angr_bytes = (max(1, int(args.max_input_mb * 1024 * 1024))
                          if args.max_input_mb else 0)
    try:
        rev = load_or_extract(args.binary, requested_engine, args.refresh, load_spec=blob_spec,
                              max_angr_bytes=max_angr_bytes, allow_large=args.allow_large,
                              func_target=args.func, func_size=args.func_size)
    except AngrAnalysisError as exc:
        if exc.kind in {"timeout", "resource_limit"}:
            print("RAT_STATUS=%s RAT_EXIT=%s" %
                  (exc.kind, 124 if exc.kind == "timeout" else 70), file=sys.stderr)
        elif exc.kind == "size_limit":
            print("RAT_STATUS=partial RAT_EXIT=1", file=sys.stderr)
        die(str(exc), 124 if exc.kind == "timeout" else 70 if exc.kind == "resource_limit" else 1)
    operation = "summary"
    requested = None

    if args.funcs:
        operation = "funcs"
        if args.format == "json":
            print(json.dumps(funcs_json(rev, args.sort, args.limit), indent=2, ensure_ascii=False))
        else:
            print(render_funcs(rev, args.sort, args.limit))
    elif args.func:
        operation = "func"
        requested = args.func
        card = compute_function_card(rev, args.func)
        if card is None:
            print("[!] 함수 '%s' 없음. 목록: revq <bin> --funcs" % args.func)
            return 1
        print(json.dumps(card, ensure_ascii=False, separators=(",", ":")))
    elif args.format == "json":
        operation = "json"
        print(json.dumps(rev, indent=2, ensure_ascii=False))
    elif args.strings:
        operation = "strings"
        print(render_strings(rev, args.grep, args.limit))
    elif args.imports:
        operation = "imports"
        print(render_imports(rev))
    elif args.interesting:
        operation = "interesting"
        inter = compute_interesting(rev)
        if not inter:
            print("(interesting 후보 없음 — VM/난독화 가능성. --strings 확인)")
        for it in inter[:args.limit]:
            print("[%d] %s @%#x (size %d)" % (it["score"], it["func"], it["addr"], it["size"]))
            for w in it["why"]:
                print("     - " + w)
    elif args.oracle:
        operation = "oracle"
        print(json.dumps(compute_oracle(rev), ensure_ascii=False, separators=(",", ":")))
    elif args.xrefs:
        operation = "xrefs"
        requested = args.xrefs
        print(render_xrefs(rev, args.xrefs))
    else:
        print(render_summary(rev))

    _, cache_key = _canonical_index(args.binary, rev.get("engine") or requested_engine,
                                    rev.get("sha256") or sha256(args.binary), load_spec=blob_spec)
    parameters = {
        "requested_engine": requested_engine,
        "effective_engine": rev.get("engine") or requested_engine,
        "refresh": bool(args.refresh),
        "operation": operation,
        "requested": requested,
        "limit": args.limit,
        "sort": args.sort,
        "grep": args.grep,
        "load_spec": blob_spec,
    }
    _persist_invocation(args.binary, rev.get("sha256") or sha256(args.binary),
                        requested_engine, args.refresh, rev, cache_key, None,
                        started_at, t0, parameters)
    return 0


# ─────────────────────────── selftest (순수 로직, 바이너리/네트워크 무관) ───────────────────────────
def _fixture():
    """합성 revmap: crackme 형태(check 함수가 memcmp + 'Correct!' 참조)."""
    return {
        "schema": SCHEMA, "engine": "angr", "arch": "AMD64", "pie": True,
        "stripped": True, "bin": "/fix/crackme",
        "imports": ["memcmp", "printf", "__isoc99_scanf", "puts", "strlen", "malloc"],
        "strings": [
            {"addr": 0x2008, "val": "Correct! The flag is here", "sec": ".rodata",
             "xrefs": [{"func": "check", "addr": 0x11a0}]},
            {"addr": 0x2028, "val": "Wrong password, try again", "sec": ".rodata",
             "xrefs": [{"func": "check", "addr": 0x11b0}]},
            {"addr": 0x2048, "val": "Enter license: ", "sec": ".rodata",
             "xrefs": [{"func": "main", "addr": 0x1250}]},
            {"addr": 0x2060, "val": "%31s", "sec": ".rodata",
             "xrefs": [{"func": "main", "addr": 0x1260}]},
        ],
        "functions": [
            {"name": "main", "addr": 0x1230, "size": 120, "nblocks": 5, "ninstr": 30,
             "count_quality": "cfg",
             "calls": ["__isoc99_scanf", "check", "printf"],
             "strings": ["Enter license: ", "%31s"], "ncallers": 1},
            {"name": "check", "addr": 0x1180, "size": 90, "nblocks": 4, "ninstr": 24,
             "count_quality": "cfg",
             "calls": ["memcmp", "strlen"],
             "call_sites": [
                 {"block_address": 0x1190, "instruction_address": 0x119b,
                  "target_address": 0x1040, "api": "memcmp", "target_kind": "resolved",
                  "analysis_source": "angr.CFGFast", "address_space": "loader-virtual-address",
                  "length_argument": {"status": "constant", "value": 16,
                                      "evidence": {"instruction_address": 0x1195, "register": "edx",
                                                   "instruction": "mov edx, 0x10",
                                                   "analysis_source": "capstone-basic-block"}}},
                 {"block_address": 0x11a0, "instruction_address": 0x11a8,
                  "target_address": 0x1050, "api": "strlen", "target_kind": "resolved",
                  "analysis_source": "angr.CFGFast", "address_space": "loader-virtual-address"},
             ],
             "strings": ["Correct! The flag is here", "Wrong password, try again"],
             "ncallers": 1},
            {"name": "helper_noise", "addr": 0x1300, "size": 40, "nblocks": 2, "ninstr": 12,
             "count_quality": "cfg",
             "calls": ["malloc"], "strings": [], "ncallers": 3},
        ],
    }


def selftest():
    fails = []

    def chk(cond, name):
        (print("  ✅ " + name) if cond else fails.append(name) or print("  ❌ " + name))

    print("== revq selftest (순수 로직) ==")

    rev = _fixture()
    annotate_counts(rev)
    chk(rev["counts"]["functions_total"] == 3, "function total count is canonical")
    alias_rev = dict(rev)
    alias_rev["functions"] = list(rev["functions"]) + [dict(rev["functions"][0], name="main_alias")]
    annotate_counts(alias_rev)
    chk(alias_rev["counts"]["functions_total"] == 3 and alias_rev["counts"]["aliases"],
        "function aliases preserved without inflating total")
    chk("truncated=2" in render_funcs(rev, limit=1), "visible/truncated count")
    chk(all("nblocks" in f and "ninstr" in f and f["ninstr"] >= f["nblocks"]
            for f in rev["functions"]), "revmap schema separates instruction and block counts")
    chk("5 blocks, 30 instr" in render_func(rev, "main"), "function card labels block/instruction counts")
    inter = compute_interesting(rev)
    top = inter[0] if inter else {}
    chk(top.get("func") == "check", "interesting top = check (memcmp+Correct 참조)")
    chk(top.get("score", 0) >= 5, "check 점수 >= 5 (판별문자열+비교함수)")
    chk(all(i["func"] != "helper_noise" for i in inter), "noise 함수 제외")

    check_card = compute_function_card(rev, "check")
    chk(check_card["schema"] == "rat.function-card/v4", "function-card: schema")
    chk(set(check_card) == {"schema", "function", "facts", "heuristics", "unresolved", "next", "provenance"},
        "function-card: top-level facts/heuristics/unresolved 분리")
    chk(check_card["facts"]["callers"] == ["main"] and check_card["facts"]["callees"] == ["memcmp", "strlen"],
        "function-card: callers/callees 사실")
    chk({c["kind"] for c in check_card["facts"]["oracle_candidates"]} == {"success", "failure"} and
        all(c["xref"] in (0x11a0, 0x11b0) for c in check_card["facts"]["oracle_candidates"]),
        "function-card: oracle_candidates 이 함수 스코프로 정확")
    chk(check_card["facts"]["compare_sites"] == [
        {"address": 0x119b, "block_address": 0x1190, "api": "memcmp", "length": 16,
         "length_status": "constant",
         "length_evidence": {"instruction_address": 0x1195, "register": "edx",
                             "instruction": "mov edx, 0x10", "analysis_source": "capstone-basic-block"},
         "length_unresolved_reason": None,
         "address_space": "loader-virtual-address", "analysis_source": "angr.CFGFast"}],
        "function-card: call 주소와 근거가 확인된 비교 길이를 함께 보존")
    chk(not any(u["kind"] == "compare_length" for u in check_card["unresolved"]),
        "function-card: 확인된 상수 길이를 unresolved 로 남기지 않음")
    chk(check_card["heuristics"]["check_routine_score"] == top.get("score", 0) and check_card["heuristics"]["reasons"],
        "function-card: heuristics 는 점수+근거(단정 아님)")
    main_card = compute_function_card(rev, "main")
    chk(main_card["facts"]["oracle_candidates"] == [] and main_card["facts"]["compare_sites"] == [],
        "function-card: false-positive 회피 — main 은 check 의 oracle/compare 사실을 물려받지 않음")
    chk(len(json.dumps(check_card, ensure_ascii=False)) // 4 < 1500, "function-card: <1.5K 토큰 추정치")
    chk(compute_function_card(rev, "does-not-exist") is None, "function-card: 없는 함수는 None")

    chk(list(_iter_cstrings(b"ab\x00hello\x00\x01\x02worldd", 4)) ==
        [(3, "hello"), (11, "worldd")], "_iter_cstrings offset/필터")
    chk(parse_int("0x1180") == 0x1180 and parse_int("4660") == 4660
        and parse_int("nope") is None, "parse_int hex/dec/invalid")

    s = render_summary(rev)
    chk("check" in s and "INTERESTING" in s, "render_summary: check 지목")
    chk("Correct" in s, "render_summary: 판별문자열 하이라이트")
    chk("check" in render_funcs(rev) and "main" in render_funcs(rev), "render_funcs")
    chk("Correct" in render_strings(rev, grep="correct"), "render_strings grep")
    fc = render_func(rev, "check")
    chk("memcmp" in fc and "decomp" in fc, "render_func: calls + decomp 안내")
    chk("Correct" in render_xrefs(rev, "Correct"), "render_xrefs: 문자열 참조처")
    chk("main" in render_xrefs(rev, "check"), "render_xrefs: 호출자(main→check)")
    chk("memcmp" in render_imports(rev), "render_imports: 분류")

    chk("__isoc99_scanf" in INPUT_FUNCS and "memcmp" in CMP_FUNCS, "사전 상수")

    typed = classify_evasion_signals(["ptrace", "memcmp"], ["please no TracerPid here"], 7.6, ["UPX0", ".text"])
    ev = _render_legacy_evasion(typed)
    chk(any(s.get("kind") == "packer-section" and s.get("quality") == "fact" for s in typed),
        "evasion: typed packer-section fact")
    chk(any(s.get("kind") == "high-entropy" and s.get("quality") == "heuristic" for s in typed),
        "evasion: typed high-entropy heuristic")
    chk(any("ptrace" in x for x in ev), "evasion: ptrace import 탐지")
    chk(any("TracerPid" in x or "tracerpid" in x for x in ev), "evasion: anti-debug 문자열 탐지")
    chk(any("고엔트로피" in x for x in ev), "evasion: 고엔트로피 탐지")
    chk(any("UPX" in x for x in ev), "evasion: 패커 섹션 탐지")
    chk(classify_evasion(["memcmp"], ["hello world"], 5.0, [".text", ".data"]) == [],
        "evasion: 정상 바이너리 무신호")
    chk(_entropy(b"\x00\x00\x00\x00") == 0.0 and _entropy(bytes(range(256))) > 7.9, "_entropy 계산")
    chk(not _has_current_evasion_contract({"schema": SCHEMA, "evasion": ["패커 섹션 UPX0"]}),
        "evasion: legacy sidecar contract rejected")
    chk(_has_current_evasion_contract({"evasion_signal_schema": EVASION_SIGNAL_SCHEMA, "evasion_signals": []}),
        "evasion: current typed sidecar contract accepted")

    chk(_detect_platform("a.exe: PE32+ executable (console) x86-64, for MS Windows") == "pe", "platform: PE 감지")
    chk(_detect_platform("chall: ELF 64-bit LSB pie executable, x86-64") == "elf", "platform: ELF 감지")
    chk("PE/Windows" in render_summary({**_fixture(), "platform": "pe"}), "render_summary: PE 배너")
    chk("PLATFORM" not in render_summary({**_fixture(), "platform": "elf"}), "render_summary: ELF 은 배너 없음")

    oracle = compute_oracle(rev)
    chk(oracle["auto_connect"] is True, "oracle: 단일·명확 success/fail → auto_connect")
    chk(oracle["resolved"]["success"]["addr"] == 0x11a0 and oracle["resolved"]["failure"]["addr"] == 0x11b0,
        "oracle: xref BB 주소 정확 (angr 로드베이스와 일치, symsolve 그대로 투입 가능)")
    chk(not ORACLE_SUCCESS_STR.search("invalid") and bool(ORACLE_FAILURE_STR.search("invalid")),
        "oracle: 'invalid' 는 실패 후보만 매칭 (valid 부분 문자열 오매칭 방지)")
    s = render_summary(rev)
    chk("ORACLE  success@0x11a0" in s and "fail@0x11b0" in s, "render_summary: ORACLE 라인")
    chk("SUGGEST symsolve.py" in s and "--find 0x11a0" in s and "--avoid 0x11b0" in s,
        "render_summary: 복붙 가능한 symsolve SUGGEST 커맨드")
    ambiguous_rev = {**_fixture(), "strings": rev["strings"] + [
        {"addr": 0x2080, "val": "Access granted, welcome", "sec": ".rodata",
         "xrefs": [{"func": "check2", "addr": 0x1400}]},
    ]}
    amb = compute_oracle(ambiguous_rev)
    chk(amb["ambiguous"] is True and amb["auto_connect"] is False,
        "oracle: success 후보 2개 → ambiguous, 자동연결 안 함")
    chk("ORACLE  ambiguous" in render_summary(ambiguous_rev) and "SUGGEST" not in render_summary(ambiguous_rev),
        "render_summary: ambiguous 시 SUGGEST 커맨드 미생성")

    print("-" * 40)
    if fails:
        print("FAIL %d: %s" % (len(fails), ", ".join(fails)))
        return 1
    print("ALL GREEN ✅")
    return 0


if __name__ == "__main__":
    if (sys.argv[1:2] != ["selftest"] and "--selftest" not in sys.argv[1:]
            and "--fast" not in sys.argv[1:] and "--help" not in sys.argv[1:]
            and "-h" not in sys.argv[1:]):
        reexec_for_angr(__file__, sys.argv[1:])
    sys.exit(main(sys.argv[1:]))
