def selftest():
    fails = []

    def chk(cond, name):
        (print("  ✅ " + name) if cond else fails.append(name) or print("  ❌ " + name))

    print("== revq selftest (순수 로직) ==")

    rev = _fixture()
    annotate_counts(rev)
    chk(rev["counts"]["functions_total"] == 3, "function total count is canonical")
    alias_rev = dict(rev)
    alias_rev["functions"] = list(rev["functions"]) + [dict(rev["functions"][0], name="main_alias")]
    annotate_counts(alias_rev)
    chk(alias_rev["counts"]["functions_total"] == 3 and alias_rev["counts"]["aliases"],
        "function aliases preserved without inflating total")
    chk("truncated=2" in render_funcs(rev, limit=1), "visible/truncated count")
    chk(all("nblocks" in f and "ninstr" in f and f["ninstr"] >= f["nblocks"]
            for f in rev["functions"]), "schema v2 separates instruction and block counts")
    chk("5 blocks, 30 instr" in render_func(rev, "main"), "function card labels block/instruction counts")
    inter = compute_interesting(rev)
    top = inter[0] if inter else {}
    chk(top.get("func") == "check", "interesting top = check (memcmp+Correct 참조)")
    chk(top.get("score", 0) >= 5, "check 점수 >= 5 (판별문자열+비교함수)")
    chk(all(i["func"] != "helper_noise" for i in inter), "noise 함수 제외")

    # Function Card v2
    check_card = compute_function_card(rev, "check")
    chk(check_card["schema"] == "rat.function-card/v2", "function-card: schema")
    chk(set(check_card) == {"schema", "function", "facts", "heuristics", "unresolved", "next", "provenance"},
        "function-card: top-level facts/heuristics/unresolved 분리")
    chk(check_card["facts"]["callers"] == ["main"] and check_card["facts"]["callees"] == ["memcmp", "strlen"],
        "function-card: callers/callees 사실")
    chk({c["kind"] for c in check_card["facts"]["oracle_candidates"]} == {"success", "failure"} and
        all(c["xref"] in (0x11a0, 0x11b0) for c in check_card["facts"]["oracle_candidates"]),
        "function-card: oracle_candidates 이 함수 스코프로 정확")
    chk(check_card["facts"]["compare_sites"] == [{"address": None, "api": "memcmp", "length": None}],
        "function-card: compare_sites 는 사실(api)만, 없는 정보(address)는 조작 안 함")
    chk(any(u["kind"] == "compare_site_address" for u in check_card["unresolved"]),
        "function-card: 콜사이트 주소 미해결을 unresolved 에 명시(숨기지 않음)")
    chk(check_card["heuristics"]["check_routine_score"] == top.get("score", 0) and check_card["heuristics"]["reasons"],
        "function-card: heuristics 는 점수+근거(단정 아님)")
    main_card = compute_function_card(rev, "main")
    chk(main_card["facts"]["oracle_candidates"] == [] and main_card["facts"]["compare_sites"] == [],
        "function-card: false-positive 회피 — main 은 check 의 oracle/compare 사실을 물려받지 않음")
    chk(len(json.dumps(check_card, ensure_ascii=False)) // 4 < 1500, "function-card: <1.5K 토큰 추정치")
    chk(compute_function_card(rev, "does-not-exist") is None, "function-card: 없는 함수는 None")

    # 문자열 유틸
    chk(list(_iter_cstrings(b"ab\x00hello\x00\x01\x02worldd", 4)) ==
        [(3, "hello"), (11, "worldd")], "_iter_cstrings offset/필터")
    chk(parse_int("0x1180") == 0x1180 and parse_int("4660") == 4660
        and parse_int("nope") is None, "parse_int hex/dec/invalid")

    # 렌더러 (예외 없이 + 핵심 토큰 포함)
    s = render_summary(rev)
    chk("check" in s and "INTERESTING" in s, "render_summary: check 지목")
    chk("Correct" in s, "render_summary: 판별문자열 하이라이트")
    chk("check" in render_funcs(rev) and "main" in render_funcs(rev), "render_funcs")
    chk("Correct" in render_strings(rev, grep="correct"), "render_strings grep")
    fc = render_func(rev, "check")
    chk("memcmp" in fc and "decomp" in fc, "render_func: calls + decomp 안내")
    chk("Correct" in render_xrefs(rev, "Correct"), "render_xrefs: 문자열 참조처")
    chk("main" in render_xrefs(rev, "check"), "render_xrefs: 호출자(main→check)")
    chk("memcmp" in render_imports(rev), "render_imports: 분류")

    # 캐시 유효성 판정 로직 (angr 캐시는 --fast 요청에도 유효)
    chk("__isoc99_scanf" in INPUT_FUNCS and "memcmp" in CMP_FUNCS, "사전 상수")

    # evasion 분류 (Gap A: 정적 신뢰 하향 신호)
    ev = classify_evasion(["ptrace", "memcmp"], ["please no TracerPid here"], 7.6, ["UPX0", ".text"])
    chk(any("ptrace" in x for x in ev), "evasion: ptrace import 탐지")
    chk(any("TracerPid" in x or "tracerpid" in x for x in ev), "evasion: anti-debug 문자열 탐지")
    chk(any("고엔트로피" in x for x in ev), "evasion: 고엔트로피 탐지")
    chk(any("UPX" in x for x in ev), "evasion: 패커 섹션 탐지")
    chk(classify_evasion(["memcmp"], ["hello world"], 5.0, [".text", ".data"]) == [],
        "evasion: 정상 바이너리 무신호")
    chk(_entropy(b"\x00\x00\x00\x00") == 0.0 and _entropy(bytes(range(256))) > 7.9, "_entropy 계산")

    # platform 감지 (PE/ELF 라우팅)
    chk(_detect_platform("a.exe: PE32+ executable (console) x86-64, for MS Windows") == "pe", "platform: PE 감지")
    chk(_detect_platform("chall: ELF 64-bit LSB pie executable, x86-64") == "elf", "platform: ELF 감지")
    chk("PE/Windows" in render_summary({**_fixture(), "platform": "pe"}), "render_summary: PE 배너")
    chk("PLATFORM" not in render_summary({**_fixture(), "platform": "elf"}), "render_summary: ELF 은 배너 없음")

    # oracle→symsolve 자동연결
    oracle = compute_oracle(rev)
    chk(oracle["auto_connect"] is True, "oracle: 단일·명확 success/fail → auto_connect")
    chk(oracle["resolved"]["success"]["addr"] == 0x11a0 and oracle["resolved"]["failure"]["addr"] == 0x11b0,
        "oracle: xref BB 주소 정확 (angr 로드베이스와 일치, symsolve 그대로 투입 가능)")
    chk(not ORACLE_SUCCESS_STR.search("invalid") and bool(ORACLE_FAILURE_STR.search("invalid")),
        "oracle: 'invalid' 는 실패 후보만 매칭 (valid 부분 문자열 오매칭 방지)")
    s = render_summary(rev)
    chk("ORACLE  success@0x11a0" in s and "fail@0x11b0" in s, "render_summary: ORACLE 라인")
    chk("SUGGEST symsolve.py" in s and "--find 0x11a0" in s and "--avoid 0x11b0" in s,
        "render_summary: 복붙 가능한 symsolve SUGGEST 커맨드")
    ambiguous_rev = {**_fixture(), "strings": rev["strings"] + [
        {"addr": 0x2080, "val": "Access granted, welcome", "sec": ".rodata",
         "xrefs": [{"func": "check2", "addr": 0x1400}]},
    ]}
    amb = compute_oracle(ambiguous_rev)
    chk(amb["ambiguous"] is True and amb["auto_connect"] is False,
        "oracle: success 후보 2개 → ambiguous, 자동연결 안 함")
    chk("ORACLE  ambiguous" in render_summary(ambiguous_rev) and "SUGGEST" not in render_summary(ambiguous_rev),
        "render_summary: ambiguous 시 SUGGEST 커맨드 미생성")

    print("-" * 40)
    if fails:
        print("FAIL %d: %s" % (len(fails), ", ".join(fails)))
        return 1
    print("ALL GREEN ✅")
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
