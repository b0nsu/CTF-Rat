#!/usr/bin/env python3
import argparse, json, sys
from pathlib import Path
sys.path.insert(0, str(Path(__file__).resolve().parent))
from ratlib import benchmark as b
ROOT=Path(__file__).resolve().parents[1]
def main():
 p=argparse.ArgumentParser(description="local-only CTF-Rat P4 benchmark tooling"); sub=p.add_subparsers(dest="cmd",required=True)
 q=sub.add_parser("validate-corpus"); q.add_argument("--version",default="v1"); q.add_argument("--root")
 q=sub.add_parser("run"); q.add_argument("--ablation",required=True,choices=["A0","A1","A2","A3","A4","A5"]); q.add_argument("--seed",required=True,type=int); q.add_argument("--cache",required=True,choices=["cold","warm"]); q.add_argument("--subset",default="all"); q.add_argument("--corpus"); q.add_argument("--fixture-smoke",action="store_true",help="execute only local synthetic fixture/oracle pairs"); q.add_argument("--runner",help="untrusted command template with {challenge}, {ablation}, {seed}, {cache}; must emit one JSON object")
 q=sub.add_parser("collect"); q.add_argument("results",nargs="+"); q.add_argument("--baseline",required=True); q.add_argument("--reference",help="A0 metrics JSON required for PDF relative targets"); q.add_argument("--output")
 q=sub.add_parser("compare"); q.add_argument("--candidate",required=True); q.add_argument("--baseline",required=True)
 q=sub.add_parser("nightly"); q.add_argument("--lock",required=True); q.add_argument("--candidate"); q.add_argument("--baseline",help="approved A3 production baseline for paired regression"); q.add_argument("--reference",help="A0 metrics required for PDF relative targets"); q.add_argument("--dry-run",action="store_true")
 q=sub.add_parser("review-status"); q.add_argument("--transcript",required=True); q.add_argument("--thresholds",required=True)
 q=sub.add_parser("release-plan")
 a=p.parse_args()
 try:
  if a.cmd=="validate-corpus": out=b.validate_corpus(a.root or ROOT/"benchmarks/corpus"/a.version)
  elif a.cmd=="review-status": out={"approved":True,"transcript":b.validate_transcript(b.load(a.transcript),b.load(a.thresholds))}
  elif a.cmd=="release-plan": out=b.release_plan()
  elif a.cmd=="run":
   if a.fixture_smoke and a.runner: raise b.BenchmarkError("choose fixture-smoke or runner, not both")
   corpus_root=Path(a.corpus or ROOT/"benchmarks/corpus/v1"); report=b.validate_corpus(corpus_root); doc=b.new_run(report,a.ablation,a.seed,a.cache); path=ROOT/".rat-bench"/doc["benchmark_run_id"]; path.mkdir(parents=True); b.dump(path/"run.json",doc)
   rows=[]
   if a.fixture_smoke or a.runner:
    if a.runner: b.require_production_corpus(corpus_root)
    choices=b.corpus(corpus_root)
    if a.subset=="smoke":
     seen=set(); choices=[x for x in choices if not (x["category"] in seen or seen.add(x["category"]))]
    elif a.subset!="all": raise b.BenchmarkError("subset must be all or smoke")
    rows=[b.fixture_result(doc,x,corpus_root) for x in choices] if a.fixture_smoke else [b.runner_result(doc,x,corpus_root,a.runner) for x in choices]
   events=[{"schema":"rat.benchmark-event/v1","event":"run.started","at":doc["created_at"],"benchmark_run_id":doc["benchmark_run_id"]}]+[{"schema":"rat.benchmark-event/v1","event":"challenge.finished","challenge_id":x["challenge_id"],"at":x["finished_at"],"outcome":x["outcome"]} for x in rows]
   (path/"events.jsonl").write_text("".join(json.dumps(x,sort_keys=True)+"\n" for x in events)); (path/"challenge-results.jsonl").write_text("".join(json.dumps(x,sort_keys=True)+"\n" for x in rows)); print(json.dumps({"run_dir":str(path),"result_count":len(rows),"warning":None if rows else "no architecture runner configured; no solver results created"})); return
  elif a.cmd=="collect":
   metrics=b.collect(b.read_results(a.results)); reference=b.load(a.reference) if a.reference else None; gate=b.threshold_gate(metrics,b.load(a.baseline),reference); out={"metrics":metrics,"threshold_gate":gate};
   if a.output: b.dump(a.output,out)
  elif a.cmd=="compare": out=b.compare(b.load(a.candidate),b.load(a.baseline))
  else:
   lock=b.load(a.lock)
   b.validate_lock(lock,allow_template=a.dry_run)
   transcript_path=lock.get("transcript")
   if not a.dry_run:
    if not transcript_path: raise b.BenchmarkError("baseline lock lacks review transcript")
    b.validate_transcript(b.load(transcript_path),b.load(lock["thresholds"]))
   if not a.candidate or not a.baseline or not a.reference: out={"status":"dry-run" if a.dry_run else "blocked","reason":"candidate A3, paired A3 baseline, and A0 PDF reference metrics are required; nightly never promotes a result"}
   else:
    cand=b.validate_release_metrics(b.load(a.candidate)); base=b.validate_release_metrics(b.load(a.baseline)); reference=b.load(a.reference); out={"threshold_gate":b.threshold_gate(cand,b.load(lock["thresholds"]),reference),"comparison":b.compare(cand,base)}; out["status"]="pass" if out["threshold_gate"]["passed"] and out["comparison"]["passed"] and out["comparison"]["comparable"] else "fail"
  print(json.dumps(out,sort_keys=True))
 except b.BenchmarkError as e: print("[rat-bench:policy] "+str(e),file=sys.stderr); return 5
 return 0
if __name__=="__main__": raise SystemExit(main())
