#!/usr/bin/env python3
# spelling shim: `vmlift ...` == `python3 solve/_template/rev/vmlift.py ...`.
# See bin/symsolve for the rationale (bare name on PATH, pure exec passthrough).
import os, sys
CTF_HOME = os.environ.get("CTF_HOME", os.path.abspath(os.path.join(os.path.dirname(os.path.realpath(__file__)), "..")))
target = os.path.join(CTF_HOME, "solve", "_template", "rev", "vmlift.py")
os.execv(sys.executable, [sys.executable, target, *sys.argv[1:]])
