#!/usr/bin/env python3
import argparse, json, os, sys
sys.path.insert(0, os.path.dirname(__file__))
from ratlib.orchestration import GateError, context_bundle
p=argparse.ArgumentParser(); p.add_argument("--root",default=os.getcwd()); p.add_argument("--checkpoint",required=True); p.add_argument("--phase",required=True); p.add_argument("--budget",type=int,required=True); a=p.parse_args()
try: print(json.dumps(context_bundle(a.root,a.checkpoint,a.phase,a.budget)))
except GateError as e: print("[rat-context:policy] "+str(e),file=sys.stderr); raise SystemExit(5)
