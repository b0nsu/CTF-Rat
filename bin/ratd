#!/usr/bin/env python3
"""ratd — loopback-only control/observation plane for CTF-Rat Desktop.

HTTP clients cannot choose commands. A single solver argv is configured by the
operator at daemon startup. Desktop-triggered analysis is restricted to
manifest-selected targets and canonical bounded ``rat`` invocations.
"""
from __future__ import annotations
import argparse, json, os, shlex, signal, sys
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
from urllib.parse import parse_qs, unquote, urlparse

BIN = os.path.dirname(os.path.realpath(__file__))
sys.path.insert(0, BIN)

from ratlib.desktop_analysis import AnalysisManager
from ratlib.desktop_api import artifact_preview, completion, event_delta, list_artifacts, live_update, snapshot, telemetry
from ratlib.desktop_session import SessionManager

MAX_BODY = 16 * 1024
ALLOWED_ORIGINS = {
    "http://127.0.0.1:1420", "http://localhost:1420",
    "tauri://localhost", "http://tauri.localhost", "https://tauri.localhost",
}


def _json_bytes(doc):
    return (json.dumps(doc, sort_keys=True, ensure_ascii=False) + "\n").encode("utf-8")


def _handler(challenge_root, sessions, analyses=None):
    analyses = analyses or AnalysisManager(challenge_root)

    class Handler(BaseHTTPRequestHandler):
        server_version = "ratd/0.3"

        def log_message(self, fmt, *args):
            sys.stderr.write("ratd: " + (fmt % args) + "\n")

        def _origin_ok(self):
            origin = self.headers.get("Origin")
            return origin is None or origin in ALLOWED_ORIGINS

        def _send(self, status, doc):
            body = b"" if status == 204 else _json_bytes(doc)
            self.send_response(status)
            if body:
                self.send_header("Content-Type", "application/json; charset=utf-8")
                self.send_header("Content-Length", str(len(body)))
            self.send_header("Cache-Control", "no-store")
            origin = self.headers.get("Origin")
            if origin in ALLOWED_ORIGINS:
                self.send_header("Access-Control-Allow-Origin", origin)
                self.send_header("Vary", "Origin")
            self.send_header("Access-Control-Allow-Methods", "GET, POST, OPTIONS")
            self.send_header("Access-Control-Allow-Headers", "Content-Type, X-CTF-Rat-Desktop")
            self.end_headers()
            if body:
                self.wfile.write(body)

        def _body(self):
            try:
                length = int(self.headers.get("Content-Length", "0"))
            except ValueError as exc:
                raise ValueError("invalid Content-Length") from exc
            if length < 0 or length > MAX_BODY:
                raise ValueError("request body too large")
            raw = self.rfile.read(length) if length else b"{}"
            try:
                doc = json.loads(raw.decode("utf-8"))
            except (UnicodeDecodeError, json.JSONDecodeError) as exc:
                raise ValueError("request body must be JSON") from exc
            if not isinstance(doc, dict):
                raise ValueError("request body must be an object")
            return doc

        def do_OPTIONS(self):
            if not self._origin_ok():
                return self._send(403, {"schema": "rat.desktop.error/v1", "error": "origin_forbidden"})
            return self._send(204, {})

        def do_GET(self):
            if not self._origin_ok():
                return self._send(403, {"schema": "rat.desktop.error/v1", "error": "origin_forbidden"})
            parsed = urlparse(self.path)
            try:
                query = parse_qs(parsed.query)
                if parsed.path == "/api/health":
                    return self._send(200, {"schema": "rat.desktop.health/v1", "status": "ok", "challenge_root": challenge_root, "session": sessions.status()})
                if parsed.path == "/api/analysis/status":
                    return self._send(200, analyses.status())
                if parsed.path == "/api/snapshot":
                    until = query.get("until_seq", [None])[0]
                    return self._send(200, snapshot(challenge_root, until_seq=None if until is None else int(until)))
                if parsed.path == "/api/live":
                    return self._send(200, live_update(
                        challenge_root,
                        after_seq=int(query.get("after_seq", ["0"])[0]),
                        limit=int(query.get("limit", ["500"])[0]),
                        stream_id=query.get("stream_id", [None])[0],
                        known_generation=query.get("known_generation", [None])[0],
                    ))
                if parsed.path == "/api/events":
                    return self._send(200, event_delta(
                        challenge_root,
                        after_seq=int(query.get("after_seq", ["0"])[0]),
                        limit=int(query.get("limit", ["500"])[0]),
                        stream_id=query.get("stream_id", [None])[0],
                        known_generation=query.get("known_generation", [None])[0],
                    ))
                if parsed.path == "/api/telemetry":
                    return self._send(200, telemetry(challenge_root))
                if parsed.path == "/api/completion":
                    return self._send(200, completion(challenge_root))
                if parsed.path == "/api/session":
                    return self._send(200, sessions.status())
                if parsed.path == "/api/terminal":
                    return self._send(200, sessions.log_delta(after=int(query.get("after", ["0"])[0]), limit=int(query.get("limit", ["65536"])[0])))
                if parsed.path == "/api/artifacts":
                    return self._send(200, list_artifacts(
                        challenge_root,
                        limit=int(query.get("limit", ["500"])[0]),
                        known_generation=query.get("known_generation", [None])[0],
                    ))
                if parsed.path.startswith("/api/artifacts/"):
                    digest = unquote(parsed.path[len("/api/artifacts/"):])
                    return self._send(200, artifact_preview(challenge_root, digest, max_bytes=int(query.get("max_bytes", ["65536"])[0])))
                return self._send(404, {"schema": "rat.desktop.error/v1", "error": "not_found"})
            except (ValueError, OSError, RuntimeError) as exc:
                return self._send(400, {"schema": "rat.desktop.error/v1", "error": "invalid_request", "message": str(exc)})
            except Exception as exc:
                return self._send(500, {"schema": "rat.desktop.error/v1", "error": "internal_error", "message": str(exc)})

        def do_POST(self):
            if not self._origin_ok():
                return self._send(403, {"schema": "rat.desktop.error/v1", "error": "origin_forbidden"})
            if self.headers.get("X-CTF-Rat-Desktop") != "1":
                return self._send(403, {"schema": "rat.desktop.error/v1", "error": "control_header_required"})
            parsed = urlparse(self.path)
            try:
                body = self._body()
                if parsed.path == "/api/analysis/brief":
                    if set(body) != {"mode"} or body.get("mode") not in {"fast", "deep"}:
                        raise ValueError("analysis request requires mode fast or deep")
                    return self._send(200, analyses.brief(body["mode"]))
                if parsed.path == "/api/analysis/function":
                    if set(body) != {"name"} or not isinstance(body.get("name"), str):
                        raise ValueError("function request requires one string field: name")
                    return self._send(200, analyses.function(body["name"]))
                if parsed.path == "/api/analysis/oracle":
                    if body:
                        raise ValueError("oracle request takes no parameters")
                    return self._send(200, analyses.oracle())
                if parsed.path == "/api/analysis/slice":
                    if set(body) != {"backward"} or not isinstance(body.get("backward"), str):
                        raise ValueError("slice request requires one string field: backward")
                    return self._send(200, analyses.slice(body["backward"]))
                if parsed.path == "/api/session/start":
                    if body:
                        raise ValueError("start request takes no parameters")
                    return self._send(200, sessions.start())
                if parsed.path == "/api/session/stop":
                    if body:
                        raise ValueError("stop request takes no parameters")
                    return self._send(200, sessions.stop())
                if parsed.path == "/api/session/input":
                    if set(body) != {"data"} or not isinstance(body["data"], str):
                        raise ValueError("input request requires one string field: data")
                    return self._send(200, sessions.write(body["data"]))
                return self._send(404, {"schema": "rat.desktop.error/v1", "error": "not_found"})
            except (ValueError, OSError, RuntimeError) as exc:
                return self._send(400, {"schema": "rat.desktop.error/v1", "error": "invalid_request", "message": str(exc)})
            except Exception as exc:
                return self._send(500, {"schema": "rat.desktop.error/v1", "error": "internal_error", "message": str(exc)})

    return Handler


def _interrupt(_signum, _frame):
    raise KeyboardInterrupt


def main():
    parser = argparse.ArgumentParser(description="CTF-Rat desktop daemon")
    parser.add_argument("--challenge", default=".", help="challenge directory containing .rat/")
    parser.add_argument("--host", default="127.0.0.1")
    parser.add_argument("--port", type=int, default=8765)
    parser.add_argument("--solver-command", help="preconfigured solver command; parsed as argv, never executed through a shell")
    args = parser.parse_args()

    root = os.path.abspath(args.challenge)
    if not os.path.isdir(root):
        parser.error("--challenge must be an existing directory")
    if args.host not in {"127.0.0.1", "::1", "localhost"}:
        parser.error("ratd is intentionally loopback-only")
    if not (1 <= args.port <= 65535):
        parser.error("--port must be between 1 and 65535")
    solver_argv = shlex.split(args.solver_command) if args.solver_command else []
    sessions = SessionManager(root, solver_argv)
    analyses = AnalysisManager(root)
    server = ThreadingHTTPServer((args.host, args.port), _handler(root, sessions, analyses))
    signal.signal(signal.SIGTERM, _interrupt)
    signal.signal(signal.SIGINT, _interrupt)
    print("ratd: http://%s:%d  challenge=%s" % (args.host, args.port, root), file=sys.stderr)
    if solver_argv:
        print("ratd: configured solver argv=%r" % solver_argv, file=sys.stderr)
    try:
        server.serve_forever(poll_interval=0.25)
    except KeyboardInterrupt:
        pass
    finally:
        sessions.stop()
        server.server_close()


if __name__ == "__main__":
    main()
