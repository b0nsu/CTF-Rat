#!/usr/bin/env python3
"""ratd — loopback-only read-only desktop observer for CTF-Rat.

The daemon exposes STATE v2 projections over a tiny local HTTP API.  It does
not execute tools or mutate challenge state; solver control can be added later
through the canonical `rat`/orchestration gates instead of bypassing them.
"""
from __future__ import annotations
import argparse, json, os, sys
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
from urllib.parse import parse_qs, urlparse

BIN = os.path.dirname(os.path.realpath(__file__))
sys.path.insert(0, BIN)

from ratlib.desktop_api import event_delta, snapshot


def _json_bytes(doc):
    return (json.dumps(doc, sort_keys=True, ensure_ascii=False) + "\n").encode("utf-8")


def _handler(challenge_root):
    class Handler(BaseHTTPRequestHandler):
        server_version = "ratd/0.1"

        def log_message(self, fmt, *args):
            sys.stderr.write("ratd: " + (fmt % args) + "\n")

        def _send(self, status, doc):
            body = _json_bytes(doc)
            self.send_response(status)
            self.send_header("Content-Type", "application/json; charset=utf-8")
            self.send_header("Content-Length", str(len(body)))
            self.send_header("Cache-Control", "no-store")
            self.send_header("Access-Control-Allow-Origin", "*")
            self.send_header("Access-Control-Allow-Methods", "GET, OPTIONS")
            self.send_header("Access-Control-Allow-Headers", "Content-Type")
            self.end_headers()
            self.wfile.write(body)

        def do_OPTIONS(self):
            self._send(204, {})

        def do_GET(self):
            parsed = urlparse(self.path)
            try:
                if parsed.path == "/api/health":
                    return self._send(200, {"schema": "rat.desktop.health/v1", "status": "ok", "challenge_root": challenge_root})
                if parsed.path == "/api/snapshot":
                    return self._send(200, snapshot(challenge_root))
                if parsed.path == "/api/events":
                    query = parse_qs(parsed.query)
                    after_seq = int(query.get("after_seq", ["0"])[0])
                    limit = int(query.get("limit", ["500"])[0])
                    return self._send(200, event_delta(challenge_root, after_seq=after_seq, limit=limit))
                return self._send(404, {"schema": "rat.desktop.error/v1", "error": "not_found"})
            except (ValueError, OSError) as exc:
                return self._send(400, {"schema": "rat.desktop.error/v1", "error": "invalid_request", "message": str(exc)})
            except Exception as exc:
                return self._send(500, {"schema": "rat.desktop.error/v1", "error": "internal_error", "message": str(exc)})

    return Handler


def main():
    parser = argparse.ArgumentParser(description="CTF-Rat desktop observer daemon")
    parser.add_argument("--challenge", default=".", help="challenge directory containing .rat/")
    parser.add_argument("--host", default="127.0.0.1")
    parser.add_argument("--port", type=int, default=8765)
    args = parser.parse_args()

    root = os.path.abspath(args.challenge)
    if not os.path.isdir(root):
        parser.error("--challenge must be an existing directory")
    if args.host not in {"127.0.0.1", "::1", "localhost"}:
        parser.error("ratd is intentionally loopback-only")
    if not (1 <= args.port <= 65535):
        parser.error("--port must be between 1 and 65535")

    server = ThreadingHTTPServer((args.host, args.port), _handler(root))
    print("ratd: http://%s:%d  challenge=%s" % (args.host, args.port, root), file=sys.stderr)
    try:
        server.serve_forever(poll_interval=0.25)
    except KeyboardInterrupt:
        pass
    finally:
        server.server_close()


if __name__ == "__main__":
    main()
