#!/usr/bin/env python3
# Resolve the native-angr runtime independently from the pwntools environment.
import os, shutil, sys
CTF_HOME = os.environ.get("CTF_HOME", os.path.abspath(os.path.join(os.path.dirname(os.path.realpath(__file__)), "..")))
target = os.path.join(CTF_HOME, "solve", "_template", "rev", "symsolve.py")
override = os.environ.get("RAT_ANGR_PYTHON")
if override:
    python = os.path.expanduser(override)
    if not os.path.isabs(python):
        python = shutil.which(python) or python
    if not os.path.isfile(python) or not os.access(python, os.X_OK):
        print("[symsolve:err] RAT_ANGR_PYTHON is not an executable: %s" % override, file=sys.stderr)
        raise SystemExit(2)
else:
    candidate = os.path.join(CTF_HOME, ".venv-angr", "bin", "python")
    python = candidate if os.path.isfile(candidate) and os.access(candidate, os.X_OK) else sys.executable
os.execv(python, [python, target, *sys.argv[1:]])
