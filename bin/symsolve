#!/usr/bin/env python3
# spelling shim: `symsolve ...` == `python3 solve/_template/rev/symsolve.py ...`.
# The harness lives under solve/_template/rev so it can be copied into a solve
# dir and run in-place; this bin/ shim just makes the bare name resolvable on
# PATH (same convention as pwnstage). No new behavior -- pure exec passthrough.
import os, sys
CTF_HOME = os.environ.get("CTF_HOME", os.path.abspath(os.path.join(os.path.dirname(os.path.realpath(__file__)), "..")))
target = os.path.join(CTF_HOME, "solve", "_template", "rev", "symsolve.py")
os.execv(sys.executable, [sys.executable, target, *sys.argv[1:]])
