#!/usr/bin/env python3
import argparse, json, os, sys
sys.path.insert(0, os.path.dirname(__file__))
from ratlib.orchestration import GateError, report_skeptic
p=argparse.ArgumentParser(); p.add_argument("--root",default=os.getcwd()); p.add_argument("--file",required=True); a=p.parse_args()
try: print(json.dumps(report_skeptic(a.root,json.load(open(a.file)))))
except (GateError,OSError,ValueError,json.JSONDecodeError) as e: print("[rat-skeptic:policy] "+str(e),file=sys.stderr); raise SystemExit(5)
