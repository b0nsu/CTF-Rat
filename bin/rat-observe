#!/usr/bin/env python3
import argparse, json, os, sys
sys.path.insert(0,os.path.dirname(os.path.realpath(__file__)))
from ratlib.observe import materialize
from ratlib.orchestration import GateError

p=argparse.ArgumentParser(prog="rat-observe")
p.add_argument("--root",default=os.getcwd(),help="challenge root containing .rat")
sub=p.add_subparsers(dest="cmd",required=True)
m=sub.add_parser("materialize")
m.add_argument("--receipt",required=True); m.add_argument("--artifact",required=True)
m.add_argument("--subject",required=True); m.add_argument("--kind",required=True); m.add_argument("--value",default="")
a=p.parse_args()
try:
 print(json.dumps(materialize(a.root,receipt_digest=a.receipt,artifact_digest=a.artifact,subject=a.subject,kind=a.kind,value=a.value),sort_keys=True))
except (GateError,OSError,ValueError,json.JSONDecodeError) as exc:
 print("[rat-observe:policy] %s" % exc,file=sys.stderr); raise SystemExit(5)
