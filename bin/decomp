#!/usr/bin/env bash
CTF_HOME="${CTF_HOME:-$(cd -- "$(dirname -- "$(readlink -f -- "$0" 2>/dev/null || echo "$0")")/.." && pwd)}"
# decomp <binary> [func] — Ghidra headless 1회 전체 디컴파일 캐시 후 함수별 조회 (context 폭발 방지)
set -euo pipefail
GHIDRA="${GHIDRA_HOME:-}"
if [ -z "$GHIDRA" ]; then
  for cand in /opt/ghidra_*_PUBLIC "${HOME:-}/ctf-tools"/ghidra_*_PUBLIC \
    /opt/homebrew/opt/ghidra/libexec /usr/local/opt/ghidra/libexec; do
    if [ -x "$cand/support/analyzeHeadless" ]; then GHIDRA="$cand"; break; fi
  done
fi
if [ -z "$GHIDRA" ] && command -v analyzeHeadless >/dev/null 2>&1; then
  GHIDRA="$(cd -- "$(dirname -- "$(command -v analyzeHeadless)")/.." && pwd)"
fi
GHIDRA="${GHIDRA:-/opt/ghidra_11.2.1_PUBLIC}"
if [ -z "${JAVA_HOME:-}" ] && ! java -version >/dev/null 2>&1; then
  for jdk in /opt/homebrew/opt/openjdk@21/libexec/openjdk.jdk/Contents/Home \
    /usr/local/opt/openjdk@21/libexec/openjdk.jdk/Contents/Home; do
    if [ -x "$jdk/bin/java" ]; then export JAVA_HOME="$jdk"; break; fi
  done
fi
SCRIPTDIR="$CTF_HOME/bin/ghidra_scripts"
# Ghidra persists Java discovery and tool state under XDG_CONFIG_HOME before
# headless analysis.  Keep that disposable state out of the repo by default:
# stale copied kit directories can have user-owned, non-writable .rat trees.
if [ -z "${XDG_CONFIG_HOME:-}" ]; then
  export XDG_CONFIG_HOME="${XDG_CACHE_HOME:-${TMPDIR:-/tmp}}/ctf-rat-ghidra-${UID:-user}"
fi
mkdir -p "$XDG_CONFIG_HOME"
# OpenJDK 21 JIT can SIGILL/SIGSEGV on some virtualized CTF workspaces while
# Ghidra is starting.  Disabling tiered compilation keeps headless stable.
if [ -z "${JAVA_TOOL_OPTIONS:-}" ]; then
  export JAVA_TOOL_OPTIONS="-XX:-TieredCompilation"
fi
REFRESH=0; TIMEOUT_SEC=120; FORMAT=text; ALLOW_FULL_ANALYSIS=0; positional=()
while [ "$#" -gt 0 ]; do
  case "$1" in
    --refresh) REFRESH=1 ;;
    --allow-full-analysis) ALLOW_FULL_ANALYSIS=1 ;;
    --timeout) shift; TIMEOUT_SEC="${1:-}" ;;
    --format) shift; FORMAT="${1:-}" ;;
    -h|--help) echo "usage: decomp [--refresh] [--allow-full-analysis] [--timeout SEC] [--format text|json] BIN [FUNC]"; echo "Large/kernel cold imports require --allow-full-analysis; first import analyzes and exports the whole program."; exit 0 ;;
    *) positional+=("$1") ;;
  esac
  shift
done
[ "${#positional[@]}" -ge 1 ] || { echo "usage: decomp [--refresh] [--timeout SEC] [--format text|json] BIN [FUNC]" >&2; exit 2; }
[[ "$TIMEOUT_SEC" =~ ^[1-9][0-9]*$ ]] || { echo "[!] invalid timeout: $TIMEOUT_SEC" >&2; exit 2; }
[ "$FORMAT" = text ] || [ "$FORMAT" = json ] || { echo "[!] invalid format: $FORMAT" >&2; exit 2; }
# Portability guard (macOS/BSD without GNU coreutils):
#  - `readlink -f` is GNU-specific; fall back to a python resolver.
#  - `timeout` ships with coreutils; macOS provides it as `gtimeout` (brew install coreutils).
resolve_path() {
  readlink -f -- "$1" 2>/dev/null || python3 -c 'import os,sys; print(os.path.realpath(sys.argv[1]))' "$1"
}
if command -v timeout >/dev/null 2>&1; then TIMEOUT=timeout
elif command -v gtimeout >/dev/null 2>&1; then TIMEOUT=gtimeout
else
  echo "[!] 'timeout' 명령이 없습니다 (Ghidra headless 실행에 필수). macOS면 'brew install coreutils'로 gtimeout 설치 후 재시도하세요." >&2
  exit 3
fi
BIN="$(resolve_path "${positional[0]}")"; FUNC="${positional[1]:-}"
[ -f "$BIN" ] || { echo "[!] input 없음: ${positional[0]}" >&2; exit 4; }
CACHE="${BIN}.decomp"
META_TOOL="$CTF_HOME/bin/ratlib/decomp_cache.py"
read -r DECOMP_STARTED_AT DECOMP_STARTED_NS < <(python3 - <<'PY'
import time
from datetime import datetime, timezone
print(datetime.now(timezone.utc).isoformat(), time.monotonic_ns())
PY
)
DECOMP_CACHE_STATE=miss
DECOMP_RESULT_STATUS=ok
DECOMP_RESULT_CLASS=analysis-unverified
DECOMP_OPERATION=list
[ -n "$FUNC" ] && DECOMP_OPERATION=function
record_decomp_invocation(){
  local rc=$?
  local status="$DECOMP_RESULT_STATUS" result_class="$DECOMP_RESULT_CLASS"
  if [ "$rc" -ne 0 ]; then status=error; result_class=call-failed; fi
  python3 "$META_TOOL" invocation "$CACHE" "$BIN" "$GHIDRA" "$SCRIPTDIR" \
    "$DECOMP_CACHE_STATE" "$status" "$DECOMP_OPERATION" "$FUNC" \
    "$DECOMP_STARTED_AT" "$DECOMP_STARTED_NS" --exit-code "$rc" \
    --result-class "$result_class" >/dev/null 2>&1 || true
}
trap record_decomp_invocation EXIT
emit_file(){
  local result_status=ok
  DECOMP_RESULT_CLASS=valid-analysis-result
  if grep -qE 'Control flow encountered bad instruction data|Bad instruction|halt_baddata' "$1"; then
    result_status=partial
    DECOMP_RESULT_STATUS=partial
    DECOMP_RESULT_CLASS=partial
    echo "[!] Ghidra bad-instruction: 결과 partial. revq 함수 주소와 ELF VMA를 대조한 뒤 objdump -d --start-address=<FILE_VADDR> --stop-address=<END> 사용 (PIE revq 기본 load base=0x400000; file VADDR와 구분)." >&2
    echo "RAT_STATUS=partial RAT_EXIT=0" >&2
  fi
  if [ -n "$FUNC" ]; then
    PYTHONPATH="$CTF_HOME/bin${PYTHONPATH:+:$PYTHONPATH}" python3 - "$BIN" "$FUNC" "$1" "$result_status" <<'PY' >/dev/null 2>&1 || true
import hashlib, os, sys
from ratlib.route_feedback import record_followup_result
binary, selector, result_path, status = sys.argv[1:]
digest = "sha256:" + hashlib.sha256(open(binary, "rb").read()).hexdigest()
content = open(result_path, encoding="utf-8", errors="replace").read()
record_followup_result(os.path.dirname(binary), digest, "decomp", {
    "query": "decomp", "selector": selector, "binary_digest": digest,
    "status": status, "content_sha256": "sha256:" + hashlib.sha256(content.encode()).hexdigest(),
    "content": content[:32768], "content_truncated": len(content) > 32768,
})
PY
  fi
  if [ "$FORMAT" = json ]; then
    python3 - "$1" "$result_status" <<'PY'
import json,sys
print(json.dumps({'schema':'rat.decomp-result/v1','status':sys.argv[2],'source':'decompile','content':open(sys.argv[1],errors='replace').read()}))
PY
  else
    cat "$1"
  fi
}
reseal_decomp_cache(){
  # DecompOne mutates both _index.txt and one .c payload.  A successful mutation
  # must become a new complete cache generation before we serve it as canonical.
  python3 "$META_TOOL" write "$CACHE" "$BIN" "$GHIDRA" "$SCRIPTDIR" complete >/dev/null 2>&1 || return 1
  python3 "$META_TOOL" validate "$CACHE" "$BIN" "$GHIDRA" "$SCRIPTDIR" >/dev/null 2>&1
}

check_import_scope(){
  local import_scope
  import_scope="$(PYTHONPATH="$CTF_HOME/bin${PYTHONPATH:+:$PYTHONPATH}" python3 - "$BIN" <<'PY'
import os,sys
from ratlib.kernel_identity import inspect
identity=inspect(sys.argv[1])
if identity['kind'] in {'bzimage','linux-boot-image'}:
    print('boot-image')
elif identity['kind']=='vmlinux' or os.path.getsize(sys.argv[1]) >= 16*1024*1024:
    print('whole-program')
PY
)"
  if [ "$import_scope" = boot-image ]; then
    echo "[!] Linux 부트 이미지: scripts/extract-vmlinux로 ELF를 먼저 추출하세요." >&2
    echo "RAT_STATUS=error RAT_EXIT=2" >&2
    exit 2
  elif [ "$import_scope" = whole-program ] && [ "$ALLOW_FULL_ANALYSIS" -eq 0 ]; then
    echo "[!] Ghidra import는 전체 프로그램 분석을 실행합니다 (최초 캐시는 전체 함수 export도 포함). 커널/16MiB 이상 이미지는 decomp --allow-full-analysis --timeout <SEC> <BIN> [FUNC]로 명시적 예산을 지정하세요. 심볼 조회는 rat query func <BIN> <FUNC> --fast를 사용하세요." >&2
    echo "RAT_STATUS=error RAT_EXIT=2" >&2
    exit 2
  fi
}

if [ "$REFRESH" -eq 1 ] && [ -d "$CACHE" ]; then
  check_import_scope
  mv "$CACHE" "$CACHE.stale.$(date +%s)"
fi
if [ -f "$CACHE/_index.txt" ]; then
  set +e
  cache_state="$(python3 "$META_TOOL" validate "$CACHE" "$BIN" "$GHIDRA" "$SCRIPTDIR" 2>/dev/null)"
  cache_rc=$?
  set -e
  if [ "$cache_rc" -eq 10 ]; then
    echo "[!] legacy decomp cache: provenance 없음, read-only partial로 사용" >&2
    echo "RAT_STATUS=partial RAT_EXIT=0" >&2
    DECOMP_CACHE_STATE=bypass
    DECOMP_RESULT_STATUS=partial
    DECOMP_RESULT_CLASS=partial
  elif [ "$cache_rc" -eq 0 ]; then
    DECOMP_CACHE_STATE=hit
  elif [ "$cache_rc" -ne 0 ]; then
    check_import_scope
    echo "[!] decomp cache $cache_state: 재분석 필요" >&2
    mv "$CACHE" "$CACHE.$cache_state.$(date +%s)"
  fi
fi
if [ ! -f "$CACHE/_index.txt" ]; then
  check_import_scope
  echo "[*] Ghidra headless 전체 분석/export (timeout=${TIMEOUT_SEC}s)..." >&2
  [ -x "$GHIDRA/support/analyzeHeadless" ] || {
    echo "[!] Ghidra 없음: GHIDRA_HOME=$GHIDRA" >&2
    echo "RAT_STATUS=dependency_missing RAT_EXIT=3" >&2
    exit 3
  }
  mkdir -p "$CACHE"; proj="$(mktemp -d)"
  python3 "$META_TOOL" write "$CACHE" "$BIN" "$GHIDRA" "$SCRIPTDIR" partial --diagnostic "analysis started"
  set +e
  "$TIMEOUT" --signal=TERM --kill-after=1 "${TIMEOUT_SEC}s" "$GHIDRA/support/analyzeHeadless" "$proj" p -import "$BIN" \
     -scriptPath "$SCRIPTDIR" -postScript DecompExport.java "$CACHE" \
     -deleteProject >"$CACHE/.ghidra.log" 2>&1
  analysis_rc=$?
  set -e
  if [ "$analysis_rc" -ne 0 ]; then
       # 실패 로그는 디스크(.ghidra.log)에 전량 보존하되, stderr로는 끝부분만
       # 상한까지 내보낸다. 폭주·루프성 분석이 만든 수백 MB 로그를 그대로 덤프하면
       # 호출부 출력 경계를 깨므로 마지막 LOG_TAIL_BYTES 바이트만 표시한다.
       LOG_TAIL_BYTES="${DECOMP_LOG_TAIL_BYTES:-$((256 * 1024))}"
       log_size=$(wc -c < "$CACHE/.ghidra.log" 2>/dev/null || echo 0)
       if [ "$log_size" -gt "$LOG_TAIL_BYTES" ]; then
         echo "[...] .ghidra.log truncated to last ${LOG_TAIL_BYTES} bytes of ${log_size} (full log: $CACHE/.ghidra.log)" >&2
       fi
       tail -c "$LOG_TAIL_BYTES" "$CACHE/.ghidra.log" >&2
       python3 "$META_TOOL" write "$CACHE" "$BIN" "$GHIDRA" "$SCRIPTDIR" partial --diagnostic "ghidra exit=$analysis_rc"
       rm -rf "$proj"
       if [ "$analysis_rc" -eq 124 ]; then echo "RAT_STATUS=timeout RAT_EXIT=124" >&2; exit 124; fi
       echo "[!] Ghidra 디컴파일 실패" >&2
       echo "RAT_STATUS=error RAT_EXIT=70" >&2
       exit 70
  fi
  rm -rf "$proj"
  [ -f "$CACHE/_index.txt" ] || {
    cat "$CACHE/.ghidra.log" >&2
    python3 "$META_TOOL" write "$CACHE" "$BIN" "$GHIDRA" "$SCRIPTDIR" partial --diagnostic "export index missing"
    echo "[!] Ghidra export 실패" >&2
    echo "RAT_STATUS=partial RAT_EXIT=70" >&2
    exit 70
  }
  python3 "$META_TOOL" write "$CACHE" "$BIN" "$GHIDRA" "$SCRIPTDIR" complete
  set +e
  python3 "$META_TOOL" validate "$CACHE" "$BIN" "$GHIDRA" "$SCRIPTDIR" >/dev/null
  cache_post_rc=$?
  set -e
  if [ "$cache_post_rc" -ne 0 ]; then
    if [ "$cache_post_rc" -eq 12 ]; then
      echo "[!] 일부 함수 decompile 실패; partial cache로 보존" >&2
      echo "RAT_STATUS=partial RAT_EXIT=70" >&2
    else
      echo "[!] decomp cache integrity 검증 실패; 결과를 canonical cache로 사용하지 않음" >&2
      echo "RAT_STATUS=error RAT_EXIT=70" >&2
    fi
    exit 70
  fi
fi
if [ -z "$FUNC" ]; then
  DECOMP_RESULT_CLASS=valid-analysis-result
  if [ "$FORMAT" = json ]; then
    python3 - "$CACHE/_index.txt" <<'PY'
import json,sys
rows=[]
for line in open(sys.argv[1], errors='replace'):
    p=line.rstrip('\n').split('\t')
    if len(p)>=3: rows.append({'address':p[0], 'name':p[1], 'size':int(p[2])})
rows.sort(key=lambda x:-x['size'])
print(json.dumps({'schema':'rat.decomp-list/v1','status':'ok','total':len(rows),'visible':min(len(rows),60),'truncated':max(len(rows)-60,0),'functions':rows[:60]}))
PY
  else
    echo "# 함수 목록 (size 내림차순).  개별: decomp <bin> <func>"
    # Consume the full sorted stream: head exits early and SIGPIPEs sort under pipefail.
    sort -t "$(printf '\t')" -k3 -nr "$CACHE/_index.txt" 2>/dev/null | awk 'NR <= 60 { print }'
  fi
else
  IFS=$'\t' read -r lookup_status lookup_file lookup_addr lookup_vma < <(python3 "$CTF_HOME/bin/ratlib/decomp_lookup.py" "$BIN" "$CACHE" "$FUNC")
  if [ "$lookup_status" = hit ]; then
    emit_file "$lookup_file"
  elif [ "$lookup_status" = miss ]; then
    addr=$((16#$lookup_addr))
    file_vma=$((16#$lookup_vma))
    DECOMP_CACHE_STATE=miss
    if [ -x "$GHIDRA/support/analyzeHeadless" ]; then
      check_import_scope
      echo "[*] '$FUNC' 함수 캐시 없음; Ghidra one-shot create/decompile 시도 $(printf '0x%x' "$addr")" >&2
      proj="$(mktemp -d)"
      one_log="$CACHE/.ghidra-one-$(printf '%x' "$addr").log"
      if "$TIMEOUT" --signal=TERM --kill-after=1 "${TIMEOUT_SEC}s" "$GHIDRA/support/analyzeHeadless" "$proj" p -import "$BIN" \
          -scriptPath "$SCRIPTDIR" -postScript DecompOne.java "$CACHE" "$(printf '%x' "$addr")" \
          -deleteProject >"$one_log" 2>&1; then
        rm -rf "$proj"
        IFS=$'\t' read -r one_status one_file one_addr one_vma < <(python3 "$CTF_HOME/bin/ratlib/decomp_lookup.py" "$BIN" "$CACHE" "FUN_$(printf '%x' "$addr")")
        if [ "$one_status" = hit ]; then
          if grep -qE 'Control flow encountered bad instruction data|Bad instruction|halt_baddata' "$one_file"; then
            echo "[!] Ghidra one-shot 결과 품질 낮음; disassembly fallback 사용" >&2
          elif reseal_decomp_cache; then
            emit_file "$one_file"
            exit 0
          else
            echo "[!] Ghidra one-shot cache integrity 재봉인 실패; disassembly fallback 사용" >&2
          fi
        fi
      else
        rm -rf "$proj"
      fi
      echo "[!] Ghidra one-shot 실패; disassembly fallback 사용 (log: $one_log)" >&2
    fi
    start=$((file_vma > 96 ? file_vma - 96 : 0))
    stop=$((file_vma + 192))
    echo "[!] '$FUNC' 함수 캐시 없음; disassembly fallback around $(printf '0x%x' "$file_vma")" >&2
    echo "RAT_STATUS=fallback RAT_EXIT=0" >&2
    DECOMP_CACHE_STATE=bypass
    DECOMP_RESULT_STATUS=partial
    DECOMP_RESULT_CLASS=fallback
    if [ "$FORMAT" = json ]; then
      fallback="$(objdump -d --start-address="$start" --stop-address="$stop" "$BIN")"
      python3 - "$FUNC" "$fallback" <<'PY'
import json,sys
print(json.dumps({'schema':'rat.decomp-result/v1','status':'fallback','requested':sys.argv[1],'content':sys.argv[2]}))
PY
    else
      objdump -d --start-address="$start" --stop-address="$stop" "$BIN"
    fi
  else
    echo "[!] '$FUNC' 주소 변환에 필요한 image base가 없거나 함수명을 찾을 수 없음. 목록: decomp $BIN" >&2
    echo "[*] 비슷한 함수:" >&2
    grep -i -- "$FUNC" "$CACHE/_index.txt" 2>/dev/null | head -20 >&2 || true
    exit 1
  fi
fi
