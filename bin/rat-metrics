#!/usr/bin/env python3
"""Opt-in benchmark telemetry and top-level tool-call wrapper."""
from __future__ import annotations

import argparse
import json
import os
import sys

sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))
from ratlib.benchmark_report import aggregate
from ratlib.runner import run
from ratlib.telemetry import begin, finish, record, record_model, record_tool, summarize


def _captured_bytes(stream):
    if stream.spool_path:
        with open(stream.spool_path, "rb") as f:
            return f.read()
    return stream.preview


def command_begin(a):
    print(json.dumps(begin(a.root, run_id=a.run_id, ablation_id=a.ablation, challenge_id=a.challenge_id,
                           attempt=a.attempt, eligible=not a.ineligible, model=a.model, force=a.force),
                     ensure_ascii=False))
    return 0


def command_exec(a):
    argv = list(a.argv)
    if argv and argv[0] == "--":
        argv = argv[1:]
    if not argv:
        print("[rat-metrics:err] command required after --", file=sys.stderr)
        return 2
    root_abs = os.path.abspath(a.root)
    rat_root = root_abs if os.path.basename(root_abs) == ".rat" else os.path.join(root_abs, ".rat")
    spool = os.path.join(rat_root, "telemetry", "tmp")
    result = run(argv, cwd=a.cwd, timeout_seconds=a.timeout, spool_dir=spool,
                 env={"RAT_TELEMETRY_ROOT": os.path.abspath(a.root)})
    out, err = _captured_bytes(result.stdout), _captured_bytes(result.stderr)
    if out:
        sys.stdout.buffer.write(out); sys.stdout.buffer.flush()
    if err:
        sys.stderr.buffer.write(err); sys.stderr.buffer.flush()
    record_tool(argv, duration_ms=result.duration_ms, exit_code=result.exit_code,
                stdout_bytes=result.stdout.total_bytes, stderr_bytes=result.stderr.total_bytes,
                cwd=a.cwd, root=a.root)
    return result.exit_code


def command_model(a):
    ok = record_model(input_tokens=a.input_tokens, output_tokens=a.output_tokens,
                      cache_read_tokens=a.cache_read_tokens,
                      cache_creation_tokens=a.cache_creation_tokens,
                      context_tokens=a.context_tokens, duration_ms=a.duration_ms,
                      model=a.model, root=a.root)
    if not ok:
        print("[rat-metrics:err] no active telemetry run", file=sys.stderr)
        return 2
    return 0


def command_deep(a):
    if not record("deep", {"reason": a.reason}, root=a.root):
        print("[rat-metrics:err] no active telemetry run", file=sys.stderr); return 2
    return 0


def command_verify(a):
    if not record("verify", {"verified": a.verified, "flag_found": a.flag_found}, root=a.root):
        print("[rat-metrics:err] no active telemetry run", file=sys.stderr); return 2
    return 0


def command_finish(a):
    print(json.dumps(finish(a.root, status=a.status, outcome=a.outcome,
                            verified=a.verified, flag_found=a.flag_found), ensure_ascii=False))
    return 0


def command_summary(a):
    doc = summarize(a.root, a.run_id)
    if a.json:
        print(json.dumps(doc, ensure_ascii=False, indent=2, sort_keys=True))
    else:
        m = doc["metrics"]
        print("RUN      %s  ablation=%s challenge=%s attempt=%s status=%s outcome=%s" %
              (doc["benchmark_run_id"], doc["ablation_id"], doc["challenge_id"],
               doc["attempt"], doc["status"], doc["outcome"]))
        print("SOLVE    verified=%s flag=%s ttf=%s verify=%s wall=%sms" %
              (m["verified_solve"], m["flag_found"], m["time_to_flag_ms"],
               m["time_to_verified_ms"], m["wall_time_ms"]))
        print("CONTEXT  peak_tokens=%s" % m["peak_context_tokens"])
        print("TOOLS    calls=%d duplicate=%d wall=%dms" %
              (m["tools"]["calls"], m["tools"]["duplicate_calls"], m["tools"]["wall_ms"]))
        ratio = m["cache"]["hit_ratio"]
        print("CACHE    %d/%d hit  ratio=%s  writes=%d" %
              (m["cache"]["hits"], m["cache"]["reads"],
               "n/a" if ratio is None else "%.3f" % ratio, m["cache"]["writes"]))
        print("TOKENS   in=%d out=%d cache_read=%d cache_create=%d" %
              (m["tokens"]["input"], m["tokens"]["output"],
               m["tokens"]["cache_read"], m["tokens"]["cache_creation"]))
        if m["tools"]["top_duplicates"]:
            print("DUPLICATES")
            for item in m["tools"]["top_duplicates"][:5]:
                print("  x%d %s" % (item["count"], " ".join(item["argv"])))
    return 0


def _fmt(value, *, rate=False):
    if value is None:
        return "-"
    if rate:
        return "%.1f%%" % (100.0 * float(value))
    if isinstance(value, float) and not value.is_integer():
        return "%.1f" % value
    return str(int(value)) if isinstance(value, (int, float)) else str(value)


def command_aggregate(a):
    doc = aggregate(a.root, challenge_id=a.challenge_id, ablation_id=a.ablation,
                    include_ineligible=a.include_ineligible, min_runs=a.min_runs)
    if a.json:
        print(json.dumps(doc, ensure_ascii=False, indent=2, sort_keys=True))
        return 0
    if not doc["groups"]:
        print("(no completed benchmark groups matched)")
        return 0
    print("CHALLENGE            ABL   N  VERIFIED  RATE    TTF_MED  CTX_MED  TOOLS  DUP  CACHE")
    for g in doc["groups"]:
        m = g["median"]
        cache = g["structured_cache"]["hit_ratio"]
        marker = "" if g["enough_repeats"] else "*"
        print("%-20s %-3s %3d %4d/%-4d %-7s %-8s %-8s %-6s %-4s %s%s" %
              (g["challenge_id"][:20], g["ablation_id"], g["scored_runs"],
               g["verified_runs"], g["scored_runs"], _fmt(g["verified_solve_rate"], rate=True),
               _fmt(m["time_to_flag_ms_verified"]), _fmt(m["peak_context_tokens"]),
               _fmt(m["tool_calls"]), _fmt(m["duplicate_tool_calls"]),
               "-" if cache is None else "%.1f%%" % (100.0 * cache), marker))
    if any(not g["enough_repeats"] for g in doc["groups"]):
        print("* fewer than --min-runs scored attempts; treat as provisional")
    if doc["ignored_runs"]:
        print("IGNORED  %d run(s), including active/corrupt telemetry" % len(doc["ignored_runs"]))
    return 0


def parser():
    p = argparse.ArgumentParser(prog="rat-metrics", description="CTF-Rat opt-in benchmark telemetry")
    sub = p.add_subparsers(dest="cmd", required=True)
    q = sub.add_parser("begin"); q.add_argument("--root", default=os.getcwd()); q.add_argument("--run-id"); q.add_argument("--ablation", choices=["A0","A1","A2","A3","A4","A5"], default="A0"); q.add_argument("--challenge-id"); q.add_argument("--attempt", type=int, default=1); q.add_argument("--ineligible", action="store_true"); q.add_argument("--model"); q.add_argument("--force", action="store_true"); q.set_defaults(func=command_begin)
    q = sub.add_parser("exec"); q.add_argument("--root", default=os.getcwd()); q.add_argument("--cwd"); q.add_argument("--timeout", type=float, default=120); q.add_argument("argv", nargs=argparse.REMAINDER); q.set_defaults(func=command_exec)
    q = sub.add_parser("model"); q.add_argument("--root", default=os.getcwd()); q.add_argument("--input-tokens", type=int, default=0); q.add_argument("--output-tokens", type=int, default=0); q.add_argument("--cache-read-tokens", type=int, default=0); q.add_argument("--cache-creation-tokens", type=int, default=0); q.add_argument("--context-tokens", type=int); q.add_argument("--duration-ms", type=int, default=0); q.add_argument("--model"); q.set_defaults(func=command_model)
    q = sub.add_parser("deep"); q.add_argument("--root", default=os.getcwd()); q.add_argument("--reason", required=True); q.set_defaults(func=command_deep)
    q = sub.add_parser("verify"); q.add_argument("--root", default=os.getcwd()); q.add_argument("--verified", action="store_true"); q.add_argument("--flag-found", action="store_true"); q.set_defaults(func=command_verify)
    q = sub.add_parser("finish"); q.add_argument("--root", default=os.getcwd()); q.add_argument("--status", choices=["completed","timeout","partial","infra-failure","skipped"], default="completed"); q.add_argument("--outcome", choices=["verified","solve-claimed","failed","censored","unknown","skipped"], default="unknown"); q.add_argument("--verified", action="store_true"); q.add_argument("--flag-found", action="store_true"); q.set_defaults(func=command_finish)
    q = sub.add_parser("summary"); q.add_argument("--root", default=os.getcwd()); q.add_argument("--run-id"); q.add_argument("--json", action="store_true"); q.set_defaults(func=command_summary)
    q = sub.add_parser("aggregate"); q.add_argument("--root", default=os.getcwd()); q.add_argument("--challenge-id"); q.add_argument("--ablation", choices=["A0","A1","A2","A3","A4","A5"]); q.add_argument("--include-ineligible", action="store_true"); q.add_argument("--min-runs", type=int, default=3); q.add_argument("--json", action="store_true"); q.set_defaults(func=command_aggregate)
    return p


def main(argv=None):
    a = parser().parse_args(argv)
    try:
        return a.func(a)
    except ValueError as exc:
        print("[rat-metrics:err] %s" % exc, file=sys.stderr)
        return 2


if __name__ == "__main__":
    raise SystemExit(main())
