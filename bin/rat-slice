#!/usr/bin/env python3
import os,sys; sys.path.insert(0,os.path.dirname(os.path.realpath(__file__)))
from ratlib.angr_runtime import reexec_for_angr
if "--help" not in sys.argv[1:] and "-h" not in sys.argv[1:]:
    reexec_for_angr(__file__, sys.argv[1:])
from ratlib.analysis_cli import run
from ratlib.slice_loop import main
raise SystemExit(run(main))
