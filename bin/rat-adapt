#!/usr/bin/env python3
"""P1 adapter for legacy recon/revq/gdbq/symsolve commands."""
import argparse, json, os, sys
sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))
from ratlib.contracts import execute
p=argparse.ArgumentParser(); p.add_argument("--root"); p.add_argument("--input",action="append",default=[]); p.add_argument("--timeout",type=float,default=60); p.add_argument("tool",choices=["recon","revq","gdbq","symsolve"]); p.add_argument("args",nargs=argparse.REMAINDER)
a=p.parse_args(); home=os.path.dirname(os.path.realpath(__file__))
paths={"recon":os.path.join(home,"recon"),"revq":os.path.join(home,"revq"),"gdbq":os.path.join(home,"gdbq"),"symsolve":os.path.join(home,"..","solve","_template","rev","symsolve.py")}
argv=[paths[a.tool],*a.args]
if a.tool=="symsolve": argv=[sys.executable,*argv]
print(json.dumps(execute(argv,root=a.root,input_paths=a.input,parameters={"args":a.args},timeout=a.timeout),ensure_ascii=False))
