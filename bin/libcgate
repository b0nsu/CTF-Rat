#!/usr/bin/env python3
"""
libcgate - audit libc/loader provenance before blaming a remote mismatch.

Usage:
  libcgate [challenge-dir]
  libcgate --selftest

This does not build Docker images; it reports
whether the current challenge directory has enough runtime evidence and prints
the heap/tcache checks that must precede a "remote libc differs" conclusion.
"""
import argparse
from ratlib.copy_reloc import copy_relocations
import hashlib
import json
import os
import re
import shutil
import subprocess
import sys
import tempfile


LIBC_RE = re.compile(r"^(?:libc(?:[-_].*)?\.so(?:\.\d+)*|libc[-_].*\.so(?:\.\d+)*)$")


def sha256(path):
    h = hashlib.sha256()
    with open(path, "rb") as f:
        for chunk in iter(lambda: f.read(65536), b""):
            h.update(chunk)
    return h.hexdigest()


def read_bytes(path, limit=4 * 1024 * 1024):
    try:
        with open(path, "rb") as f:
            return f.read(limit)
    except OSError:
        return b""


def printable_chunks(data):
    # Good enough for glibc version strings without shelling out to strings(1).
    out = []
    cur = bytearray()
    for b in data:
        if 32 <= b < 127:
            cur.append(b)
        else:
            if len(cur) >= 4:
                out.append(bytes(cur).decode("ascii", "ignore"))
            cur.clear()
    if len(cur) >= 4:
        out.append(bytes(cur).decode("ascii", "ignore"))
    return "\n".join(out)


def libc_version(path):
    s = printable_chunks(read_bytes(path))
    m = (
        re.search(r"release version ([0-9]+\.[0-9]+)", s)
        or re.search(r"GNU C Library .*? release version ([0-9]+\.[0-9]+)", s)
        or re.search(r"glibc[ -]([0-9]+\.[0-9]+)", s, re.I)
        or re.search(r"GLIBC ([0-9]+\.[0-9]+)-", s)
    )
    return m.group(1) if m else None


def find_files(root):
    dockerfiles = []
    libcs = []
    loaders = []
    for cur, dirs, files in os.walk(root):
        dirs[:] = [d for d in dirs if d not in (".git", "__pycache__")]
        rel_depth = os.path.relpath(cur, root).count(os.sep)
        if rel_depth > 2:
            dirs[:] = []
        for fn in files:
            p = os.path.join(cur, fn)
            base = os.path.basename(fn)
            if base == "Dockerfile":
                dockerfiles.append(p)
            elif LIBC_RE.match(base):
                libcs.append(p)
            elif base.startswith("ld-") or base.startswith("ld_") or "ld-linux" in base or "ld-musl" in base:
                loaders.append(p)
    return sorted(dockerfiles), sorted(libcs), sorted(loaders)


def from_line(path):
    try:
        for line in open(path, "r", encoding="utf-8", errors="replace"):
            if line.strip().upper().startswith("FROM "):
                return line.strip()
    except OSError:
        pass
    return None


def describe(path):
    real = os.path.realpath(path)
    symlink = os.path.islink(path)
    bits = [os.path.relpath(path)]
    if symlink:
        bits.append("symlink->%s" % os.readlink(path))
    try:
        bits.append("sha256=%s" % sha256(real)[:16])
    except OSError:
        bits.append("sha256=?")
    ver = libc_version(real)
    if ver:
        bits.append("glibc=%s" % ver)
    return " ".join(bits)


def same_file(a, b):
    try:
        return sha256(os.path.realpath(a)) == sha256(os.path.realpath(b))
    except OSError:
        return False


def manifest_binary(root):
    """Select the challenge-local, digest-verified binary; do not guess paths."""
    path = os.path.join(root, "run.json")
    if not os.path.isfile(path):
        return None, "run.json is missing; COPY relocation scan unavailable without a digest-bound binary."
    try:
        with open(path, encoding="utf-8") as source:
            manifest = json.load(source)
        name = manifest.get("scaffold", {}).get("binary")
        if (not isinstance(name, str) or name in (".", "..")
                or os.path.basename(name) != name):
            return None, "run.json does not select a safe challenge-local scaffold binary."
        record = next((item for item in manifest.get("inputs", [])
                       if item.get("role") == "binary" and item.get("name") == name), None)
        if not record or not isinstance(record.get("sha256"), str):
            return None, "run.json has no digest-bound binary input for %s." % name
        binary = os.path.join(root, name)
        if os.path.islink(binary) or not os.path.isfile(binary):
            return None, "selected binary is not an ordinary challenge-local file: %s." % name
        if record["sha256"].lower().removeprefix("sha256:") != sha256(binary):
            return None, "run.json binary digest differs from %s; refusing stale COPY facts." % name
        return binary, None
    except (OSError, ValueError, TypeError, AttributeError) as exc:
        return None, "cannot validate run.json binary: %s." % type(exc).__name__


def parse_from_image(from_line_text):
    """Extract the image reference from a Dockerfile FROM line, preferring a
    pinned @sha256 digest. Returns (reference, pinned_bool) or (None, False)."""
    if not from_line_text:
        return None, False
    # drop leading FROM and any "--platform=..." / "AS name"
    rest = from_line_text.strip()
    rest = re.sub(r"^FROM\s+", "", rest, flags=re.I)
    rest = re.sub(r"^--\S+\s+", "", rest)  # --platform=...
    rest = re.split(r"\s+AS\s+", rest, flags=re.I)[0].strip()
    token = rest.split()[0] if rest else ""
    if not token or token.lower() == "scratch":
        return None, False
    # A digest pin is repo[:tag]@sha256:...  — keep the whole ref (docker accepts repo@sha256:)
    m = re.search(r"@sha256:[0-9a-fA-F]{64}", token)
    if m:
        # docker create accepts "repo@sha256:..."; strip a tag before @ if both present
        ref = re.sub(r":[^@/]+@sha256:", "@sha256:", token)
        return ref, True
    return token, False


_LIBC_IN_IMAGE = (
    "/usr/lib/x86_64-linux-gnu/libc.so.6",
    "/lib/x86_64-linux-gnu/libc.so.6",
    "/usr/lib/i386-linux-gnu/libc.so.6",
    "/lib/i386-linux-gnu/libc.so.6",
    "/usr/lib/aarch64-linux-gnu/libc.so.6",
    "/lib/libc.so.6",
    "/usr/lib/libc.so.6",
)
_LOADER_IN_IMAGE = (
    "/lib/x86_64-linux-gnu/ld-linux-x86-64.so.2",
    "/usr/lib/x86_64-linux-gnu/ld-linux-x86-64.so.2",
    "/lib64/ld-linux-x86-64.so.2",
    "/lib/i386-linux-gnu/ld-linux.so.2",
    "/usr/lib/i386-linux-gnu/ld-linux.so.2",
    "/lib/ld-linux.so.2",
    "/lib/aarch64-linux-gnu/ld-linux-aarch64.so.1",
    "/lib/ld-linux-aarch64.so.1",
)


def _build_id(path):
    """Return the GNU build-id hex of an ELF, or None (readelf-based, bounded)."""
    readelf = shutil.which("readelf")
    if not readelf:
        return None
    try:
        out = subprocess.run([readelf, "-n", "--", path], capture_output=True,
                             text=True, timeout=10, env={**os.environ, "LC_ALL": "C"})
    except (OSError, subprocess.TimeoutExpired):
        return None
    m = re.search(r"Build ID:\s*([0-9a-f]+)", out.stdout)
    return m.group(1) if m else None


def _docker_cp_first(container, candidates, dest):
    """Try docker cp for each candidate path; return the image path copied, or None."""
    docker = shutil.which("docker")
    for src_path in candidates:
        try:
            r = subprocess.run([docker, "cp", "-L", "%s:%s" % (container, src_path), dest],
                               capture_output=True, text=True, timeout=60)
        except (OSError, subprocess.TimeoutExpired):
            continue
        if r.returncode == 0 and os.path.isfile(dest) and not os.path.islink(dest):
            return src_path
        # docker cp of a symlink target: if dest is a symlink or dir, clean up
        if os.path.lexists(dest) and (os.path.islink(dest) or not os.path.isfile(dest)):
            try:
                os.remove(dest)
            except OSError:
                pass
    return None


def extract_from_image(root, image=None):
    """Extract libc/loader from an explicitly selected final built image into ``root``
    and record them as run.json inputs. Loud failure, never a host fallback.
    Returns (text, exit_code)."""
    root = os.path.abspath(root)
    lines = ["== libcgate extract: %s ==" % root]
    if not image or not isinstance(image, str) or image.startswith("-"):
        return "\n".join(lines + [
            "ERROR: --image FINAL_BUILT_IMAGE is required; a Dockerfile FROM is not runtime provenance."]), 2
    docker = shutil.which("docker")
    if not docker:
        lines.append("ERROR: docker not available; cannot extract the challenge libc.")
        lines.append("Do NOT assume the host libc matches. Install docker or supply libc/ld manually.")
        return "\n".join(lines), 2
    try:
        inspected = subprocess.run([docker, "image", "inspect", "--format", "{{.Id}}", image],
                                   capture_output=True, text=True, timeout=60)
    except (OSError, subprocess.TimeoutExpired) as exc:
        return "\n".join(lines + ["ERROR: docker image inspect failed (%s)." %
                                  type(exc).__name__]), 2
    image_id = inspected.stdout.strip()
    if (inspected.returncode != 0 or
            not re.fullmatch(r"sha256:[0-9a-fA-F]{64}", image_id)):
        return "\n".join(lines + ["ERROR: final image identity is unavailable or ambiguous."]), 2
    image_id = image_id.lower()
    lines.append("final built image: %s (id=%s)" % (image, image_id))
    manifest_path = os.path.join(root, "run.json")
    try:
        from ratlib.run_manifest import read as _read, atomic_write as _write, _input as _mk_input
        manifest = _read(manifest_path)
    except (OSError, ValueError, json.JSONDecodeError) as exc:
        lines.append("ERROR: valid run.json required before extraction (%s)." % type(exc).__name__)
        return "\n".join(lines), 2
    # create a container (pulls if needed) without running it
    try:
        created = subprocess.run([docker, "create", "--", image_id], capture_output=True,
                                 text=True, timeout=600)
    except (OSError, subprocess.TimeoutExpired) as exc:
        lines.append("ERROR: docker create failed (%s). No host fallback." % type(exc).__name__)
        return "\n".join(lines), 2
    if created.returncode != 0:
        lines.append("ERROR: docker create failed: %s" % created.stderr.strip()[:300])
        lines.append("No host libc fallback; resolve image access and retry.")
        return "\n".join(lines), 2
    container = created.stdout.strip()
    with tempfile.TemporaryDirectory(prefix=".libcgate-extract-", dir=root) as stage_dir:
        extracted = []
        try:
            for role, name, candidates in (("libc", "libc_docker.so.6", _LIBC_IN_IMAGE),
                                           ("loader", "ld_docker.so", _LOADER_IN_IMAGE)):
                staged = os.path.join(stage_dir, name)
                src = _docker_cp_first(container, candidates, staged)
                if src:
                    extracted.append((role, staged, os.path.join(root, name), src))
        finally:
            try:
                subprocess.run([docker, "rm", "-f", "--", container],
                               capture_output=True, text=True, timeout=60)
            except (OSError, subprocess.TimeoutExpired):
                lines.append("WARN: temporary Docker container cleanup failed.")
        if not any(role == "libc" for role, _, _, _ in extracted):
            lines.append("ERROR: could not extract libc.so.6 from the image (tried known paths).")
            lines.append("No host libc fallback; inspect the image layout and extend the path list.")
            return "\n".join(lines), 2
        if not any(role == "loader" for role, _, _, _ in extracted):
            lines.append("ERROR: could not extract the loader from the image (tried known paths).")
            return "\n".join(lines), 2
        inputs = manifest.setdefault("inputs", [])
        recorded = []
        for role, staged, dest, src in extracted:
            name = os.path.basename(dest)
            ver = libc_version(staged) if role == "libc" else None
            bid = _build_id(staged)
            lines.append("extracted %s: %s (from %s)%s%s" % (
                role, name, src, "  glibc=%s" % ver if ver else "",
                "  build-id=%s" % bid if bid else ""))
            inputs[:] = [i for i in inputs if not (i.get("role") == role and i.get("name") == name)]
            item = _mk_input(role, staged, name=name)
            item["provenance"] = {
                "source": "docker-final-image", "requested_image": image,
                "image_id": image_id, "container_path": src, "build_id": bid,
            }
            inputs.append(item)
            recorded.append(name)
        backups = {}
        installed = []
        try:
            for role, staged, dest, _src in extracted:
                if os.path.lexists(dest):
                    backup = os.path.join(stage_dir, ".previous-" + role)
                    os.replace(dest, backup)
                    backups[dest] = backup
                os.replace(staged, dest)
                installed.append(dest)
            _write(manifest_path, manifest)
        except Exception as exc:
            rollback_errors = []
            for dest in reversed(installed):
                try:
                    os.unlink(dest)
                except OSError as rollback_exc:
                    rollback_errors.append(type(rollback_exc).__name__)
            for dest, backup in backups.items():
                try:
                    os.replace(backup, dest)
                except OSError as rollback_exc:
                    rollback_errors.append(type(rollback_exc).__name__)
            lines.append("ERROR: could not commit extracted runtime (%s); rollback %s." % (
                type(exc).__name__, "incomplete: " + ", ".join(rollback_errors)
                if rollback_errors else "complete"))
            return "\n".join(lines), 2
        lines.append("recorded as run.json inputs: %s" % ", ".join(recorded))
    return "\n".join(lines), 0


def audit(root):
    root = os.path.abspath(root)
    old = os.getcwd()
    os.chdir(root)
    try:
        dockerfiles, libcs, loaders = find_files(".")
        lines = ["== libcgate: %s ==" % root]
        warnings = []
        notes = []

        if dockerfiles:
            lines.append("Dockerfile:")
            for p in dockerfiles:
                src = from_line(p)
                lines.append("  - %s%s" % (os.path.relpath(p), "  [%s]" % src if src else ""))
            notes.append("Dockerfile present: built image is authoritative for libc, loader, env, cwd, user, and wrapper.")
        else:
            lines.append("Dockerfile: none found")
            notes.append("No Dockerfile found: use supplied libc/ld when present; glibc-fetch is only a fallback.")

        lines.append("libc candidates:")
        if libcs:
            for p in libcs:
                lines.append("  - " + describe(p))
        else:
            lines.append("  - none")
            if dockerfiles:
                warnings.append("Dockerfile exists but no extracted libc candidate was found; run 'libcgate --extract --image FINAL_BUILT_IMAGE' (no host fallback).")

        lines.append("loader candidates:")
        if loaders:
            for p in loaders:
                lines.append("  - " + describe(p))
                if os.path.islink(p):
                    link = os.readlink(p)
                    real = os.path.realpath(p)
                    if link.startswith(("/lib/", "/usr/lib/")) or real.startswith(("/lib/", "/usr/lib/")):
                        warnings.append("%s points at host loader %s; extract the loader from the Docker image for proof." % (os.path.relpath(p), link))
        else:
            lines.append("  - none")
            if dockerfiles:
                warnings.append("Dockerfile exists but no extracted ld-linux candidate was found in this directory.")

        by_base = {os.path.basename(p): p for p in libcs}
        if "libc.so.6" in by_base and "libc_docker.so.6" in by_base:
            if same_file(by_base["libc.so.6"], by_base["libc_docker.so.6"]):
                notes.append("libc.so.6 matches libc_docker.so.6 by sha256.")
            else:
                warnings.append("libc.so.6 differs from libc_docker.so.6; pick one authoritative runtime libc and record why.")

        binary, selection_warning = manifest_binary(".")
        if selection_warning:
            warnings.append(selection_warning)
        if binary:
            copies, relocation_warning = copy_relocations(binary)
            if relocation_warning:
                warnings.append("COPY relocation scan unavailable: " + relocation_warning)
            elif copies:
                lines.append("COPY relocations (executable-owned globals, not libc's symbol):")
                for address, symbol, kind in copies[:32]:
                    lines.append("  - %s @ %s [%s]" % (symbol, address, kind))
                if len(copies) > 32:
                    lines.append("  - ... %d additional COPY relocations omitted" % (len(copies) - 32))
            else:
                lines.append("COPY relocations: none detected in the selected ELF")

        lines.append("verdict:")
        for w in warnings:
            lines.append("  WARN: " + w)
        for n in notes:
            lines.append("  NOTE: " + n)
        lines.append("  GATE: Before claiming remote libc mismatch, verify Docker-loopback behavior or leak/hash/build-id evidence.")
        lines.append("  GATE: For heap/tcache failures, first prove tcache count/head/fd and safe-linking encoding on the exact malloc/free sequence.")
        return "\n".join(lines), 1 if warnings else 0
    finally:
        os.chdir(old)


def selftest():
    with tempfile.TemporaryDirectory() as d:
        with open(os.path.join(d, "Dockerfile"), "w") as f:
            f.write("FROM ubuntu:22.04\n")
        with open(os.path.join(d, "libc.so.6"), "wb") as f:
            f.write(b"GNU C Library stable release version 2.35\x00")
        os.symlink("/lib/x86_64-linux-gnu/ld-linux-x86-64.so.2", os.path.join(d, "ld-linux-x86-64.so.2"))
        out, rc = audit(d)
        assert "Dockerfile present" in out
        assert "glibc=2.35" in out
        assert "host loader" in out
        assert rc == 1

    # parse_from_image: prefer @sha256 pin, strip --platform/AS, reject scratch
    ref, pinned = parse_from_image("FROM ubuntu:24.04@sha256:" + "a" * 64)
    assert pinned and ref == "ubuntu@sha256:" + "a" * 64, ref
    ref, pinned = parse_from_image("FROM --platform=linux/amd64 x:1@sha256:" + "b" * 64 + " AS base")
    assert pinned and ref == "x@sha256:" + "b" * 64, ref
    ref, pinned = parse_from_image("FROM ubuntu:22.04")
    assert ref == "ubuntu:22.04" and not pinned, ref
    assert parse_from_image("FROM scratch") == (None, False)

    # Extraction requires an explicit final image; a Dockerfile base is insufficient.
    with tempfile.TemporaryDirectory() as d:
        out, rc = extract_from_image(d)
        assert rc == 2 and "--image" in out, (rc, out)
    # when docker is absent, extraction fails loudly (exit 2) rather than guessing the host libc
    with tempfile.TemporaryDirectory() as d:
        with open(os.path.join(d, "Dockerfile"), "w") as f:
            f.write("FROM ubuntu:22.04@sha256:" + "c" * 64 + "\n")
        saved = os.environ.get("PATH", "")
        try:
            os.environ["PATH"] = ""  # hide docker/readelf/etc from shutil.which
            out, rc = extract_from_image(d, image="challenge:built")
        finally:
            os.environ["PATH"] = saved
        assert rc == 2 and "docker not available" in out and "host libc" in out, (rc, out)

    print("[libcgate] selftest ALL GREEN")


def main():
    ap = argparse.ArgumentParser()
    ap.add_argument("path", nargs="?", default=".")
    ap.add_argument("--selftest", action="store_true")
    ap.add_argument("--extract", action="store_true",
                    help="extract libc/ld from an explicitly selected final built image")
    ap.add_argument("--image", help="final built Docker image; required with --extract")
    args = ap.parse_args()
    if args.selftest:
        selftest()
        return 0
    if args.extract:
        out, rc = extract_from_image(args.path, image=args.image)
        print(out)
        return rc
    out, rc = audit(args.path)
    print(out)
    return rc


if __name__ == "__main__":
    sys.exit(main())
