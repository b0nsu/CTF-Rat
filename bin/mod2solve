#!/usr/bin/env python3
"""Solve a bounded local JSON linear system modulo 2**bits; no external solver."""
from __future__ import annotations

import argparse
import hashlib
import json
import os
import sys

from ratlib.mod2linear import solve

MAX_INPUT_BYTES = 4 * 1024 * 1024


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("input", help='JSON file with {"bits":8,"matrix":[[...]],"target":[...]}')
    args = parser.parse_args()
    try:
        with open(args.input, "rb") as source:
            raw = source.read(MAX_INPUT_BYTES + 1)
        if len(raw) > MAX_INPUT_BYTES:
            raise ValueError("input exceeds 4 MiB")
        doc = json.loads(raw)
        if not isinstance(doc, dict) or set(doc) != {"bits", "matrix", "target"}:
            raise ValueError("input must contain exactly bits, matrix and target")
        result = solve(doc["matrix"], doc["target"], doc["bits"])
    except (OSError, ValueError, ArithmeticError) as exc:
        print(json.dumps({"operation": "mod2-linear", "status": "error", "error": str(exc)}))
        return 2
    output = {"operation": "mod2-linear",
              "algorithm": "valuation-aware modular Gaussian elimination",
              "artifact": {"path": os.path.realpath(args.input),
                           "sha256": "sha256:" + hashlib.sha256(raw).hexdigest()},
              "inputs": doc, "formula": "matrix @ solution == target (mod 2**bits)",
              **result}
    if doc["bits"] <= 8 and result["solution"] is not None:
        output["solution_hex"] = bytes(result["solution"]).hex()
    print(json.dumps(output, sort_keys=True))
    return 1 if result["status"] == "inconsistent" else 0


if __name__ == "__main__":
    sys.exit(main())
