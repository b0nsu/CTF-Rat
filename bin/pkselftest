#!/usr/bin/env bash
CTF_HOME="${CTF_HOME:-$(cd -- "$(dirname -- "$(readlink -f -- "$0" 2>/dev/null || echo "$0")")/.." && pwd)}"
export PATH="$CTF_HOME/bin:$PATH"
export PYTHONPATH="$CTF_HOME/bin${PYTHONPATH:+:$PYTHONPATH}"
# 도구 회귀 self-test (kernel testkit 패턴 이식). 도구 수정 후 한 방 검증.
set -uo pipefail
STRICT="${STRICT_OPTIONAL:-0}"
FORMAT=text
while [ "$#" -gt 0 ]; do
  case "$1" in
    --strict-optional) STRICT=1 ;;
    --format) shift; FORMAT="${1:-}"; [ "$FORMAT" = text ] || [ "$FORMAT" = json ] || { echo "usage: pkselftest [--strict-optional] [--format text|json]" >&2; exit 2; } ;;
    *) echo "usage: pkselftest [--strict-optional] [--format text|json]" >&2; exit 2 ;;
  esac
  shift
done
VENV=python3
export PYTHONPATH="$CTF_HOME/bin${PYTHONPATH:+:$PYTHONPATH}"
P=0; F=0; S=0
line(){ [ "$FORMAT" = json ] || echo "$1"; }
ok(){ line "  [PASS] $1"; P=$((P+1)); }
no(){ line "  [FAIL] $1"; F=$((F+1)); }
skip(){ line "  [SKIP] $1"; S=$((S+1)); }
T=$(mktemp -d); cd "$T"
cleanup(){ cd /; rm -rf -- "$T"; }
trap cleanup EXIT
trap 'exit 130' HUP INT TERM
# T1 state roundtrip
state init st >/dev/null 2>&1; state offset system 0x50d70 t >/dev/null 2>&1; state ok "prim" >/dev/null 2>&1
state show 2>/dev/null | grep -q "system = 0x50d70" && ok "state offset/show" || no "state offset/show"
mkdir -p ./pathstate
state --dir ./pathstate offset keyed 0x4141 path >/dev/null 2>&1
state show ./pathstate 2>/dev/null | grep -q "keyed = 0x4141" && ok "state explicit path" || no "state explicit path"
# T2 pwnstage reads STATE offset as int
$VENV -c "import pwnstage;assert pwnstage.offsets().get('system')==0x50d70" 2>/dev/null && ok "pwnstage.offsets int" || no "pwnstage.offsets int"
# T3 pkflag real vs fake
pkflag --set 'DH\{[0-9a-f]{4,}\}' >/dev/null 2>&1
pkflag 'DH{deadbeef}' >/dev/null 2>&1 && R1=ok || R1=no
pkflag 'flag{fake_flag}' >/dev/null 2>&1 && R2=bad || R2=ok
[ "$R1" = ok ] && [ "$R2" = ok ] && ok "pkflag real/fake" || no "pkflag real/fake"
# T4 pwnkit snapscript + pwnclean --kv filter
$VENV -c "import pwnkit;print(pwnkit.snapscript([('a','0x1')]).strip())" 2>/dev/null | grep -q 'SNAP a=' && ok "pwnkit.snapscript" || no "pwnkit.snapscript"
printf '\033[31mpwndbg: x\033[0m\nSNAP r=0x401234\nnoise\n' | pwnclean --kv 2>/dev/null | grep -q 'SNAP r=0x401234' && ok "pwnclean --kv filter" || no "pwnclean --kv filter"
# T5 pwnkit.run_batch (headless gdb 플러밍) — 심볼불요, 상수 SNAP
B=$CTF_HOME/solve/heapnote_G/main
if [ -f "$B" ]; then cp "$B" ./m; $VENV -c "import pwnkit;s,_=pwnkit.run_batch('./m', 'printf \"SNAP x=%#lx\\\\n\", 0x41\n');import sys;sys.exit(0 if s.get('x')==0x41 else 1)" 2>/dev/null && ok "pwnkit.run_batch headless" || no "pwnkit.run_batch headless"; else skip "run_batch (테스트 바이너리 없음)"; fi
# T6 pkshare SHARE 생성
pkshare --handoff >/dev/null 2>&1 && [ -f SHARE.md ] && ok "pkshare SHARE.md" || no "pkshare SHARE.md"
# T7 libcgate provenance audit
libcgate --selftest >/dev/null 2>&1 && ok "libcgate selftest" || no "libcgate selftest"
# T8 decomp cache lookup: revq sub_40xxxx alias -> Ghidra FUN_0010xxxx
touch ./m
mkdir -p ./m.decomp
printf '00101234\tFUN_00101234\t1\n' > ./m.decomp/_index.txt
printf 'decompiled alias ok\n' > ./m.decomp/FUN_00101234.c
"$CTF_HOME/bin/decomp" ./m sub_401234 2>/dev/null | grep -q 'decompiled alias ok' && ok "decomp revq/Ghidra addr alias" || no "decomp revq/Ghidra addr alias"
printf 'int main(){return 0;}\n' > ./m2.c
cc ./m2.c -o ./m2 2>/dev/null
mkdir -p ./m2.decomp
printf '' > ./m2.decomp/_index.txt
"$CTF_HOME/bin/decomp" ./m2 0x401234 2>/dev/null | grep -q 'file format' && ok "decomp missing addr disasm fallback" || no "decomp missing addr disasm fallback"
# T9 bounded Qiling transport + optional dependency status
"$CTF_HOME/bin/rat-qiling" --selftest >/dev/null 2>&1 && ok "rat-qiling bounded selftest" || no "rat-qiling bounded selftest"
$VENV -c 'import qiling' >/dev/null 2>&1 && ok "qiling optional dependency" || skip "qiling optional dependency 없음"
if [ "${PKSELFTEST_FORCE_FAIL:-0}" = 1 ]; then no "forced failure injection"; fi
if [ "$FORMAT" = json ]; then
  printf '{"schema":"rat.selftest/v1","pass":%d,"fail":%d,"skip":%d,"strict_optional":%s}\n' "$P" "$F" "$S" "$([ "$STRICT" = 1 ] && echo true || echo false)"
else
  echo "=== pkselftest: PASS=$P FAIL=$F SKIP=$S ==="
fi
if [ "$P" -eq 0 ] || [ "$F" -ne 0 ] || { [ "$STRICT" = 1 ] && [ "$S" -ne 0 ]; }; then
  line "REGRESSION 있음"
  exit 1
fi
line "ALL GREEN"
