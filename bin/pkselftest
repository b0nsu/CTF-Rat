#!/usr/bin/env bash
CTF_HOME="${CTF_HOME:-$(cd -- "$(dirname -- "$(readlink -f -- "$0" 2>/dev/null || echo "$0")")/.." && pwd)}"
export PATH="$CTF_HOME/bin:$PATH"
export PYTHONPATH="$CTF_HOME/bin${PYTHONPATH:+:$PYTHONPATH}"
# 도구 회귀 self-test (kernel testkit 패턴 이식). 도구 수정 후 한 방 검증.
set -uo pipefail
STRICT="${STRICT_OPTIONAL:-0}"
FORMAT=text
while [ "$#" -gt 0 ]; do
  case "$1" in
    --strict-optional) STRICT=1 ;;
    --format) shift; FORMAT="${1:-}"; [ "$FORMAT" = text ] || [ "$FORMAT" = json ] || { echo "usage: pkselftest [--strict-optional] [--format text|json]" >&2; exit 2; } ;;
    *) echo "usage: pkselftest [--strict-optional] [--format text|json]" >&2; exit 2 ;;
  esac
  shift
done
VENV=python3
ANGR_PY="${RAT_ANGR_PYTHON:-$CTF_HOME/.venv-angr/bin/python}"
if [ ! -x "$ANGR_PY" ] && [ -z "${RAT_ANGR_PYTHON:-}" ]; then ANGR_PY="$VENV"; fi
export PYTHONPATH="$CTF_HOME/bin${PYTHONPATH:+:$PYTHONPATH}"
P=0; F=0; S=0
line(){ [ "$FORMAT" = json ] || echo "$1"; }
ok(){ line "  [PASS] $1"; P=$((P+1)); }
no(){ line "  [FAIL] $1"; F=$((F+1)); }
skip(){ line "  [SKIP] $1"; S=$((S+1)); }
has_python_module(){ $VENV -c 'import importlib.util,sys; sys.exit(0 if importlib.util.find_spec(sys.argv[1]) else 1)' "$1" >/dev/null 2>&1; }
T=$(mktemp -d); cd "$T"
cleanup(){ cd /; rm -rf -- "$T"; }
trap cleanup EXIT
trap 'exit 130' HUP INT TERM
# T1 canonical STATE v2 offset roundtrip with immutable evidence.
# Direct evidence comes from the real production issuance path: a registered SELF
# verifier (symsolve, concrete-verify) measuring an actual subject binary. When no
# real verifier can run here (no angr / no cc), the direct-only checks are skipped --
# a fabricated fake verifier no longer counts as direct (that was the whole point).
state init st >/dev/null 2>&1
DIRECT_OK=0
if "$ANGR_PY" -c 'import angr; from angr.engines import unicorn; assert unicorn._UC_NATIVE is not None' >/dev/null 2>&1 && command -v cc >/dev/null 2>&1; then
  cat > fx.c <<'CEOF'
#include <stdio.h>
int main(void){ puts("HELLO_MARKER"); return 0; }
CEOF
  cc -O0 -o fx fx.c >/dev/null 2>&1 && [ -x ./fx ] && DIRECT_OK=1
fi
if [ "$DIRECT_OK" = 1 ]; then
  mkdir -p ./pathstate
  SYM="$CTF_HOME/bin/symsolve" FX="$(pwd)/fx" MARK="HELLO_MARKER" $VENV - <<'PY' >/dev/null 2>&1
import os
from ratlib.contracts import execute
from ratlib.state_v2 import Stream
sym=os.environ["SYM"]; fx=os.environ["FX"]; mark=os.environ["MARK"]
def measure(root):
 d=execute([sym, fx, "--find-str", mark, "--timeout", "30"], root=Stream(root).root,
           input_paths=[fx], direct_subject=fx, parameters={"summary":"concrete-verify"}, timeout=90)
 return d["extensions"]["envelope_digest"]
s=Stream(".")
s.append("observation.recorded",{
 "schema":"rat.observation/v1","observation_id":"offset_system","run_id":"selftest",
 "created_at":"2026-01-01T00:00:00+00:00","producer":{"tool":"symsolve","build_digest":"sha256:"+"0"*64},
 "subject":{"kind":"binary"},"kind":"pwn.offset","value":{"key":"system","offset":"0x50d70"},
 "evidence":[measure(".")],"quality":{"level":"direct"},"validity":{"state":"active"}})
p=Stream("./pathstate")
p.append("observation.recorded",{
 "schema":"rat.observation/v1","observation_id":"offset_keyed","run_id":"selftest",
 "created_at":"2026-01-01T00:00:00+00:00","producer":{"tool":"symsolve","build_digest":"sha256:"+"0"*64},
 "subject":{"kind":"binary"},"kind":"pwn.offset","value":{"key":"keyed","offset":"0x4141"},
 "evidence":[measure("./pathstate")],"quality":{"level":"direct"},"validity":{"state":"active"}})
PY
  state get system 2>/dev/null | grep -q "0x50d70" && ok "state v2 offset/get" || no "state v2 offset/get"
  state show 2>/dev/null | grep -q "OFFSETS (typed/direct)" && ok "state v2 show trust label" || no "state v2 show trust label"
  state --dir ./pathstate get keyed 2>/dev/null | grep -q "0x4141" && ok "state explicit v2 path" || no "state explicit v2 path"
  # T2 pwnstage reads only canonical STATE v2 offsets as int and invalidation removes them
  $VENV -c "import pwnstage;assert pwnstage.offsets().get('system')==0x50d70" 2>/dev/null && ok "pwnstage.offsets int" || no "pwnstage.offsets int"
  state invalidate-evidence offset_system >/dev/null 2>&1
  $VENV -c "import pwnstage;assert 'system' not in pwnstage.offsets()" 2>/dev/null && ok "pwnstage invalidation isolation" || no "pwnstage invalidation isolation"
else
  skip "state v2 offset/get (direct verifier 없음: angr/cc)"
  skip "state v2 show trust label (direct verifier 없음)"
  skip "state explicit v2 path (direct verifier 없음)"
  skip "pwnstage.offsets int (direct verifier 없음)"
  skip "pwnstage invalidation isolation (direct verifier 없음)"
fi
printf '{"t":"offset","k":"legacy","v":"0xdead","src":"selftest"}\n' > STATE.jsonl
$VENV -c "import pwnstage;assert 'legacy' not in pwnstage.offsets()" 2>/dev/null && ok "legacy offset isolation" || no "legacy offset isolation"
# T3 pkflag real vs fake
pkflag --set 'DH\{[0-9a-f]{4,}\}' >/dev/null 2>&1
pkflag 'DH{deadbeef}' >/dev/null 2>&1 && R1=ok || R1=no
pkflag 'flag{fake_flag}' >/dev/null 2>&1 && R2=bad || R2=ok
[ "$R1" = ok ] && [ "$R2" = ok ] && ok "pkflag real/fake" || no "pkflag real/fake"
# T4 pwnkit snapscript + pwnclean --kv filter
$VENV -c "import pwnkit;print(pwnkit.snapscript([('a','0x1')]).strip())" 2>/dev/null | grep -q 'SNAP a=' && ok "pwnkit.snapscript" || no "pwnkit.snapscript"
printf '\033[31mpwndbg: x\033[0m\nSNAP r=0x401234\nnoise\n' | pwnclean --kv 2>/dev/null | grep -q 'SNAP r=0x401234' && ok "pwnclean --kv filter" || no "pwnclean --kv filter"
# T5 pwnkit.run_batch (headless gdb plumbing) uses a stable repository fixture
# rather than depending on an optional challenge binary.
B=$CTF_HOME/tests/fixtures/pwn/stack_overflow.c
if ! command -v cc >/dev/null 2>&1; then
  skip "pwnkit.run_batch (cc dependency 없음)"
elif ! command -v gdb >/dev/null 2>&1; then
  skip "pwnkit.run_batch (gdb dependency 없음)"
elif ! has_python_module pwn; then
  skip "pwnkit.run_batch (pwntools dependency 없음)"
elif ! has_python_module elftools.elf.elffile; then
  skip "pwnkit.run_batch (pyelftools dependency 없음)"
else
  cc -fno-stack-protector -no-pie -O0 -o ./m "$B" 2>/dev/null || { no "pwnkit.run_batch fixture build"; }
  if [ -x ./m ]; then
    $VENV -c "import pwnkit;s,_=pwnkit.run_batch('./m', 'printf \"SNAP x=%#lx\\\\n\", 0x41\n');import sys;sys.exit(0 if s.get('x')==0x41 else 1)" 2>/dev/null && ok "pwnkit.run_batch headless" || no "pwnkit.run_batch headless"
  fi
fi
# T6 pkshare HANDOFF 생성 + strict 구조 검사
mkdir -p artifact
printf 'fixture\n' > artifact/input.bin
printf 'print("local fixture")\n' > solve_local.py
pkshare --handoff >/dev/null 2>&1 && [ -f HANDOFF.md ] && writeupcheck HANDOFF.md --strict >/dev/null 2>&1 && ok "pkshare HANDOFF.md" || no "pkshare HANDOFF.md"
# T7 libcgate provenance audit
libcgate --selftest >/dev/null 2>&1 && ok "libcgate selftest" || no "libcgate selftest"
# T8 decomp cache lookup: revq sub_40xxxx alias -> Ghidra FUN_0010xxxx
touch ./m
mkdir -p ./m.decomp
printf '00101234\tFUN_00101234\t1\n' > ./m.decomp/_index.txt
printf 'decompiled alias ok\n' > ./m.decomp/FUN_00101234.c
if ! command -v timeout >/dev/null 2>&1 && ! command -v gtimeout >/dev/null 2>&1; then
  skip "decomp revq/Ghidra addr alias (timeout dependency 없음)"
else
  "$CTF_HOME/bin/decomp" ./m sub_401234 2>/dev/null | grep -q 'decompiled alias ok' && ok "decomp revq/Ghidra addr alias" || no "decomp revq/Ghidra addr alias"
fi
if ! command -v cc >/dev/null 2>&1; then
  skip "decomp disassembly fallback (cc dependency 없음)"
elif ! command -v objdump >/dev/null 2>&1; then
  skip "decomp disassembly fallback (objdump dependency 없음)"
elif ! command -v timeout >/dev/null 2>&1 && ! command -v gtimeout >/dev/null 2>&1; then
  skip "decomp disassembly fallback (timeout dependency 없음)"
else
  printf 'int main(){return 0;}\n' > ./m2.c
  mkdir -p ./m2.decomp
  printf '' > ./m2.decomp/_index.txt
  cc ./m2.c -o ./m2 2>/dev/null || { no "decomp fallback fixture build"; }
  if [ -x ./m2 ]; then
    "$CTF_HOME/bin/decomp" ./m2 0x401234 2>/dev/null | grep -q 'file format' && ok "decomp missing addr disasm fallback" || no "decomp missing addr disasm fallback"
  fi
fi
# T9 bounded Qiling transport + optional dependency status
"$CTF_HOME/bin/rat-qiling" --selftest >/dev/null 2>&1 && ok "rat-qiling bounded selftest" || no "rat-qiling bounded selftest"
"$ANGR_PY" -c 'import qiling' >/dev/null 2>&1 && ok "qiling optional dependency" || skip "qiling optional dependency 없음"
# T10 deterministic address math + local/network scope lint
"$CTF_HOME/bin/pwncalc" base --leak 0x7f0012345000 --offset 0x12345000 2>/dev/null | grep -q 'base=0x7f0000000000' && ok "pwncalc aligned base" || no "pwncalc aligned base"
printf 'from pwn import *\nio = process("./m")\n' > ./solve_local.py
"$CTF_HOME/bin/pwnscope" ./solve_local.py >/dev/null 2>&1 && ok "pwnscope local-only" || no "pwnscope local-only"
# T11 local pwn helpers: leak classification, payload constraint, mapped ROP address
"$CTF_HOME/bin/pwnleak" --text 'p=0x7ffff7a5f980 marker=0x4141414141414141' 2>/dev/null | grep -Eq 'candidate 0x7ffff7a5f980 +shared-library' && ok "pwnleak classify" || no "pwnleak classify"
"$CTF_HOME/bin/pwnpayload" --hex 41414141 --max-length 8 2>/dev/null | grep -q 'verdict=pass' && ok "pwnpayload local bytes" || no "pwnpayload local bytes"
if ! has_python_module elftools.elf.elffile; then
  skip "pwnropcheck rejects unmapped (pyelftools dependency 없음)"
elif ! "$VENV" -c 'import sys; sys.exit(0 if open("/bin/true","rb").read(4)==b"\x7fELF" else 1)' >/dev/null 2>&1; then
  skip "pwnropcheck rejects unmapped (ELF fixture 없음)"
else
  ROP_RESULT=$("$CTF_HOME/bin/pwnropcheck" --chain 0x401000 --map /bin/true@0 --format json 2>/dev/null)
  ROP_RC=$?
  if [ "$ROP_RC" -eq 2 ] && printf '%s' "$ROP_RESULT" | "$VENV" -c 'import json,sys; d=json.load(sys.stdin); sys.exit(0 if any("outside supplied mappings" in e for e in d.get("errors",[])) else 1)' >/dev/null 2>&1; then
    ok "pwnropcheck rejects unmapped"
  else
    no "pwnropcheck rejects unmapped"
  fi
fi
# T12 local cyclic crash/core collection; it remains candidate evidence, never a primitive PASS.
if ! command -v cc >/dev/null 2>&1; then
  skip "pwncrash (cc dependency 없음)"
elif ! command -v gdb >/dev/null 2>&1; then
  skip "pwncrash (gdb dependency 없음)"
elif ! has_python_module pwn; then
  skip "pwncrash (pwntools dependency 없음)"
elif ! has_python_module elftools.elf.elffile; then
  skip "pwncrash (pyelftools dependency 없음)"
else
  cc -fno-stack-protector -no-pie -O0 -o ./crash_fixture "$CTF_HOME/tests/fixtures/pwn/stack_overflow.c" 2>/dev/null || { no "pwncrash fixture build"; }
  if [ ! -x ./crash_fixture ]; then
    :
  else
  PCRASH_OUT=$("$CTF_HOME/bin/pwncrash" ./crash_fixture --pattern-length 128 --repetitions 1 --json 2>&1)
  if printf '%s' "$PCRASH_OUT" | grep -q '"verdict": "crash-reproduced"'; then
    ok "pwncrash local core"
  elif printf '%s' "$PCRASH_OUT" | grep -Eq 'PTRACE_GETREGS|ptrace.*Operation not permitted'; then
    skip "pwncrash (container ptrace unavailable)"
  else
    no "pwncrash local core"
  fi
  fi
fi
if [ "${PKSELFTEST_FORCE_FAIL:-0}" = 1 ]; then no "forced failure injection"; fi
if [ "$FORMAT" = json ]; then
  printf '{"schema":"rat.selftest/v1","pass":%d,"fail":%d,"skip":%d,"strict_optional":%s}\n' "$P" "$F" "$S" "$([ "$STRICT" = 1 ] && echo true || echo false)"
else
  echo "=== pkselftest: PASS=$P FAIL=$F SKIP=$S ==="
fi
if [ "$P" -eq 0 ] || [ "$F" -ne 0 ] || { [ "$STRICT" = 1 ] && [ "$S" -ne 0 ]; }; then
  line "REGRESSION 있음"
  exit 1
fi
line "ALL GREEN"
