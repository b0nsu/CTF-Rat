#!/usr/bin/env bash
CTF_HOME="${CTF_HOME:-$(cd -- "$(dirname -- "$(readlink -f -- "$0" 2>/dev/null || echo "$0")")/.." && pwd)}"
RATLIB_BIN="$(cd -- "$(dirname -- "$(readlink -f -- "$0" 2>/dev/null || echo "$0")")" && pwd)"
# newchal <name> <binary> [libc.so.6] [host:port] [--run run.json] [--artifact role=path]...
set -euo pipefail
# Portability: `readlink -f` is GNU-specific; fall back to a python resolver on macOS/BSD.
resolve_path() { readlink -f -- "$1" 2>/dev/null || python3 -c 'import os,sys; print(os.path.realpath(sys.argv[1]))' "$1"; }
if [ "$#" -lt 2 ]; then
  echo "usage: newchal <name> <binary> [libc.so.6] [host:port] [--run run.json] [--artifact role=path]..." >&2
  exit 2
fi
CTF="$(resolve_path "$CTF_HOME")"; NAME="$1"; BIN="$2"; shift 2
RUN_SOURCE=""; POSITIONAL=(); EXTRA_SPECS=()
while [ "$#" -gt 0 ]; do
  case "$1" in
    --run)
      [ "$#" -ge 2 ] || { echo "[newchal:err] --run requires a path" >&2; exit 2; }
      RUN_SOURCE="$2"; shift 2 ;;
    --artifact)
      [ "$#" -ge 2 ] || { echo "[newchal:err] --artifact requires role=path" >&2; exit 2; }
      EXTRA_SPECS+=("$2"); shift 2 ;;
    --) shift; while [ "$#" -gt 0 ]; do POSITIONAL+=("$1"); shift; done ;;
    -*) echo "[newchal:err] unknown option: $1" >&2; exit 2 ;;
    *) POSITIONAL+=("$1"); shift ;;
  esac
done
[ "${#POSITIONAL[@]}" -le 2 ] || { echo "[newchal:err] too many positional arguments" >&2; exit 2; }
LIBC="${POSITIONAL[0]:-}"; REMOTE="${POSITIONAL[1]:-}"
if [ "$NAME" = "." ] || [ "$NAME" = ".." ] || [ "${#NAME}" -gt 128 ] ||
   [[ ! "$NAME" =~ ^[A-Za-z0-9][A-Za-z0-9._-]*$ ]]; then
  echo "[newchal:err] NAME must be a safe ASCII slug (1-128 chars)" >&2
  exit 2
fi
[ -f "$BIN" ] || { echo "[newchal:err] binary not found: $BIN" >&2; exit 4; }
ARTIFACT_KIND="$(PYTHONPATH="$RATLIB_BIN${PYTHONPATH:+:$PYTHONPATH}" python3 - "$BIN" <<'PY'
import sys
from ratlib.kernel_identity import inspect
from ratlib.raw_loader import inspect_raw
kind = inspect(sys.argv[1])["kind"]
print(inspect_raw(sys.argv[1])["kind"] if kind == "unknown" else kind)
PY
)"
if [ -n "$LIBC" ] && [ ! -f "$LIBC" ]; then
  echo "[newchal:err] libc not found: $LIBC" >&2; exit 4
fi
if [ -n "$RUN_SOURCE" ] && [ ! -f "$RUN_SOURCE" ]; then
  echo "[newchal:err] run manifest not found: $RUN_SOURCE" >&2; exit 4
fi
HOST=""; PORT=0
if [ -n "$REMOTE" ]; then
  if [[ ! "$REMOTE" =~ ^([^:@[:space:]]+):([0-9]+)$ ]] ||
     [ "${BASH_REMATCH[2]:-0}" -lt 1 ] || [ "${BASH_REMATCH[2]:-0}" -gt 65535 ]; then
    echo "[newchal:err] remote must be HOST:PORT with port 1..65535" >&2
    exit 2
  fi
  HOST="${BASH_REMATCH[1]}"; PORT="${BASH_REMATCH[2]}"
fi
RUN_ABS=""
if [ -n "$RUN_SOURCE" ]; then
  RUN_ABS="$(resolve_path "$RUN_SOURCE")"
  PYTHONPATH="$RATLIB_BIN${PYTHONPATH:+:$PYTHONPATH}" python3 - "$RUN_ABS" <<'PY'
import sys
from ratlib.run_manifest import read
try:
    read(sys.argv[1])
except (OSError, ValueError) as exc:
    print("[newchal:err] invalid incoming run manifest: %s" % exc, file=sys.stderr)
    raise SystemExit(2)
PY
fi
SOLVE_ROOT="$CTF/solve"; mkdir -p -- "$SOLVE_ROOT"
SOLVE_ROOT="$(resolve_path "$SOLVE_ROOT")"; D="$SOLVE_ROOT/$NAME"
if [ -L "$D" ]; then
  echo "[newchal:err] solve destination must not be a symlink: $D" >&2
  exit 5
fi
if [ -n "$RUN_ABS" ] && [ -f "$D/run.json" ]; then
  PYTHONPATH="$RATLIB_BIN${PYTHONPATH:+:$PYTHONPATH}" python3 - "$RUN_ABS" "$D/run.json" <<'PY'
import sys
from ratlib.run_manifest import read
try:
    incoming, existing = read(sys.argv[1]), read(sys.argv[2])
except (OSError, ValueError) as exc:
    print("[newchal:err] existing run manifest: %s" % exc, file=sys.stderr)
    raise SystemExit(2)
if incoming["run_id"] != existing["run_id"]:
    print("[newchal:err] refusing a different run_id for an existing solve directory", file=sys.stderr)
    raise SystemExit(5)
PY
fi
# Use resolve_path (readlink -f with a python realpath fallback), not raw
# `readlink -f`: on macOS/BSD `readlink -f` fails and the old fallback left a
# RELATIVE path, so the later `cd "$D"` + `cp -- "$BIN_ABS"` resolved against the
# wrong directory and aborted the scaffold. Absolutize before the cd.
BIN_ABS="$(resolve_path "$BIN")"
LIBC_ABS=""
if [ -n "$LIBC" ]; then LIBC_ABS="$(resolve_path "$LIBC")"; fi
# Validate additional inputs before writing to solve/.
EXTRA_FILES=()
EXTRA_NAMES=("$(basename "$BIN_ABS")" "$(basename "$BIN_ABS")_patched" "libc.so.6" "run.json" "exploit.py" "state.md" "Dockerfile")
for spec in "${EXTRA_SPECS[@]}"; do
  if [[ "$spec" != *=* ]]; then
    echo "[newchal:err] --artifact requires role=path" >&2; exit 2
  fi
  role="${spec%%=*}"; source="${spec#*=}"
  if [[ ! "$role" =~ ^(image|runner|extra)$ ]] || [ -z "$source" ] || [ ! -f "$source" ] || [ -L "$source" ]; then
    echo "[newchal:err] invalid --artifact role/path: $role" >&2; exit 2
  fi
  source="$(resolve_path "$source")"; filename="$(basename "$source")"
  if [[ ! "$filename" =~ ^[A-Za-z0-9][A-Za-z0-9._-]*$ ]] || [ "${#filename}" -gt 128 ]; then
    echo "[newchal:err] unsafe artifact filename: $filename" >&2; exit 2
  fi
  for used in "${EXTRA_NAMES[@]}"; do
    if [ "$filename" = "$used" ]; then
      echo "[newchal:err] colliding artifact filename: $filename" >&2; exit 2
    fi
  done
  EXTRA_NAMES+=("$filename")
  EXTRA_FILES+=("$role=$source")
done
"$CTF/bin/ctfguard" check-newchal "$NAME" >/dev/null
mkdir -p -- "$D"; D="$(resolve_path "$D")"
case "$D/" in "$SOLVE_ROOT"/*/) ;; *) echo "[newchal:err] destination escaped solve root" >&2; exit 5;; esac
cd "$D"
cp -- "$BIN_ABS" ./
BN="$(basename "$BIN_ABS")"
for artifact in "${EXTRA_FILES[@]}"; do cp -- "${artifact#*=}" ./; done
if [ -n "$LIBC_ABS" ]; then cp -- "$LIBC_ABS" ./libc.so.6; fi
SRC_DIR="$(cd -- "$(dirname -- "$BIN_ABS")" && pwd)"
DOCKER_SRC=""
for cand in "$SRC_DIR/Dockerfile" "$SRC_DIR/../Dockerfile"; do
  if [ -f "$cand" ]; then DOCKER_SRC="$cand"; break; fi
done
if [ -n "$DOCKER_SRC" ] && [ ! -f ./Dockerfile ]; then
  cp "$DOCKER_SRC" ./Dockerfile 2>/dev/null || true
fi
# pwninit: 매칭 ld fetch + patchelf. --no-template(중복 방지), timeout, 라이브 출력
if [ -n "$LIBC" ] && [[ "$ARTIFACT_KIND" != bzimage && "$ARTIFACT_KIND" != linux-boot-image && "$ARTIFACT_KIND" != vmlinux ]] && command -v pwninit >/dev/null; then
  echo "[*] pwninit (ld fetch + patchelf, libc6-dbg 다운로드로 ~10-40s 소요될 수 있음)..."
  # `timeout` is GNU coreutils; macOS ships it as `gtimeout`. If neither exists,
  # run pwninit unbounded (it's optional) rather than failing the scaffold.
  TIMEOUT_CMD=""
  if command -v timeout >/dev/null 2>&1; then TIMEOUT_CMD="timeout 60"
  elif command -v gtimeout >/dev/null 2>&1; then TIMEOUT_CMD="gtimeout 60"
  else echo "[!] 'timeout' 없음(coreutils 미설치) → pwninit을 시간제한 없이 실행. 멈추면 Ctrl-C 후 reference/glibc/로 수동 매칭."; fi
  set +e
  $TIMEOUT_CMD pwninit --bin "$BN" --libc ./libc.so.6 --no-template 2>&1 \
     | grep -vE 'unstripping|launchpad|failed unstripping'
  pwninit_rc=${PIPESTATUS[0]}
  set -e
  if [ "$pwninit_rc" -ne 0 ]; then
    echo "[!] pwninit timeout/실패 (exit=$pwninit_rc) → reference/glibc/ 에서 libc 버전 수동 매칭 후 patchelf 필요 (reference/glibc/SOURCES 참조)"
  fi
fi
python3 - "$D" "$BN" "$HOST" "$PORT" "$ARTIFACT_KIND" <<'PY'
import sys,os
D,BN,HOST,PORT,KIND=sys.argv[1:6]
if KIND in {"bzimage", "linux-boot-image", "vmlinux", "boot-sector-candidate", "disk-image-candidate"}:
    open(os.path.join(D,"exploit.py"),"w").write(
        '#!/usr/bin/env python3\n'
        '# Non-ELF artifact: configure the provided QEMU/boot harness before execution.\n'
        '# Record runtime evidence before analysis; see QEMU hints and digests in run.json.\n'
        'raise SystemExit("Configure the challenge execution harness first (see run.json)")\n')
    raise SystemExit(0)
exe = "%s_patched" % BN if os.path.exists(os.path.join(D,"%s_patched"%BN)) else BN
haslibc = os.path.exists(os.path.join(D,"libc.so.6"))
remote_branch = ('    if args.REMOTE: return remote(%r, %s)\n' % (HOST, PORT)) if HOST else ''
open(os.path.join(D,"exploit.py"),"w").write('''#!/usr/bin/env python3
from pwn import *
context.binary = exe = ELF("./%s", checksec=False)
%scontext.log_level = "info"
GS = """
b main
continue
"""
def conn():
%s    if args.REMOTE: raise SystemExit("remote target was not configured by newchal")
    if args.GDB:    return gdb.debug([exe.path], gdbscript=GS)   # heap/인터랙티브 디버깅 주력
    return process([exe.path])

io = conn()
# offset = cyclic_find(...)   # cyclic 으로 확정
# === exploit ===

io.interactive()
''' % (exe, ('libc = ELF("./libc.so.6", checksec=False)\\n' if haslibc else ''), remote_branch))
PY
sed "s/{{NAME}}/$NAME/; s#{{BIN}}#$BN#; s#{{REMOTE}}#${REMOTE:-'-'}#" "$CTF/solve/_template/state.md" > state.md 2>/dev/null || cp "$CTF/solve/_template/state.md" state.md
PYTHONPATH="$RATLIB_BIN${PYTHONPATH:+:$PYTHONPATH}" python3 - "$RUN_ABS" "$D/run.json" "$NAME" "$D/$BN" "${LIBC_ABS:+$D/libc.so.6}" "$REMOTE" "solve/$NAME/run.json" "${EXTRA_FILES[@]}" <<'PY'
import os,sys
from ratlib.run_manifest import materialize_for_solve
source, destination, name, binary, libc, remote, owner = sys.argv[1:8]
extra = [(item.split("=", 1)[0], os.path.join(os.path.dirname(destination),
          os.path.basename(item.split("=", 1)[1]))) for item in sys.argv[8:]]
try:
    materialize_for_solve(source or None, destination, name=name, binary=binary,
                          libc=libc or None, remote=remote or None, owner_path=owner,
                          extra_inputs=extra)
except (OSError, ValueError) as exc:
    print("[newchal:err] run manifest: %s" % exc, file=sys.stderr)
    raise SystemExit(2)
PY
echo "=== libcgate ==="; "$CTF/bin/libcgate" "." | tee -a state.md || true
if [[ "$ARTIFACT_KIND" = bzimage || "$ARTIFACT_KIND" = linux-boot-image || "$ARTIFACT_KIND" = vmlinux || "$ARTIFACT_KIND" = boot-sector-candidate || "$ARTIFACT_KIND" = disk-image-candidate ]]; then
  PYTHONPATH="$RATLIB_BIN${PYTHONPATH:+:$PYTHONPATH}" python3 - "./$BN" <<'PY' | tee -a state.md
import json,sys
from ratlib.kernel_identity import inspect
identity=inspect(sys.argv[1])
from ratlib.raw_loader import inspect_raw
kind = identity["kind"] if identity["kind"] != "unknown" else inspect_raw(sys.argv[1])["kind"]
print("[newchal] 비-ELF/커널 이미지 (%s): 일반 ELF recon 생략" % kind)
print(json.dumps(identity,ensure_ascii=False,sort_keys=True))
if kind in {"bzimage", "linux-boot-image"}:
    print("[newchal] Linux scripts/extract-vmlinux로 ELF vmlinux를 추출한 뒤 함수 조회. 부팅 환경은 별도 확인 필요.")
PY
  echo "[+] $D 생성. 다음: cd $D; rat route ./$BN"
else
  # The first user-facing classification must come from the canonical
  # evidence-first router, not the independent legacy recon tier heuristic.
  echo "=== rat route (provisional evidence) ==="
  ROUTE_RESULT="$(mktemp)"
  trap 'rm -f -- "$ROUTE_RESULT"' EXIT
  if "$CTF/bin/rat" route "./$BN" --format json 2>&1 | tee -a state.md "$ROUTE_RESULT"; then
    if python3 - "$ROUTE_RESULT" <<'PY'
import json, sys
try:
    with open(sys.argv[1], encoding="utf-8") as fh:
        route = json.load(fh)
    degraded = any(item.get("code") == "analysis_failed"
                   for item in route.get("diagnostics", []))
except (OSError, ValueError, AttributeError, TypeError):
    degraded = True
raise SystemExit(1 if degraded else 0)
PY
    then
      echo; echo "[+] $D 생성. 다음: cd $D; 위 ROUTE의 next 후보 확인"
    else
      echo "[newchal] ROUTE UNKNOWN: rat route 분석 실패 또는 결과 파싱 실패; 초기 유형/기법 미확인" | tee -a state.md
      echo "[+] $D 생성. 다음: cd $D; rat route ./$BN 재시도"
    fi
  else
    # Keep the scaffold usable, but do not silently fall back to recon or
    # mistake a failed route query for a verified challenge classification.
    echo "[newchal] ROUTE UNKNOWN: rat route 실패; 초기 유형/기법 미확인 (legacy recon 대체 판정 없음)" | tee -a state.md
    echo "[+] $D 생성. 다음: cd $D; rat route ./$BN 재시도"
  fi
fi
