#!/usr/bin/env bash
CTF_HOME="${CTF_HOME:-$(cd -- "$(dirname -- "$(readlink -f -- "$0" 2>/dev/null || echo "$0")")/.." && pwd)}"
# triage-all <bin|dir> ...  — 여러 바이너리 recon → tier 정렬표 (풀 수 있는 것 빠르게 거르기)
CTF="$CTF_HOME"
bins=()
for a in "$@"; do
  if [ -d "$a" ]; then
    while IFS= read -r f; do bins+=("$f"); done < <(find "$a" -maxdepth 3 -type f -exec sh -c 'file "$1"|grep -q ELF' _ {} \; -print 2>/dev/null)
  elif [ -f "$a" ]; then bins+=("$a"); fi
done
[ ${#bins[@]} -eq 0 ] && { echo "usage: triage-all <bin|dir> ..."; exit 1; }
printf '%-28s %-14s %-8s %s\n' "BINARY" "TIER" "확신" "기법"
printf '%s\n' "--------------------------------------------------------------------------------"
tmp=$(mktemp)
# Consume recon's machine-facing JSON view (no Korean text to grep/sed).
for b in "${bins[@]}"; do
  "$CTF/bin/recon" "$b" --format json 2>/dev/null | python3 -c '
import sys, os, json
b = sys.argv[1]
try:
    d = json.load(sys.stdin)
except Exception:
    print("2\t%-28s %-14s %-8s %s" % (os.path.basename(b), "?", "?", "recon 실패")); sys.exit()
tr = d.get("triage", {})
key = {"fast": 0, "standard": 1, "hard": 2}.get(tr.get("tier"), 2)
label = {"fast": "🟢 FAST", "standard": "🟡 STANDARD", "hard": "🟠 HARD"}.get(tr.get("tier"), "🟠 HARD")
if d.get("status") == "pe": label, tr = "PE(rev)", {"confidence": "-", "techniques": ["rev track"]}
# An un-parseable binary (status:error, no triage) must not masquerade as a valid HARD row.
if d.get("status") == "error": key, label, tr = 3, "ERR", {"confidence": "-", "techniques": [(d.get("error") or "parse 실패")[:40]]}
tech = "; ".join(tr.get("techniques", []))[:40]
print("%d\t%-28s %-14s %-8s %s" % (key, os.path.basename(b), label, tr.get("confidence", "-"), tech))
' "$b" >> "$tmp"
done
sort -n "$tmp" | cut -f2-
rm -f "$tmp"
echo "→ 🟢/🟡 부터 풀고 🟠 는 후순위. 개별: cd solve && newchal <name> <bin>"
