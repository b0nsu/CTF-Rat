#!/usr/bin/env python3
import argparse, json, os, sys
sys.path.insert(0, os.path.dirname(__file__))
from ratlib.orchestration import GateError, enter, finish_phase, rollback, _state
p=argparse.ArgumentParser(); p.add_argument("--root",default=os.getcwd()); sub=p.add_subparsers(dest="cmd",required=True)
q=sub.add_parser("status"); q=sub.add_parser("enter"); q.add_argument("phase"); q=sub.add_parser("exit"); q.add_argument("phase"); q.add_argument("--terminal",action="store_true"); q=sub.add_parser("rollback"); q.add_argument("phase"); q.add_argument("--reason",required=True); q.add_argument("--invalidate",nargs="*",default=[])
a=p.parse_args()
try:
 if a.cmd=="status": out={"phase":_state(a.root)}
 elif a.cmd=="enter": out=enter(a.root,a.phase)
 elif a.cmd=="exit": out=finish_phase(a.root,a.phase,a.terminal)
 else: out=rollback(a.root,a.phase,a.reason,a.invalidate)
 print(json.dumps(out))
except GateError as e: print("[rat-phase:policy] "+str(e),file=sys.stderr); raise SystemExit(5)
