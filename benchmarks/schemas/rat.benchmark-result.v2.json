{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "rat.benchmark-result/v2",
  "type": "object",
  "required": ["schema", "benchmark_run_id", "ablation_id", "challenge_id", "attempt", "status", "eligible", "outcome", "started_at", "finished_at", "metrics", "oracle", "ground_truth"],
  "additionalProperties": false,
  "properties": {
    "schema": {"const": "rat.benchmark-result/v2"},
    "benchmark_run_id": {"type": "string"},
    "ablation_id": {"enum": ["A0", "A1", "A2", "A3", "A4", "A5"]},
    "challenge_id": {"type": "string"},
    "attempt": {"type": "integer", "minimum": 1},
    "status": {"enum": ["completed", "timeout", "partial", "infra-failure", "skipped"]},
    "eligible": {"type": "boolean"},
    "outcome": {"enum": ["verified", "solve-claimed", "failed", "censored", "unknown", "skipped"]},
    "started_at": {"type": "string", "format": "date-time"},
    "finished_at": {"type": "string", "format": "date-time"},
    "oracle": {},
    "ground_truth": {},
    "metrics": {
      "type": "object",
      "required": ["correctness", "latency", "context", "tools", "cache", "reasoning", "artifacts"],
      "additionalProperties": false,
      "properties": {
        "correctness": {
          "type": "object",
          "required": ["verified_solve", "false_solved", "oracle_pass"],
          "additionalProperties": false,
          "properties": {
            "verified_solve": {"type": "boolean"},
            "false_solved": {"type": "boolean"},
            "oracle_pass": {"type": "boolean"}
          }
        },
        "latency": {
          "type": "object",
          "required": ["time_to_first_query_ms", "time_to_first_hypothesis_ms", "time_to_first_valid_primitive_ms", "time_to_verified_solve_ms"],
          "additionalProperties": false,
          "properties": {
            "time_to_first_query_ms": {"type": ["integer", "null"], "minimum": 0},
            "time_to_first_hypothesis_ms": {"type": ["integer", "null"], "minimum": 0},
            "time_to_first_valid_primitive_ms": {"type": ["integer", "null"], "minimum": 0},
            "time_to_verified_solve_ms": {"type": ["integer", "null"], "minimum": 0}
          }
        },
        "context": {
          "type": "object",
          "required": ["input_tokens", "output_tokens", "peak_context_tokens", "tool_output_bytes"],
          "additionalProperties": false,
          "properties": {
            "input_tokens": {"type": "integer", "minimum": 0},
            "output_tokens": {"type": "integer", "minimum": 0},
            "peak_context_tokens": {"type": "integer", "minimum": 0},
            "tool_output_bytes": {"type": "integer", "minimum": 0}
          }
        },
        "tools": {
          "type": "object",
          "required": ["tool_calls", "duplicate_tool_calls", "ghidra_runs", "cfgfast_runs", "symbolic_runs", "subagent_count"],
          "additionalProperties": false,
          "properties": {
            "tool_calls": {"type": "integer", "minimum": 0},
            "duplicate_tool_calls": {"type": "integer", "minimum": 0},
            "ghidra_runs": {"type": "integer", "minimum": 0},
            "cfgfast_runs": {"type": "integer", "minimum": 0},
            "symbolic_runs": {"type": "integer", "minimum": 0},
            "subagent_count": {"type": "integer", "minimum": 0}
          }
        },
        "cache": {
          "type": "object",
          "required": ["cache_requests", "cache_hits", "cache_hit_ratio", "bytes_reused", "cold_warm"],
          "additionalProperties": false,
          "properties": {
            "cache_requests": {"type": "integer", "minimum": 0},
            "cache_hits": {"type": "integer", "minimum": 0},
            "cache_hit_ratio": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
            "bytes_reused": {"type": "integer", "minimum": 0},
            "cold_warm": {"enum": ["cold", "warm"]}
          }
        },
        "reasoning": {
          "type": "object",
          "required": ["hypotheses_created", "hypotheses_refuted", "pivot_count", "deep_escalations"],
          "additionalProperties": false,
          "properties": {
            "hypotheses_created": {"type": "integer", "minimum": 0},
            "hypotheses_refuted": {"type": "integer", "minimum": 0},
            "pivot_count": {"type": "integer", "minimum": 0},
            "deep_escalations": {"type": "integer", "minimum": 0}
          }
        },
        "artifacts": {
          "type": "object",
          "required": ["functions_decompiled", "raw_output_size", "compressed_output_size", "artifact_count"],
          "additionalProperties": false,
          "properties": {
            "functions_decompiled": {"type": "integer", "minimum": 0},
            "raw_output_size": {"type": "integer", "minimum": 0},
            "compressed_output_size": {"type": "integer", "minimum": 0},
            "artifact_count": {"type": "integer", "minimum": 0}
          }
        }
      }
    }
  }
}
