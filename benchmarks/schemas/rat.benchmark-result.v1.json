{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "rat.benchmark-result/v1",
  "$comment": "legacy reference only (superseded by rat.benchmark-result/v2, DESIGN_v2 C2). Mirrors bin/ratlib/schema.py:benchmark_result().",
  "type": "object",
  "required": ["schema", "benchmark_run_id", "ablation_id", "challenge_id", "attempt", "status", "eligible", "outcome", "started_at", "finished_at", "metrics", "oracle", "ground_truth"],
  "properties": {
    "schema": {"const": "rat.benchmark-result/v1"},
    "benchmark_run_id": {"type": "string"},
    "ablation_id": {"enum": ["A0", "A1", "A2", "A3", "A4", "A5"]},
    "challenge_id": {"type": "string"},
    "attempt": {"type": "integer", "minimum": 1},
    "status": {"enum": ["completed", "timeout", "partial", "infra-failure", "skipped"]},
    "eligible": {"type": "boolean"},
    "outcome": {"enum": ["verified", "solve-claimed", "failed", "censored", "unknown", "skipped"]},
    "started_at": {"type": "string", "format": "date-time"},
    "finished_at": {"type": "string", "format": "date-time"},
    "metrics": {"type": "object"},
    "oracle": {},
    "ground_truth": {}
  }
}
