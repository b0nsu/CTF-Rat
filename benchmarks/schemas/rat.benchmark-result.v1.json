{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ctf-rat.local/schemas/rat.benchmark-result.v1.json",
  "title": "CTF-Rat benchmark result v1",
  "type": "object",
  "required": [
    "schema",
    "benchmark_run_id",
    "ablation_id",
    "corpus_digest",
    "challenge_id",
    "attempt",
    "status",
    "eligible",
    "outcome",
    "started_at",
    "finished_at",
    "metrics",
    "oracle",
    "ground_truth"
  ],
  "properties": {
    "schema": {"const": "rat.benchmark-result/v1"},
    "benchmark_run_id": {"type": "string", "minLength": 1},
    "ablation_id": {"enum": ["A0", "A1", "A2", "A3", "A4", "A5"]},
    "corpus_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "challenge_id": {"type": "string", "minLength": 1},
    "attempt": {"type": "integer", "minimum": 1},
    "status": {"enum": ["completed", "timeout", "partial", "infra-failure", "skipped"]},
    "eligible": {"type": "boolean"},
    "outcome": {"enum": ["verified", "solve-claimed", "failed", "censored", "unknown", "skipped"]},
    "started_at": {"type": "string", "format": "date-time"},
    "finished_at": {"type": "string", "format": "date-time"},
    "category": {"type": "string"},
    "difficulty": {"type": "string"},
    "metrics": {
      "type": "object",
      "properties": {
        "time_to_flag_seconds": {"type": ["number", "null"], "minimum": 0},
        "tts_seconds": {"type": ["number", "null"], "minimum": 0},
        "first_primitive_seconds": {"type": ["number", "null"], "minimum": 0},
        "input_tokens": {"type": ["integer", "null"], "minimum": 0},
        "output_tokens": {"type": ["integer", "null"], "minimum": 0},
        "total_tokens": {"type": ["integer", "null"], "minimum": 0},
        "tokens": {"type": ["integer", "null"], "minimum": 0},
        "strong_model_tokens": {"type": ["integer", "null"], "minimum": 0},
        "cache_creation_tokens": {"type": ["integer", "null"], "minimum": 0},
        "cache_read_tokens": {"type": ["integer", "null"], "minimum": 0},
        "peak_context_tokens": {"type": ["integer", "null"], "minimum": 0},
        "tool_calls": {"type": ["integer", "null"], "minimum": 0},
        "duplicate_calls": {"type": ["integer", "null"], "minimum": 0},
        "duplicate_tool_calls": {
          "oneOf": [
            {"type": "null"},
            {"type": "array", "items": {"type": "string", "minLength": 1}},
            {
              "type": "object",
              "additionalProperties": {"type": "integer", "minimum": 0}
            }
          ]
        },
        "cacheable_invocations": {"type": ["integer", "null"], "minimum": 0},
        "cache_hits": {"type": ["integer", "null"], "minimum": 0},
        "cache_lookups": {"type": ["integer", "null"], "minimum": 0},
        "top3_hit": {"type": ["boolean", "null"]},
        "exploit_reliability_local": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
        "exploit_reliability_remote": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
        "context_compression_ratio": {"type": ["number", "null"], "minimum": 0}
      },
      "additionalProperties": true
    },
    "oracle": {"type": "object"},
    "ground_truth": {"type": "object"}
  },
  "additionalProperties": true
}
